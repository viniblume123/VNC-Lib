function L:GetNotificationHistory() local lib=self._lib or self; return table.clone(lib.NotificationHistory or {}) end
function L:ClearNotificationHistory()
    local lib=self._lib or self
    table.clear(lib.NotificationHistory or {})
    local old=lib._notificationHistoryGui
    if old and old.Parent then
        old:Destroy()
        lib._notificationHistoryGui=nil
        lib:ShowNotificationHistory()
    end
    return true
end
function L:ShowNotificationHistory()
    local lib=self._lib or self
    local items={}
    for _,entry in ipairs(lib.NotificationHistory or {}) do
        table.insert(items,{Name=entry.Title.." — "..entry.Text,Tab=os.date("%H:%M:%S",entry.Time),Callback=function() lib:Notify({Title=entry.Title,Text=entry.Text,Type=entry.Type,Duration=3}) end})
    end
    if #items==0 then items={{Name="No notifications recorded",Tab="History",Callback=function() end}} end
    local search=lib:CreateGlobalSearch({Items=items,Placeholder="Search notification history..."})
    if not search then return nil,"Open a library window before showing notification history." end
    lib._notificationHistoryGui=search
    search.Destroying:Connect(function() if lib._notificationHistoryGui==search then lib._notificationHistoryGui=nil end end)
    return search
end


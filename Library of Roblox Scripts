local Config = {_sig = Signal.new(), Current = nil}
function Config.List()
    local names = {}
    if listfiles then
        local ok, res = pcall(listfiles, Storage.Folder.."/configs")
        if ok and type(res) == "table" then
            for _, p in ipairs(res) do
                local n = tostring(p):match("([^/\\]+)%.json$")
                if n then table.insert(names, n) end
            end
        end
    end
    table.sort(names)
    return names
end
function Config.Save(name, silent)
    if type(name) ~= "string" or name == "" then return false, "invalid name" end
    Storage.Ensure(Storage.Folder.."/configs")
    local data = State.Capture()
    local ok, err = Storage.Save(Storage.Folder.."/configs/"..name..".json", data)
    if not ok then return false, err end
    Config.Current = name
    if not silent then Config._sig:Fire("saved", name) end
    return true
end
function Config.Load(name, silent)
    if type(name) ~= "string" then return false, "invalid name" end
    local data = Storage.Load(Storage.Folder.."/configs/"..name..".json", nil)
    if not data then return false, "config not found" end
    State.Restore(data)
    Config.Current = name
    if not silent then Config._sig:Fire("loaded", name) end
    return true
end
function Config.Delete(name)
    local ok = Storage.Delete(Storage.Folder.."/configs/"..name..".json")
    if ok then Config._sig:Fire("deleted", name) end
    return ok
end
function Config.SetAutoLoad(name)
    Storage.Save(Storage.Folder.."/autoload.json", {name = name})
end
function Config.GetAutoLoad()
    return (Storage.Load(Storage.Folder.."/autoload.json", {}) or {}).name
end
function Config.Export(name)
    name = name or Config.Current
    if not name then return nil, "no config" end
    local data = Storage.Load(Storage.Folder.."/configs/"..name..".json", nil)
    if not data then return nil, "config not found" end
    return HttpService:JSONEncode(Ser.Encode(data) or {})
end
function Config.Import(json)
    local ok, data = pcall(HttpService.JSONDecode, HttpService, json)
    if not ok or type(data) ~= "table" then return false, "invalid json" end
    State.Restore(Ser.Decode(data))
    return true
end


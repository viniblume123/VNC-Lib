function L:_SetupPlatform()
    self:_DetectPlatform()
    local saved = JsonRead("library_platform.json", {mode=""}).mode or ""
    if saved == "" then
        local chosen = self:_AskPlatform()
        JsonWrite("library_platform.json", {mode=chosen})
    else
        self.Platform.mode = saved
        self.Platform.isMobileMode = saved == "mobile"
    end
end


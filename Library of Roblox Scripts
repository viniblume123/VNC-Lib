    return win:SetFocusMode(enabled)
end
function L:SetCustomTheme(t)
    if self._destroyed then return false,"library is destroyed" end
    if type(t) ~= "table" then return false,"palette must be a table" end
    local merged = ClonePalette(self.Palettes.Dark)
    for k, v in pairs(t) do
        if type(k)~="string" or merged[k]==nil then return false,"unknown palette color key: "..tostring(k) end
        if typeof(v)~="Color3" then return false,"palette color "..k.." must be a Color3" end
        merged[k] = v
    end
    self._customPalette=ClonePalette(merged)
    self._timeTheme=nil
    local old = ClonePalette(self.C)
    ReplacePaletteInPlace(self.C, NormalizePalette(merged))
    self._themeNormalized = true
    self.Theme = "Custom"
    self.ThemeAnimated = false
    self.ThemeBase = "Custom"
    self.ThemeHue = 0
    for _, win in ipairs(self._allWindows or {}) do if win and not win._destroyed then win:_ApplyTheme(old, self.C) end end
    if type(self._ApplyWidgetTheme)=="function" then self:_ApplyWidgetTheme() end
    self:Emit("ThemeChanged","Custom",self:GetThemeSnapshot())
    self:_RefreshMaintenanceLoop()
    return true
end

function L:RemoveTheme(name)
    if type(name)~="string" or BuiltinPaletteNames[name] or self.Palettes[name]==nil then return false end
    local saved=JsonRead("library_custom_palettes.json",{})
    if type(saved)~="table" then saved={} end
    saved[name]=nil
    local ok=JsonWrite("library_custom_palettes.json",saved)
    if not ok then return false,"could not update the saved palettes file" end
    self.Palettes[name]=nil
    if self.Theme==name then self:SetTheme("Dark") end
    return true
end

function L:SetAnimatedTheme(baseName)
    if self._destroyed then return false,"library is destroyed" end
    baseName = self.Palettes[baseName] and baseName or "Dark"
    self._timeTheme=nil
    local old = ClonePalette(self.C)
    self.Theme = "Animated"
    self.ThemeAnimated = true
    self.ThemeBase = baseName
    self.ThemeHue = 0
    ReplacePaletteInPlace(self.C, NormalizePalette(self.Palettes[baseName]))
    self._themeNormalized = true
    for _, win in ipairs(self._allWindows or {}) do if win and not win._destroyed then win:_ApplyTheme(old, self.C) end end
    if type(self._ApplyWidgetTheme)=="function" then self:_ApplyWidgetTheme() end
    self:Emit("ThemeChanged","Animated",self:GetThemeSnapshot())
    self:_RefreshMaintenanceLoop()
    return true
end

local function HasMaintenanceWork(lib)
    if lib._destroyed then return false end
    if (lib.ThemeAnimated and #(lib._allWindows or {})>0) or lib._timeTheme then return true end
    if lib._idleState and lib._idleState.enabled then return true end
    if lib._hubIdleState and lib._hubIdleState.enabled then return true end
    for object,update in pairs(lib._activeWatchers or {}) do
        if not object or not object.Parent or type(update)~="function" then lib._activeWatchers[object]=nil
        else return true end
    end
    return false
end

function L:_RefreshMaintenanceLoop()
    local lib=self._lib or self
    if lib._destroyed then
        lib._maintenanceToken=(lib._maintenanceToken or 0)+1
        lib._maintenanceRunning=false
        return false
    end
    if not HasMaintenanceWork(lib) then
        if lib._maintenanceRunning then lib._maintenanceToken=(lib._maintenanceToken or 0)+1 end
        lib._maintenanceRunning=false
        return false
    end
    if lib._maintenanceRunning then return true end
    lib._maintenanceToken=(lib._maintenanceToken or 0)+1
    local token=lib._maintenanceToken
    lib._maintenanceRunning=true
    task.spawn(function()
        local nextActivePoll=0
        local nextTimeThemeCheck=0
        while not lib._destroyed and token==lib._maintenanceToken and HasMaintenanceWork(lib) do
            local onlySlowFeatures=not lib.ThemeAnimated and next(lib._activeWatchers or {})==nil
            task.wait(lib.ThemeAnimated and 0.08 or onlySlowFeatures and 1 or 0.3)
            if lib._destroyed or token~=lib._maintenanceToken then break end
            local now=os.clock()
            if now>=nextActivePoll then
                nextActivePoll=now+0.3
                for object,update in pairs(lib._activeWatchers or {}) do
                    if not object or not object.Parent then lib._activeWatchers[object]=nil
                    elseif type(update)=="function" then pcall(update) else lib._activeWatchers[object]=nil end
                end
            end
            if lib._idleState and lib._idleState.enabled and now-lib._idleState.lastAction>=lib._idleState.timeout then
                local callback=lib._idleState.onTimeout
                lib._idleState.enabled=false
                if callback then InvokeUserCallback(callback) elseif LP then pcall(function() LP:Kick("Disconnected after inactivity") end) end
            end
            local hubIdle=lib._hubIdleState
            if hubIdle and hubIdle.enabled and not hubIdle.locked and now-hubIdle.lastAction>=hubIdle.timeout then
                hubIdle.locked=true
                hubIdle.hiddenWindows={}
                for _,win in ipairs(lib._allWindows or {}) do
                    if win and not win._destroyed and not win._hidden then
                        hubIdle.hiddenWindows[win]={WasHidden=false,Interactable=win._main.Interactable}
                        win._main.Interactable=false
                        win:Toggle()
                    end
                end
                if hubIdle.onLock then InvokeUserCallback(hubIdle.onLock) end
            end
            if lib._timeTheme and now>=nextTimeThemeCheck then
                nextTimeThemeCheck=now+60
                local cfg=lib._timeTheme
                local hour=tonumber(os.date("%H")) or 12
                local dayActive=cfg.DayStart<=cfg.NightStart and hour>=cfg.DayStart and hour<cfg.NightStart or cfg.DayStart>cfg.NightStart and (hour>=cfg.DayStart or hour<cfg.NightStart)
                local name=dayActive and cfg.DayTheme or cfg.NightTheme
                if name and lib.Palettes[name] and lib.Theme~=name then lib:SetTheme(name,InternalTimeThemeUpdate) end
            end
            if lib.ThemeAnimated and lib._allWindows and not lib._destroyed then
                lib.ThemeHue=(lib.ThemeHue+0.006)%1
                local newAccent=Color3.fromHSV(lib.ThemeHue,0.68,1)
                local newSoft=Color3.fromHSV(lib.ThemeHue,0.62,0.62)
                local oldAccent,oldSoft=lib.C.Accent,lib.C.AccentSoft
                lib.C.Accent=newAccent; lib.C.AccentSoft=newSoft; lib.C.StrokeHot=newAccent
                for _,win in ipairs(lib._allWindows) do if win and not win._destroyed then pcall(function() win:_ApplyAccent(oldAccent,newAccent,newSoft,oldSoft) end) end end
            end
        end
        if token==lib._maintenanceToken then lib._maintenanceRunning=false end
    end)
    return true
end

local function B64E(data)
    local b = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
    return ((data:gsub('.', function(x)
        local r, b2 = '', x:byte()
        for i = 8, 1, -1 do r = r .. (b2 % 2 ^ i - b2 % 2 ^ (i - 1) > 0 and '1' or '0') end
        return r
    end) .. '0000'):gsub('%d%d%d?%d?%d?%d?', function(x)
        if #x < 6 then return '' end
        local c = 0
        for i = 1, 6 do c = c + (x:sub(i, i) == '1' and 2 ^ (6 - i) or 0) end
        return b:sub(c + 1, c + 1)
    end) .. ({ '', '==', '=' })[#data % 3 + 1])
end

local function B64D(data)
    local b = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
    data = string.gsub(data, '[^' .. b .. '=]', '')
    return (data:gsub('.', function(x)
        if x == '=' then return '' end
        local r, f = '', (b:find(x) - 1)
        for i = 6, 1, -1 do r = r .. (f % 2 ^ i - f % 2 ^ (i - 1) > 0 and '1' or '0') end
        return r
    end):gsub('%d%d%d?%d?%d?%d?%d?%d?', function(x)
        if #x ~= 8 then return '' end
        local c = 0
        for i = 1, 8 do c = c + (x:sub(i, i) == '1' and 2 ^ (8 - i) or 0) end
        return string.char(c)
    end))
end


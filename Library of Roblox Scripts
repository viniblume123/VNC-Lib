function L:CreateInput(cfg)
    local Sec = self
    local C = Sec.C or Sec._window.C
    cfg = cfg or {}
    local multiline=cfg.Multiline==true
    local controlHeight=ClampNumber(cfg.Height,multiline and 130 or 70,60,500)
    local Wrapped = Instance.new("Frame")
    Wrapped.Size = UDim2.new(1,0,0,controlHeight)
    SetThemeColor(Wrapped,"BackgroundColor3",C,"Card")
    Wrapped.BorderSizePixel = 0
    Wrapped.Parent = Sec._inner or Sec._holder
    local Wc = Instance.new("UICorner"); Wc.CornerRadius = UDim.new(0,10); Wc.Parent = Wrapped
    local Ws = Instance.new("UIStroke"); SetThemeColor(Ws,"Color",C,"Stroke"); Ws.Thickness = 1; Ws.Transparency = 0.4; Ws.Parent = Wrapped
    local Lb = Instance.new("TextLabel")
    Lb.Size = UDim2.new(1,-32,0,16)
    Lb.Position = UDim2.new(0,16,0,8)
    Lb.BackgroundTransparency = 1
    Lb.Text = cfg.Name or "Input"
    Lb.Font = Enum.Font[Sec._lib.CurrentFontMedium]
    Lb.TextSize = 12
    SetThemeColor(Lb,"TextColor3",C,"Text")
    Lb.TextXAlignment = Enum.TextXAlignment.Left
    Lb.Parent = Wrapped
    local Box = Instance.new("TextBox")
    Box.Size = UDim2.new(1,-32,0,multiline and controlHeight-38 or 32)
    Box.Position = UDim2.new(0,16,0,30)
    SetThemeColor(Box,"BackgroundColor3",C,"Surface")
    Box.Text = tostring(cfg.Default or "")
    Box.PlaceholderText = tostring(cfg.Placeholder or "Type here...")
    Box.Font = Enum.Font[Sec._lib.CurrentFont]
    Box.TextSize = 12
    SetThemeColor(Box,"TextColor3",C,"Text")
    Box.PlaceholderColor3 = C.TextFaint
    Box.TextXAlignment = Enum.TextXAlignment.Left
    Box.TextYAlignment = multiline and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center
    Box.MultiLine=multiline
    Box.TextWrapped=multiline
    Box.ClearTextOnFocus = false
    Box.Parent = Wrapped
    local Bc = Instance.new("UICorner"); Bc.CornerRadius = UDim.new(0,8); Bc.Parent = Box
    local Bs = Instance.new("UIStroke"); SetThemeColor(Bs,"Color",C,"Stroke"); Bs.Thickness = 1; Bs.Transparency = 0.4; Bs.Parent = Box
    local Bp = Instance.new("UIPadding"); Bp.PaddingLeft = UDim.new(0,10); Bp.Parent = Box
    local maxLength=math.floor(ClampNumber(cfg.MaxLength,4096,1,65536))
    local function normalizeInput(value)
        local result=tostring(value or "")
        if type(cfg.Filter)=="function" then
            local ok,filtered=InvokeUserCallback(cfg.Filter,result)
            if ok and type(filtered)=="string" then result=filtered end
        elseif type(cfg.Mask)=="function" then
            local ok,filtered=InvokeUserCallback(cfg.Mask,result)
            if ok and type(filtered)=="string" then result=filtered end
        end
        if #result>maxLength then result=result:sub(1,maxLength) end
        return result
    end
    Box.Text=normalizeInput(Box.Text)
    local normalizing=false
    Box:GetPropertyChangedSignal("Text"):Connect(function()
        if normalizing then return end
        local normalized=normalizeInput(Box.Text)
        if normalized~=Box.Text then normalizing=true; Box.Text=normalized; normalizing=false end
    end)
    Box.Focused:Connect(function() TweenService:Create(Bs, T_OUT, {Color=C.Accent, Transparency=0}):Play() end)
    Box.FocusLost:Connect(function(enter)
        TweenService:Create(Bs, T_OUT, {Color=C.Stroke, Transparency=0.4}):Play()
        local valid,validationMessage=true,nil
        if type(cfg.Validate)=="function" then
            local ok,result,message=InvokeUserCallback(cfg.Validate,Box.Text)
            valid=ok and result~=false
            validationMessage=ok and message or result
        elseif type(cfg.ValidationPattern)=="string" and cfg.ValidationPattern~="" then
            local ok,result=pcall(string.match,Box.Text,cfg.ValidationPattern)
            valid=ok and result~=nil
        end
        Bs.Color=valid and C.Stroke or C.Danger
        if cfg.Callback then InvokeUserCallback(cfg.Callback, Box.Text, enter, valid, validationMessage) end
        if enter and type(cfg.OnSubmit)=="function" then InvokeUserCallback(cfg.OnSubmit,Box.Text,valid,validationMessage) end
        if cfg.Flag and valid then Sec._lib:_ScheduleConfigAutoSave() end
    end)
    if cfg.Flag then Sec._lib:RegisterState(cfg.Flag, function() return Box.Text end, function(v, silent) Box.Text=tostring(v or ""); if not silent and cfg.Callback then InvokeUserCallback(cfg.Callback,Box.Text,false) end end) end
    local Element = setmetatable({Instance=Wrapped, _lib=Sec._lib, _favoriteId=cfg.Flag or cfg.Name, _favoriteName=cfg.Name, _favoriteTab=Sec._tab, Box=Box, _label=Lb}, ElementMethods)
    Element:InitFavorite()
    function Element:Set(t) Box.Text = tostring(t or ""); if cfg.Flag then Sec._lib:_ScheduleConfigAutoSave() end end
    function Element:Get() return Box.Text end
    function Element:Destroy() Wrapped:Destroy() end
    Sec:_AddElement(Wrapped)
    return Element
end


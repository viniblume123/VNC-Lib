function L:LoadLicense()
    self.License._data = JsonRead(self.License._file, {
        key = "", plan = "free", expires = 0, hwid = ""
    })
    return self.License._data
end

function L:SaveLicense(data)
    for k, v in pairs(data) do self.License._data[k] = v end
    JsonWrite(self.License._file, self.License._data)
end

function L:GetLicensePlan()
    self:LoadLicense()
    return self.License._data.plan or "free"
end

function L:IsLicenseValid()
    self:LoadLicense()
    local d = self.License._data
    if not d.key or d.key == "" then return false end
    if d.expires == 0 then return true end
    if d.expires == math.huge then return true end
    if os.time() > d.expires then return false end
    if d.hwid ~= "" and d.hwid ~= self:GetHashedHWID() then return false end
    return true
end

function L:HasPlan(planName)
    local current = self:GetLicensePlan()
    local hierarchy = {free=0, basic=1, pro=2, premium=3, lifetime=99}
    return (hierarchy[current] or 0) >= (hierarchy[planName] or 0)
end

function L:CheckFeature(feature)
    local plans = {
        basic = {"tema_basico", "salvar_config"},
        pro = {"tema_basico", "salvar_config", "multiplos_perfis", "webhook"},
        premium = {"tema_basico", "salvar_config", "multiplos_perfis", "webhook", "custom_theme", "som_custom"}
    }
    local plan = self:GetLicensePlan()
    if plan == "lifetime" then return true end
    if plan == "free" then return false end
    local allowed = plans[plan]
    if not allowed then return false end
    for _, f in ipairs(allowed) do
        if f == feature then return true end
    end
    return false
end

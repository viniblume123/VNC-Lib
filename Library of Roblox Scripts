L.License = {_data=nil, _file="library_license.json"}

local function NormalizeLicenseData(data)
    local defaults={key="",plan="free",expires=0,hwid=""}
    if type(data)~="table" then data={} end
    for key,value in pairs(defaults) do if data[key]==nil then data[key]=value end end
    local expires=tonumber(data.expires)
    data.expires=(expires and expires==expires and expires~=math.huge and expires~=-math.huge) and expires or 0
    for _,key in ipairs({"key","plan","hwid"}) do if type(data[key])~="string" then data[key]=tostring(data[key] or defaults[key]) end end
    return data
end

function L:LoadLicense()
    self.License._data = NormalizeLicenseData(JsonRead(self.License._file, {key="", plan="free", expires=0, hwid=""}))
    return self.License._data
end

function L:SaveLicense(data)
    if type(data)~="table" then return false,"license data must be a table" end
    local stored=NormalizeLicenseData(type(self.License._data)=="table" and self.License._data or JsonRead(self.License._file,{key="",plan="free",expires=0,hwid=""}))
    for k,v in pairs(data) do stored[k]=v end
    self.License._data=NormalizeLicenseData(stored)
    return JsonWrite(self.License._file,self.License._data)
end

function L:GetLicensePlan()
    self:LoadLicense()
    return self.License._data.plan or "free"
end

function L:IsLicenseValid()
    self:LoadLicense()
    local d = self.License._data
    if not d.key or d.key == "" then return false end
    if d.expires == 0 or d.expires == math.huge then return true end
    if os.time() > d.expires then return false end
    if d.hwid ~= "" and d.hwid ~= self:GetHashedHWID() then return false end
    return true
end

function L:HasPlan(planName)
    local cur = self:GetLicensePlan()
    local h = {free=0, basic=1, pro=2, premium=3, lifetime=99}
    return (h[cur] or 0) >= (h[planName] or 0)
end


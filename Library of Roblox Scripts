function L:PlayEffect(name, parent, cfg)
    if self._destroyed or self:GetReducedMotion() then return false end
    local def=self.Effects.List[name]
    if type(def)~="table" then return false,"unknown effect" end
    cfg=type(cfg)=="table" and cfg or {}
    local color=typeof(cfg.Color)=="Color3" and cfg.Color or def.color
    if typeof(color)~="Color3" then color=self.C.Accent end
    local count=math.floor(ClampNumber(cfg.Count,20,1,200))
    local batchSize=math.floor(ClampNumber(cfg.BatchSize,20,1,200))
    local duration=ClampNumber(cfg.Duration,def.dur or 1,0.05,30)
    local minSize=math.floor(ClampNumber(def.minS,4,1,500))
    local maxSize=math.floor(ClampNumber(def.maxS,minSize,1,500))
    if maxSize<minSize then minSize,maxSize=maxSize,minSize end
    local sizeOverride=cfg.Size~=nil and math.floor(ClampNumber(cfg.Size,minSize,1,500)) or nil
    local is3D=cfg.World3D==true
    if is3D and (typeof(parent)~="Instance" or not parent:IsA("BasePart")) then return false,"World3D effects require a BasePart" end
    if not is3D and (typeof(parent)~="Instance" or not parent:IsA("GuiObject")) then return false,"2D effects require a GuiObject" end
    local zIndex=math.floor(ClampNumber(cfg.ZIndex,500,1,10000))
    local from=typeof(cfg.From)=="UDim2" and cfg.From or nil
    local toY=ClampNumber(cfg.ToY,-0.1,-4,4)
    task.spawn(function()
        for index=1,count do
            if self._destroyed or not parent.Parent then return end
            local size=sizeOverride or math.random(minSize,maxSize)
            if is3D then
                local part=Instance.new("Part")
                part.Size=Vector3.new(size/100,size/100,size/100)
                part.Shape=Enum.PartType.Ball; part.Material=Enum.Material.Neon; part.Color=color
                part.CanCollide=false; part.Anchored=false
                part.CFrame=parent.CFrame*CFrame.new((math.random()-0.5)*4,math.random()*3,(math.random()-0.5)*4)
                part.Parent=workspace
                part.AssemblyLinearVelocity=Vector3.new((math.random()-0.5)*8,math.random(8,15),(math.random()-0.5)*8)
                Debris:AddItem(part,duration+0.1)
            else
                local particle=Instance.new("Frame")
                particle.Size=UDim2.fromOffset(size,size)
                particle.Position=from or UDim2.new(math.random(),0,0.8,0)
                particle.BackgroundColor3=color; particle.BorderSizePixel=0; particle.ZIndex=zIndex; particle.Parent=parent
                local corner=Instance.new("UICorner"); corner.CornerRadius=UDim.new(1,0); corner.Parent=particle
                local toX=cfg.ToX~=nil and ClampNumber(cfg.ToX,particle.Position.X.Scale,-4,4) or (particle.Position.X.Scale+(math.random()-0.5)*0.3)
                TweenService:Create(particle,TweenInfo.new(duration,S.Quart,D.Out),{
                    Position=UDim2.new(toX,0,toY,0),BackgroundTransparency=1,Size=UDim2.fromOffset(size*0.3,size*0.3)
                }):Play()
                Debris:AddItem(particle,duration+0.2)
            end
            if index%batchSize==0 and index<count then task.wait() end
        end
    end)
    return true
end

function L:RefreshTransitionHome(target)
    if typeof(target)~="Instance" or not target:IsA("GuiObject") then return false,"GuiObject required" end
    local active=self._activeTransitions and self._activeTransitions[target]
    if active then for _,tween in ipairs(active.Tweens) do pcall(function() tween:Cancel() end) end end
    self._activeTransitions=self._activeTransitions or setmetatable({}, {__mode="k"})
    self._activeTransitions[target]=nil
    target:SetAttribute("__HomePos",target.Position)
    target:SetAttribute("__HomeSize",target.Size)
    target:SetAttribute("__HomeDirty",false)
    return true
end

function L:PlayTransition(name, target, direction, cfg)
    local def=self.Transitions.List[name]
    if type(def)~="table" or typeof(target)~="Instance" or not target:IsA("GuiObject") then return false end
    direction=direction=="out" and "out" or "in"
    cfg=type(cfg)=="table" and cfg or {}
    local hook=self.Sounds and self.Sounds.transitionHooks and self.Sounds.transitionHooks[name]
    if hook and hook~="" then
        local soundOwner=self._lib or self
        soundOwner._transitionSoundAt=soundOwner._transitionSoundAt or {}
        local now=os.clock()
        if now-(soundOwner._transitionSoundAt[name] or 0)>=0.05 then
            soundOwner._transitionSoundAt[name]=now
            self:PlaySoundAsset(hook,"Transitions")
        end
    end
    self._activeTransitions=self._activeTransitions or setmetatable({}, {__mode="k"})
    local previous=self._activeTransitions[target]
    if previous then for _,tween in ipairs(previous.Tweens) do pcall(function() tween:Cancel() end) end end
    local entry={Tweens={},OriginalBackgroundColor=previous and previous.OriginalBackgroundColor or target.BackgroundColor3}
    self._activeTransitions[target]=entry
    local home=target:GetAttribute("__HomePos")
    local homeSize=target:GetAttribute("__HomeSize")
    local homeRotation=target:GetAttribute("__HomeRotation")
    if not previous or not home or not homeSize or target:GetAttribute("__HomeDirty")==true then
        home=cfg.HomePosition or target.Position; homeSize=cfg.HomeSize or target.Size
        homeRotation=ClampNumber(cfg.HomeRotation,target.Rotation,-3600,3600)
        target:SetAttribute("__HomePos",home); target:SetAttribute("__HomeSize",homeSize); target:SetAttribute("__HomeRotation",homeRotation); target:SetAttribute("__HomeDirty",false)
    end
    if typeof(home)~="UDim2" then home=target.Position end
    if typeof(homeSize)~="UDim2" then homeSize=target.Size end
    if type(homeRotation)~="number" or homeRotation~=homeRotation or homeRotation==math.huge or homeRotation==-math.huge then homeRotation=target.Rotation end
    if self:GetReducedMotion() then
        target.Position=home; target.Size=homeSize; target.Rotation=homeRotation
        if target:IsA("CanvasGroup") then target.GroupTransparency=direction=="in" and 0 or 1 end
        self._activeTransitions[target]=nil
        return true
    end
    local duration=ClampNumber(cfg.Duration,def.dur or 0.4,0.05,30)
    local style=typeof(def.style)=="EnumItem" and def.style.EnumType==Enum.EasingStyle and def.style or S.Quart
    local easingDirection=typeof(def.dir)=="EnumItem" and def.dir.EnumType==Enum.EasingDirection and def.dir or D.Out
    local function tween(properties,info)
        local created=TweenService:Create(target,info,properties)
        table.insert(entry.Tweens,created); created:Play()
    end
    local offset=typeof(cfg.Offset)=="UDim2" and cfg.Offset or def.offset
    local scale=typeof(cfg.Scale)=="UDim2" and cfg.Scale or def.scale
    local rotation=ClampNumber(cfg.Rotation,ClampNumber(def.rotation,0,-3600,3600),-3600,3600)
    if cfg.Spin==true then rotation+=360
    elseif type(cfg.Spin)=="number" then rotation+=ClampNumber(cfg.Spin,0,-3600,3600) end
    local colorShift=typeof(cfg.ColorShift)=="Color3" and cfg.ColorShift or (cfg.ColorShift==true and self.C and self.C.Accent or nil)
    if direction=="in" then
        target.Position=home; target.Size=homeSize; target.Rotation=homeRotation
        if colorShift then target.BackgroundColor3=colorShift end
        if target:IsA("CanvasGroup") then target.GroupTransparency=1 end
        local startPosition,startSize=home,homeSize
        if typeof(offset)=="UDim2" then startPosition=UDim2.new(home.X.Scale+offset.X.Scale,home.X.Offset+offset.X.Offset,home.Y.Scale+offset.Y.Scale,home.Y.Offset+offset.Y.Offset) end
        if typeof(scale)=="UDim2" then startSize=UDim2.new(homeSize.X.Scale+scale.X.Scale,homeSize.X.Offset+scale.X.Offset,homeSize.Y.Scale+scale.Y.Scale,homeSize.Y.Offset+scale.Y.Offset) end
        target.Position=startPosition; target.Size=startSize; target.Rotation=homeRotation+rotation
        local info=TweenInfo.new(duration,style,easingDirection)
        tween({Position=home,Size=homeSize,Rotation=homeRotation,BackgroundColor3=entry.OriginalBackgroundColor},info)
        if target:IsA("CanvasGroup") then tween({GroupTransparency=0},info) end
    else
        local endPosition,endSize=home,homeSize
        if typeof(offset)=="UDim2" then endPosition=UDim2.new(home.X.Scale+offset.X.Scale,home.X.Offset+offset.X.Offset,home.Y.Scale+offset.Y.Scale,home.Y.Offset+offset.Y.Offset) end
        if typeof(scale)=="UDim2" then endSize=UDim2.new(homeSize.X.Scale+scale.X.Scale,homeSize.X.Offset+scale.X.Offset,homeSize.Y.Scale+scale.Y.Scale,homeSize.Y.Offset+scale.Y.Offset) end
        local info=TweenInfo.new(duration*0.8,style,D.In)
        tween({Position=endPosition,Size=endSize,Rotation=homeRotation+rotation},info)
        if colorShift then tween({BackgroundColor3=colorShift},info) end
        if target:IsA("CanvasGroup") then tween({GroupTransparency=1},info) end
    end
    task.delay(duration+0.35,function()
        if self._activeTransitions[target]~=entry then return end
        if direction=="out" and target.Parent then
            target.Position=home; target.Size=homeSize; target.Rotation=homeRotation
            if colorShift then target.BackgroundColor3=entry.OriginalBackgroundColor end
        end
        self._activeTransitions[target]=nil
    end)
    return true
end


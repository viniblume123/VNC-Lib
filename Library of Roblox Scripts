        iconImg.Parent = Wrapped
    end
    local Lb = Instance.new("TextLabel")
    Lb.Size = UDim2.new(1, iconImg and -46 or -20, 1, 0)
    Lb.Position = UDim2.new(0, iconImg and 42 or 16, 0, 0)
    Lb.BackgroundTransparency = 1
    Lb.Text = cfg.Name or "Button"
    Lb.Font = Enum.Font[Sec._lib.CurrentFontMedium]
    Lb.TextSize = 13
    Lb.TextColor3 = C.Text
    Lb.TextXAlignment = Enum.TextXAlignment.Left
    Lb.Parent = Wrapped
    local Indicator
    if cfg.Active then
        Indicator = Instance.new("Frame")
        Indicator.Size = UDim2.new(0, 8, 0, 8)
        Indicator.Position = UDim2.new(1,-20,0.5,-4)
        Indicator.BackgroundColor3 = C.TextFaint
        Indicator.BorderSizePixel = 0
        Indicator.Parent = Wrapped
        local Ic = Instance.new("UICorner"); Ic.CornerRadius = UDim.new(1,0); Ic.Parent = Indicator
    end
    local function RefreshVisual()
        if not cfg.Active then return end
        local ok, res = pcall(cfg.Active)
        local on = ok and res
        if on then
            TweenService:Create(Indicator, T_OUT, {BackgroundColor3=C.Success}):Play()
            TweenService:Create(Wrapped, T_OUT, {BackgroundColor3=C.SuccessBg}):Play()
        else
            TweenService:Create(Indicator, T_OUT, {BackgroundColor3=C.TextFaint}):Play()
            TweenService:Create(Wrapped, T_OUT, {BackgroundColor3=C.Card}):Play()
        end
    end
    if cfg.Active then
        task.spawn(function()
            while Wrapped.Parent do
                RefreshVisual()
                task.wait(0.3)
            end
        end)
    end
    Btn.MouseEnter:Connect(function()
        TweenService:Create(Wrapped, T_OUT, {BackgroundColor3=C.CardHover}):Play()
        TweenService:Create(Ws, T_OUT, {Color=C.StrokeHot, Transparency=0.2}):Play()
        Sec._lib:PlaySound("hover")
    end)
    Btn.MouseLeave:Connect(function()
        TweenService:Create(Wrapped, T_OUT, {BackgroundColor3=C.Card}):Play()
        TweenService:Create(Ws, T_OUT, {Color=C.Stroke, Transparency=0.4}):Play()
        if cfg.Active then RefreshVisual() end
    end)
    Btn.MouseButton1Click:Connect(function()
        Sec._lib:PlaySound("click")
        if cfg.Callback then
            local ok, err = pcall(cfg.Callback)
            if not ok and cfg.ShowError ~= false then
                Sec._lib:Notify({Title="Erro", Text=tostring(err), Type="error"})
            end
        end
        if cfg.Active then RefreshVisual() end
    end)
    local Element = {Instance=Wrapped, Button=Btn, _label=Lb}
    function Element:SetName(t) Lb.Text = t end
    function Element:SetActive() RefreshVisual() end
    function Element:Destroy() Wrapped:Destroy() end
    Sec:_AddElement(Wrapped)
    return Element
end


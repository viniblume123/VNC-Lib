local function DesanitizeFromJson(value)
    if type(value)~="table" then return value end
    local tag=value.__vncType
    if tag=="Table" and type(value.entries)=="table" then local out={}; for _,entry in ipairs(value.entries) do local key=entry.type=="number" and tonumber(entry.key) or entry.key; if key~=nil then out[key]=DesanitizeFromJson(entry.value) end end; return out end
    if tag=="Table" and type(value.value)=="table" then return DesanitizeFromJson(value.value) end
    if tag=="Color3" and type(value.r)=="number" and type(value.g)=="number" and type(value.b)=="number" then return Color3.new(value.r,value.g,value.b) end
    if tag=="Vector2" and type(value.x)=="number" and type(value.y)=="number" then return Vector2.new(value.x,value.y) end
    if tag=="Vector3" and type(value.x)=="number" and type(value.y)=="number" and type(value.z)=="number" then return Vector3.new(value.x,value.y,value.z) end
    if tag=="UDim" and type(value.scale)=="number" and type(value.offset)=="number" then return UDim.new(value.scale,value.offset) end
    if tag=="UDim2" and type(value.xs)=="number" and type(value.xo)=="number" and type(value.ys)=="number" and type(value.yo)=="number" then return UDim2.new(value.xs,value.xo,value.ys,value.yo) end
    if tag=="EnumItem" and type(value.enumType)=="string" and type(value.name)=="string" then local enum=Enum[value.enumType]; return enum and enum[value.name] or nil end
    if tag=="CFrame" and type(value.components)=="table" and #value.components==12 then return CFrame.new(table.unpack(value.components)) end
    if tag=="NumberSequence" and type(value.keys)=="table" then
        local keys={}; for _,k in ipairs(value.keys) do if #k>=2 then table.insert(keys,NumberSequenceKeypoint.new(k[1],k[2],k[3] or 0)) end end
        if #keys>=2 then return NumberSequence.new(keys) end
    end
    if tag=="ColorSequence" and type(value.keys)=="table" then
        local keys={}; for _,k in ipairs(value.keys) do if #k>=4 then table.insert(keys,ColorSequenceKeypoint.new(k[1],Color3.new(k[2],k[3],k[4]))) end end

        if v2-v1<minimumGap then v2=math.min(max,v1+minimumGap); v1=math.max(min,v2-minimumGap) end
        local p1=(v1-min)/(max-min); local p2=(v2-min)/(max-min)
        ValL.Text=FormatControlNumber(v1).." - "..FormatControlNumber(v2); Fill.Position=UDim2.new(p1,0,0,0); Fill.Size=UDim2.new(p2-p1,0,1,0); Thumb1.Position=UDim2.new(p1,-7,0.5,-7); Thumb2.Position=UDim2.new(p2,-7,0.5,-7)
        if fireCallback~=false and cfg.Callback then InvokeUserCallback(cfg.Callback,v1,v2) end

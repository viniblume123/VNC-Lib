function L:CreateGroup(cfg)
    local parent=self
    if type(parent)~="table" or not (parent._inner or parent._holder or (parent._frame and parent._sections)) then return nil,"section or tab required" end
    cfg=type(cfg)=="table" and cfg or {}
    local lib=parent._lib or parent
    local count=math.floor(ClampNumber(cfg.Columns,2,1,4))
    local gap=math.floor(ClampNumber(cfg.Gap,8,0,32))
    local C=parent.C or (parent._window and parent._window.C) or lib.C or L.C

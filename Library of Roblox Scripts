local sectionOnlyCreators={
    "CreateButton","CreateToggle","CreateSlider","CreateStepSlider","CreateRangeSlider",
    "CreateInput","CreateLabel","CreateParagraph","CreateDivider","CreateDropdown",
    "CreateMultiSelect","CreateColorPicker","CreateKeybind","CreateHotkeyCombo",
    "CreateBind","CreateProgress","CreateImage","CreateMiniTabs"
}
for _,methodName in ipairs(sectionOnlyCreators) do
    local implementation=L[methodName]
    if type(implementation)=="function" then
        local currentMethodName,methodImplementation=methodName,implementation
        L[currentMethodName]=function(self,...)
            if type(self)~="table" or not (self._inner or self._holder) then
                return nil,"section required (call this method on a Section)"
            end
            local arguments=table.pack(...)
            if currentMethodName~="CreateLabel" and currentMethodName~="CreateDivider" and arguments.n>0 and arguments[1]~=nil and type(arguments[1])~="table" then arguments[1]={} end
            return methodImplementation(self,table.unpack(arguments,1,arguments.n))
        end
    end
end


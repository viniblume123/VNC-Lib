            ValL.Text = tostring(v)
        end
        Refresh()
        if cfg.Callback then pcall(cfg.Callback, selected) end
        if cfg.Flag then Sec._lib:_ScheduleConfigAutoSave() end
    end
    function Element:Get() return selected end
    function Element:SetOptions(values)
        opts = type(values) == "table" and values or {}
        if multi then selected = {} elseif not IsSelected(selected) then selected = opts[1] end
        ValL.Text = multi and (#selected .. " selected") or tostring(selected or "Select...")
        Refresh()
    end
    function Element:GetOptions() return opts end
    function Element:Open() List.Visible = true; PositionList(); if followConn then followConn:Disconnect() end; followConn = RS.RenderStepped:Connect(PositionList) end
    function Element:Close() List.Visible = false; if followConn then followConn:Disconnect(); followConn=nil end end
    function Element:Destroy() if followConn then followConn:Disconnect() end; List:Destroy(); Wrapped:Destroy() end
    Sec:_AddElement(Wrapped)
    return Element
end


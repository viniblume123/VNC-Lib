local function BitOp(a, b, op)
    local res, p = 0, 1
    for i = 1, 32 do
        local abit = a % 2
        local bbit = b % 2
        if op == "and" then
            if abit == 1 and bbit == 1 then res = res + p end
        elseif op == "xor" then
            if abit ~= bbit then res = res + p end
        elseif op == "or" then
            if abit == 1 or bbit == 1 then res = res + p end
        end
        a = math.floor(a / 2); b = math.floor(b / 2); p = p * 2
    end
    return res
end
local function RShift(x, n) return math.floor(x / (2 ^ n)) end
local function LShift(x, n) return (x * (2 ^ n)) % (2 ^ 32) end
local function RRotate(x, n) return BitOp(RShift(x, n), LShift(x, 32 - n), "or") end

function L.Crypto.SHA256(message)
    message = tostring(message)
    local h = {0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19}
    local msgLen = #message
    local bitLen = msgLen * 8
    message = message .. string.char(0x80)
    while (#message % 64) ~= 56 do message = message .. string.char(0) end
    for i = 8, 1, -1 do
        message = message .. string.char(RShift(bitLen, (i - 1) * 8) % 256)
    end
    for chunk = 1, #message, 64 do
        local w = {}
        for i = 1, 16 do
            local idx = chunk + (i - 1) * 4
            w[i] = message:byte(idx) * 0x1000000 + message:byte(idx + 1) * 0x10000
                 + message:byte(idx + 2) * 0x100 + message:byte(idx + 3)
        end
        for i = 17, 64 do
            local s0 = BitOp(RRotate(w[i-15], 7), RRotate(w[i-15], 18), "xor")
            s0 = BitOp(s0, RShift(w[i-15], 3), "xor")
            local s1 = BitOp(RRotate(w[i-2], 17), RRotate(w[i-2], 19), "xor")
            s1 = BitOp(s1, RShift(w[i-2], 10), "xor")
            w[i] = (w[i-16] + s0 + w[i-7] + s1) % (2 ^ 32)
        end
        local a,b,c,d,e,f,g,hh = table.unpack(h)
        for i = 1, 64 do
            local S1 = BitOp(RRotate(e,6), RRotate(e,11), "xor")
            S1 = BitOp(S1, RRotate(e,25), "xor")
            local ch = BitOp(e, f, "and")
            ch = BitOp(ch, BitOp(BitOp(e, 0xffffffff, "xor"), g, "and"), "xor")
            local t1 = (hh + S1 + ch + SHA256_K[i] + w[i]) % (2 ^ 32)
            local S0 = BitOp(RRotate(a,2), RRotate(a,13), "xor")
            S0 = BitOp(S0, RRotate(a,22), "xor")
            local maj = BitOp(a,b,"and")
            maj = BitOp(maj, BitOp(a,c,"and"), "xor")
            maj = BitOp(maj, BitOp(b,c,"and"), "xor")
            local t2 = (S0 + maj) % (2 ^ 32)
            hh=g; g=f; f=e; e=(d+t1)%(2^32)
            d=c; c=b; b=a; a=(t1+t2)%(2^32)
        end
        h[1]=(h[1]+a)%(2^32); h[2]=(h[2]+b)%(2^32)
        h[3]=(h[3]+c)%(2^32); h[4]=(h[4]+d)%(2^32)
        h[5]=(h[5]+e)%(2^32); h[6]=(h[6]+f)%(2^32)
        h[7]=(h[7]+g)%(2^32); h[8]=(h[8]+hh)%(2^32)
    end
    local out = ""
    for _, v in ipairs(h) do out = out .. string.format("%08x", v) end
    return out
end

local function B64E(data)
    local b = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
    return ((data:gsub('.', function(x)
        local r, b2 = '', x:byte()
        for i = 8, 1, -1 do r = r .. (b2 % 2 ^ i - b2 % 2 ^ (i - 1) > 0 and '1' or '0') end
        return r
    end) .. '0000'):gsub('%d%d%d?%d?%d?%d?', function(x)
        if #x < 6 then return '' end
        local c = 0
        for i = 1, 6 do c = c + (x:sub(i, i) == '1' and 2 ^ (6 - i) or 0) end
        return b:sub(c + 1, c + 1)
    end) .. ({ '', '==', '=' })[#data % 3 + 1])
end

local function B64D(data)
    local b = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
    data = string.gsub(data, '[^' .. b .. '=]', '')
    return (data:gsub('.', function(x)
        if x == '=' then return '' end
        local r, f = '', (b:find(x) - 1)
        for i = 6, 1, -1 do r = r .. (f % 2 ^ i - f % 2 ^ (i - 1) > 0 and '1' or '0') end
        return r
    end):gsub('%d%d%d?%d?%d?%d?%d?%d?', function(x)
        if #x ~= 8 then return '' end
        local c = 0
        for i = 1, 8 do c = c + (x:sub(i, i) == '1' and 2 ^ (8 - i) or 0) end
        return string.char(c)
    end))
end

function L.Crypto.Encrypt(plain, secret)
    local hash = L.Crypto.SHA256(secret or "lib_secret")
    local seed = tonumber(hash:sub(1, 8), 16) or 12345
    local out = {}
    for i = 1, #plain do
        local c = plain:byte(i)
        local k = (seed + i * 31) % 256
        table.insert(out, string.char(BitOp(c, k, "xor")))
    end
    return B64E(table.concat(out))
end

function L.Crypto.Decrypt(cipher, secret)
    local raw = B64D(cipher)
    local hash = L.Crypto.SHA256(secret or "lib_secret")
    local seed = tonumber(hash:sub(1, 8), 16) or 12345
    local out = {}
    for i = 1, #raw do
        local c = raw:byte(i)
        local k = (seed + i * 31) % 256
        table.insert(out, string.char(BitOp(c, k, "xor")))
    end
    return table.concat(out)
end

function L.Crypto.Hash(text) return L.Crypto.SHA256(tostring(text)) end
function L.Crypto.Base64Encode(t) return B64E(t) end
function L.Crypto.Base64Decode(t) return B64D(t) end

function L.Crypto.SaveEncrypted(file, data, secret)
    local json = HS:JSONEncode(data)
    local encrypted = L.Crypto.Encrypt(json, secret or "library_default_key")
    if WF then pcall(WF, file, encrypted) end
end

function L.Crypto.LoadEncrypted(file, secret)
    if not ISF or not ISF(file) then return nil end
    local ok, content = pcall(RF, file)
    if not ok or not content or content == "" then return nil end
    local ok2, decrypted = pcall(L.Crypto.Decrypt, content, secret or "library_default_key")
    if not ok2 or not decrypted then return nil end
    local ok3, parsed = pcall(HS.JSONDecode, HS, decrypted)
    if ok3 and type(parsed) == "table" then return parsed end
    return nil
end


                local Lb = Instance.new("TextLabel")
                Lb.Size = UDim2.new(1,-100,1,0)
                Lb.Position = UDim2.new(0,10,0,0)
                Lb.BackgroundTransparency = 1
                Lb.Text = itemName
                Lb.Font = Enum.Font[lib.CurrentFontMedium]
                Lb.TextSize = 12
                SetThemeColor(Lb,"TextColor3",C,"Text")
                Lb.TextXAlignment = Enum.TextXAlignment.Left
                Lb.Parent = B
                local Tb = Instance.new("TextLabel")
                Tb.Size = UDim2.new(0,90,1,0)
                Tb.Position = UDim2.new(1,-100,0,0)
                Tb.BackgroundTransparency = 1
                Tb.Text = itemTab
                Tb.Font = Enum.Font[lib.CurrentFont]
                Tb.TextSize = 10
                SetThemeColor(Tb,"TextColor3",C,"TextFaint")
                Tb.TextXAlignment = Enum.TextXAlignment.Right
                Tb.Parent = B
                B.MouseButton1Click:Connect(function()
                    if item.Callback then InvokeUserCallback(item.Callback) end
                    Close()
                end)
            end
            end
        end
    end
    Input:GetPropertyChangedSignal("Text"):Connect(Search)
    if not cfg.StartHidden then Input:CaptureFocus() end
    if cfg.StartHidden then
        local ctrlKey = typeof(cfg.Modifier)=="EnumItem" and cfg.Modifier or Enum.KeyCode.LeftControl
        local paletteKey = typeof(cfg.Hotkey)=="EnumItem" and cfg.Hotkey or Enum.KeyCode.K
        local hotkeyConnection
        local cleaned=false
        local function cleanupHotkey()
            if cleaned then return end
            cleaned=true
            if hotkeyConnection then pcall(function() hotkeyConnection:Disconnect() end) end
            if Win._globalSearchHotkey==hotkeyConnection then Win._globalSearchHotkey=nil end
            if Win._globalSearchPalette==gui then Win._globalSearchPalette=nil end
        end
        hotkeyConnection=UIS.InputBegan:Connect(function(input, processed)
            if processed and not (input.KeyCode==Enum.KeyCode.Escape and Input:IsFocused()) then return end
            if input.KeyCode == paletteKey and (UIS:IsKeyDown(ctrlKey) or UIS:IsKeyDown(Enum.KeyCode.RightControl)) then
                if not gui.Enabled then
                    for _,otherWindow in ipairs(lib._allWindows or {}) do
                        local other=otherWindow and otherWindow._globalSearchPalette
                        if other and other~=gui and other.Parent then other.Enabled=false end
                    end
                end
                gui.Enabled = not gui.Enabled
                if gui.Enabled then Input:CaptureFocus() else Input:ReleaseFocus() end
            elseif input.KeyCode == Enum.KeyCode.Escape and gui.Enabled then
                Close()
            end
        end)
        Win._globalSearchHotkey=hotkeyConnection
        Win._globalSearchPalette=gui
        gui.Destroying:Connect(cleanupHotkey)
        gui.AncestryChanged:Connect(function(_,parent) if parent==nil then cleanupHotkey() end end)
    end
    return gui
end


    Lb.Size = UDim2.new(1,-140,0,20)
    Lb.Position = UDim2.new(0,16,0,8)
    Lb.BackgroundTransparency = 1
    Lb.Text = cfg.Name or "Range"
    Lb.Font = Enum.Font[Sec._lib.CurrentFontMedium]
    Lb.TextSize = 13
    Lb.TextColor3 = C.Text
    Lb.TextXAlignment = Enum.TextXAlignment.Left
    Lb.Parent = Wrapped
    local ValL = Instance.new("TextLabel")
    ValL.Size = UDim2.new(0,130,0,20)
    ValL.Position = UDim2.new(1,-146,0,8)
    ValL.BackgroundTransparency = 1
    ValL.Text = tostring(v1).." - "..tostring(v2)
    ValL.Font = Enum.Font[Sec._lib.CurrentFontBold]
    ValL.TextSize = 12
    ValL.TextColor3 = fillColor
    ValL.TextXAlignment = Enum.TextXAlignment.Right
    ValL.Parent = Wrapped
    local Bar = Instance.new("Frame")
    Bar.Size = UDim2.new(1,-32,0,8)
    Bar.Position = UDim2.new(0,16,0,44)
    Bar.BackgroundColor3 = C.Surface
    Bar.BorderSizePixel = 0
    Bar.Parent = Wrapped
    local Bc = Instance.new("UICorner"); Bc.CornerRadius = UDim.new(1,0); Bc.Parent = Bar
    local Fill = Instance.new("Frame")
    Fill.Position = UDim2.new((v1-min)/(max-min), 0, 0, 0)
    Fill.Size = UDim2.new((v2-v1)/(max-min), 0, 1, 0)
    Fill.BackgroundColor3 = fillColor
    Fill.BorderSizePixel = 0
    Fill.Parent = Bar
    local Fc = Instance.new("UICorner"); Fc.CornerRadius = UDim.new(1,0); Fc.Parent = Fill
    local Thumb1 = Instance.new("Frame")
    Thumb1.Size = UDim2.new(0, 14, 0, 14)
    Thumb1.Position = UDim2.new((v1-min)/(max-min), -7, 0.5, -7)
    Thumb1.BackgroundColor3 = C.White
    Thumb1.BorderSizePixel = 0
    Thumb1.ZIndex = 5
    Thumb1.Parent = Bar
    local Tc1 = Instance.new("UICorner"); Tc1.CornerRadius = UDim.new(1,0); Tc1.Parent = Thumb1
    local Ts1 = Instance.new("UIStroke"); Ts1.Color = fillColor; Ts1.Thickness = 2; Ts1.Parent = Thumb1
    local Thumb2 = Instance.new("Frame")
    Thumb2.Size = UDim2.new(0, 14, 0, 14)
    Thumb2.Position = UDim2.new((v2-min)/(max-min), -7, 0.5, -7)
    Thumb2.BackgroundColor3 = C.White
    Thumb2.BorderSizePixel = 0
    Thumb2.ZIndex = 5
    Thumb2.Parent = Bar
    local Tc2 = Instance.new("UICorner"); Tc2.CornerRadius = UDim.new(1,0); Tc2.Parent = Thumb2
    local Ts2 = Instance.new("UIStroke"); Ts2.Color = fillColor; Ts2.Thickness = 2; Ts2.Parent = Thumb2
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1,0,1,0)
    Btn.BackgroundTransparency = 1
    Btn.Text = ""
    Btn.Parent = Bar
    local dragging = nil
    local function UpdateFromClick(x)
        local abs = Bar.AbsolutePosition.X
        local sz = Bar.AbsoluteSize.X
        local t = math.clamp((x - abs) / sz, 0, 1)
        local v = min + (max - min) * t
        if cfg.Round then v = math.floor(v + 0.5) end
        if dragging == 1 then v1 = math.min(v, v2 - 1)
        elseif dragging == 2 then v2 = math.max(v, v1 + 1)
        else
            local d1 = math.abs(v - v1)
            local d2 = math.abs(v - v2)
            if d1 < d2 then v1 = math.min(v, v2 - 1); dragging = 1
            else v2 = math.max(v, v1 + 1); dragging = 2 end
        end
        ValL.Text = tostring(v1).." - "..tostring(v2)
        local p1 = (v1-min)/(max-min)
        local p2 = (v2-min)/(max-min)
        Fill.Position = UDim2.new(p1, 0, 0, 0)
        Fill.Size = UDim2.new(p2-p1, 0, 1, 0)
        Thumb1.Position = UDim2.new(p1, -7, 0.5, -7)
        Thumb2.Position = UDim2.new(p2, -7, 0.5, -7)
        if cfg.Callback then pcall(cfg.Callback, v1, v2) end
    end
    Btn.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            UpdateFromClick(i.Position.X)
        end
    end)
    Btn.InputChanged:Connect(function(i)
        if (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch)
            and i.UserInputState == Enum.UserInputState.Change
            and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
            UpdateFromClick(i.Position.X)
        end
    end)
    Btn.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = nil
        end
    end)
    local Element = {Instance=Wrapped}
    function Element:Get() return v1, v2 end
    function Element:Set(a, b) v1 = a; v2 = b end
    function Element:Destroy() Wrapped:Destroy() end
    Sec:_AddElement(Wrapped)
    if cfg.Callback then pcall(cfg.Callback, v1, v2) end
    return Element
end


end
function ElementMethods:SetFavorite(enabled)
    local id=self._favoriteId or self.Name
    if not id then return false end
    local lib=self._lib or L
    if enabled==nil then enabled=not lib:IsFavorite(id) end
    local state=lib:SetFavorite(id,enabled)
    lib._favoriteItems=lib._favoriteItems or {}
    local root=self.Instance
    if state then
        local record={Name=self._favoriteName or tostring(id),Tab=self._favoriteTab,Element=self}
        lib._favoriteItems[id]=record
        if root and not self._favoriteCleanupConnection then
            self._favoriteCleanupConnection=root.Destroying:Connect(function()
                if lib._favoriteItems and lib._favoriteItems[id]==record then lib._favoriteItems[id]=nil end
                self._favoriteCleanupConnection=nil
            end)
        end
    else
        lib._favoriteItems[id]=nil
        if self._favoriteCleanupConnection then pcall(function() self._favoriteCleanupConnection:Disconnect() end); self._favoriteCleanupConnection=nil end
    end
    if root and root.Parent then
        if not self._favoriteButton then
            local star=Instance.new("TextButton"); star.Name="FavoriteButton"; star.Size=UDim2.fromOffset(20,20); star.Position=UDim2.new(1,-24,0,3)

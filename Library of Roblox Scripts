--============================================================
function Athic:CreateWindow(cfg)
    cfg = type(cfg) == "table" and cfg or {}
    local C = Theme.Get()
    local Win = {_tabs = {}, _active = nil, _id = UUID()}
    
    local gui = New("ScreenGui", {Name="Athic_"..Win._id, ResetOnSpawn=false, DisplayOrder=999999, IgnoreGuiInset=true, ZIndexBehavior=Enum.ZIndexBehavior.Sibling, Parent=getHui()})
    if PROT then pcall(PROT, gui) end
    Win._gui = gui
    
    local main = New("CanvasGroup", {Size=cfg.Size or UDim2.fromOffset(820, 560), Position=UDim2.new(0.5,-410,0.5,-280), BackgroundColor3=C.Bg, BackgroundTransparency=0, BorderSizePixel=0, Parent=gui})
    Corner(main, 16)
    local stroke = Stroke(main, C.Stroke, 0.15)
    Win._main = main
    
    -- Header
    local header = New("Frame", {Size=UDim2.new(1,0,0,48), BackgroundTransparency=1, Parent=main})
    local title = New("TextLabel", {Size=UDim2.new(1,-280,0,20), Position=UDim2.fromOffset(20,12), BackgroundTransparency=1, Text=cfg.Title or "Athic Hub", Font=Enum.Font.GothamBold, TextSize=15, TextColor3=C.Text, TextXAlignment=Enum.TextXAlignment.Left, Parent=header})
    local subtitle = New("TextLabel", {Size=UDim2.new(1,-280,0,14), Position=UDim2.fromOffset(20,28), BackgroundTransparency=1, Text=cfg.Subtitle or Executor.Name, Font=Enum.Font.Gotham, TextSize=10, TextColor3=C.TextFaint, TextXAlignment=Enum.TextXAlignment.Left, Parent=header})
    
    local btnHolder = New("Frame", {Size=UDim2.fromOffset(160,30), Position=UDim2.new(1,-170,0,9), BackgroundTransparency=1, Parent=header})
    New("UIListLayout", {FillDirection=Enum.FillDirection.Horizontal, Padding=UDim.new(0,6), HorizontalAlignment=Enum.HorizontalAlignment.Right, Parent=btnHolder})
    
    local function headerBtn(icon, cb, danger)
        local b = New("TextButton", {Size=UDim2.fromOffset(28,28), BackgroundColor3=C.Card, Text=icon, TextColor3=C.TextDim, Font=Enum.Font.GothamBold, TextSize=13, BorderSizePixel=0, AutoButtonColor=false, Parent=btnHolder})
        Corner(b, 7)
        b.MouseEnter:Connect(function() TweenService:Create(b, T_OUT, {BackgroundColor3=danger and C.Danger or C.CardHover}):Play() end)
        b.MouseLeave:Connect(function() TweenService:Create(b, T_OUT, {BackgroundColor3=C.Card}):Play() end)
        b.MouseButton1Click:Connect(cb)
        return b
    end
    
    local sidebar = New("Frame", {Size=UDim2.new(0,180,1,-84), Position=UDim2.fromOffset(8,56), BackgroundColor3=C.Surface, BorderSizePixel=0, Parent=main})
    Corner(sidebar, 12)
    
    local tabSearch = New("TextBox", {Size=UDim2.new(1,-16,0,30), Position=UDim2.fromOffset(8,8), BackgroundColor3=C.Card, Text="", PlaceholderText="Buscar abas...", PlaceholderColor3=C.TextFaint, TextColor3=C.Text, Font=Enum.Font.Gotham, TextSize=10, BorderSizePixel=0, ClearTextOnFocus=false, Parent=sidebar})
    Corner(tabSearch, 7)
    
    local tabHolder = New("ScrollingFrame", {Size=UDim2.new(1,-16,1,-58), Position=UDim2.fromOffset(8,46), BackgroundTransparency=1, BorderSizePixel=0, ScrollBarThickness=3, ScrollBarImageColor3=C.Accent, CanvasSize=UDim2.new(0,0,0,0), AutomaticCanvasSize=Enum.AutomaticSize.Y, Parent=sidebar})
    New("UIListLayout", {Padding=UDim.new(0,4), SortOrder=Enum.SortOrder.LayoutOrder, Parent=tabHolder})
    
    local content = New("Frame", {Size=UDim2.new(1,-204,1,-84), Position=UDim2.fromOffset(196,56), BackgroundTransparency=1, Parent=main})
    local overlay = New("Frame", {Name="Overlay", Size=UDim2.fromScale(1,1), BackgroundTransparency=1, ZIndex=100, Parent=main})
    
    local statusBar = New("Frame", {Size=UDim2.new(1,-16,0,20), Position=UDim2.new(0,8,1,-26), BackgroundTransparency=1, Parent=main})
    local statusL = New("TextLabel", {Size=UDim2.new(0.7,0,1,0), BackgroundTransparency=1, Text="Pronto", Font=Enum.Font.Gotham, TextSize=10, TextColor3=C.TextFaint, TextXAlignment=Enum.TextXAlignment.Left, Parent=statusBar})
    New("TextLabel", {Size=UDim2.new(0.3,0,1,0), Position=UDim2.new(0.7,0,0,0), BackgroundTransparency=1, Text=Executor.Name, Font=Enum.Font.Gotham, TextSize=10, TextColor3=C.TextFaint, TextXAlignment=Enum.TextXAlignment.Right, Parent=statusBar})
    
    -- Drag
    local dragArea = New("TextButton", {Size=UDim2.new(1,-170,0,48), BackgroundTransparency=1, Text="", Parent=header})
    local dragging, dragStart, startPos = false, nil, nil
    dragArea.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = i.Position; startPos = main.Position
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
    
    -- State
    local minimized, maximized, hidden = false, false, false
    local savedSize = main.Size
    local savedPos = main.Position
    
    function Win:SetMinimized(s)
        minimized = s
        TweenService:Create(main, T_INFO, {Size = s and UDim2.fromOffset(820, 48) or savedSize}):Play()
        sidebar.Visible = not s
        content.Visible = not s
    end
    function Win:SetMaximized(s)
        maximized = s
        if s then
            savedSize = main.Size; savedPos = main.Position
            TweenService:Create(main, T_INFO, {Size=UDim2.fromScale(1,1), Position=UDim2.new(0,0,0,0)}):Play()
        else
            TweenService:Create(main, T_INFO, {Size=savedSize, Position=savedPos}):Play()
        end
    end
    function Win:Toggle() hidden = not hidden; main.Visible = not hidden end
    function Win:Close()
        TweenService:Create(main, T_INFO, {BackgroundTransparency=1}):Play()
        task.delay(0.3, function() gui:Destroy() end)
    end
    
    headerBtn("−", function() Win:SetMinimized(not minimized) end)
    headerBtn("□", function() Win:SetMaximized(not maximized) end)
    headerBtn("✕", function() Win:Close() end, true)
    
    -- Element creators
    local function createElementFrame(sec, cfg, height)
        local wrap = New("Frame", {Size=UDim2.new(1,0,0,height or 46), BackgroundColor3=C.Card, BorderSizePixel=0})
        Corner(wrap, 8); Stroke(wrap, C.Stroke, 0.5)
        local title_ = New("TextLabel", {Size=UDim2.new(1,-80,1,0), Position=UDim2.fromOffset(14,0), BackgroundTransparency=1, Text=cfg.Name or "Element", Font=Enum.Font.GothamMedium, TextSize=12, TextColor3=C.Text, TextXAlignment=Enum.TextXAlignment.Left, Parent=wrap})
        local star = New("TextButton", {Size=UDim2.fromOffset(20,20), Position=UDim2.new(1,-52,0,4), BackgroundTransparency=1, Text="☆", Font=Enum.Font.GothamBold, TextSize=12, TextColor3=C.TextFaint, AutoButtonColor=false, Visible=false, Parent=wrap})
        local id = cfg.Flag or ("e_"..UUID())
        star.MouseButton1Click:Connect(function()
            local fav = Favorites.Toggle(id)
            star.Text = fav and "★" or "☆"
            star.TextColor3 = fav and C.Warning or C.TextFaint
        end)
        if Favorites.Is(id) then star.Text = "★"; star.TextColor3 = C.Warning; star.Visible = true end
        wrap.MouseEnter:Connect(function() star.Visible = true; TweenService:Create(wrap, T_OUT, {BackgroundColor3=C.CardHover}):Play() end)
        wrap.MouseLeave:Connect(function() if not Favorites.Is(id) then star.Visible = false end; TweenService:Create(wrap, T_OUT, {BackgroundColor3=C.Card}):Play() end)
        return wrap, title_, star, id
    end
    
    local creators = {}
    function creators.Button(sec, cfg)
        local wrap, t, s_, id = createElementFrame(sec, cfg, 46)
        local btn = New("TextButton", {Size=UDim2.fromScale(1,1), BackgroundTransparency=1, Text="", Parent=wrap})
        btn.MouseButton1Click:Connect(function()
            TweenService:Create(wrap, TweenInfo.new(0.1), {BackgroundColor3=C.AccentSoft}):Play()
            task.delay(0.15, function() TweenService:Create(wrap, T_OUT, {BackgroundColor3=C.Card}):Play() end)
            if type(cfg.OnClick or cfg.Callback) == "function" then pcall(cfg.OnClick or cfg.Callback) end
        end)
        wrap.LayoutOrder = #sec._elements + 1; wrap.Parent = sec._inner
        table.insert(sec._elements, wrap)
        return {Instance=wrap, _id=id, Destroy=function() wrap:Destroy() end, SetTitle=function(_, v) t.Text = v end}
    end
    
    function creators.Toggle(sec, cfg)
        local wrap, t, s_, id = createElementFrame(sec, cfg, 46)
        local state = cfg.Default == true
        local sw = New("TextButton", {Size=UDim2.fromOffset(40,22), Position=UDim2.new(1,-56,0.5,-11), BackgroundColor3=state and C.Accent or C.Surface, Text="", AutoButtonColor=false, BorderSizePixel=0, Parent=wrap})
        Corner(sw, 11)
        local knob = New("Frame", {Size=UDim2.fromOffset(16,16), Position=state and UDim2.new(1,-20,0.5,-8) or UDim2.new(0,3,0.5,-8), BackgroundColor3=C.White, BorderSizePixel=0, Parent=sw})
        Corner(knob, 8)
        local function set(v, silent)
            state = v == true
            TweenService:Create(sw, T_OUT, {BackgroundColor3=state and C.Accent or C.Surface}):Play()
            TweenService:Create(knob, T_BACK, {Position=state and UDim2.new(1,-20,0.5,-8) or UDim2.new(0,3,0.5,-8)}):Play()
            if not silent and type(cfg.OnChanged) == "function" then pcall(cfg.OnChanged, state) end
        end
        sw.MouseButton1Click:Connect(function() set(not state) end)
        if cfg.Flag then State.Register(cfg.Flag, function() return state end, set) end
        wrap.LayoutOrder = #sec._elements + 1; wrap.Parent = sec._inner
        table.insert(sec._elements, wrap)
        return {Instance=wrap, _id=id, Get=function() return state end, Set=function(_, v, s) set(v, s) end, Destroy=function() wrap:Destroy() end}
    end
    
    function creators.Slider(sec, cfg)
        local wrap, t, s_, id = createElementFrame(sec, cfg, 60)
        local mn, mx = cfg.Min or 0, cfg.Max or 100
        local value = Clamp(cfg.Default or mn, mn, mx)
        local vl = New("TextLabel", {Size=UDim2.fromOffset(60,20), Position=UDim2.new(1,-70,0,8), BackgroundTransparency=1, Text=tostring(Round(value,2)), Font=Enum.Font.GothamBold, TextSize=12, TextColor3=C.Accent, TextXAlignment=Enum.TextXAlignment.Right, Parent=wrap})
        local bar = New("Frame", {Size=UDim2.new(1,-28,0,6), Position=UDim2.fromOffset(14,42), BackgroundColor3=C.Surface, BorderSizePixel=0, Parent=wrap})
        Corner(bar, 3)
        local fill = New("Frame", {Size=UDim2.new((value-mn)/(mx-mn),0,1,0), BackgroundColor3=C.Accent, BorderSizePixel=0, Parent=bar})
        Corner(fill, 3)
        local thumb = New("Frame", {Size=UDim2.fromOffset(14,14), Position=UDim2.new((value-mn)/(mx-mn),-7,0.5,-7), BackgroundColor3=C.White, BorderSizePixel=0, Parent=bar})
        Corner(thumb, 7)
        local dragging = false
        local hit = New("TextButton", {Size=UDim2.fromScale(1,1), BackgroundTransparency=1, Text="", Parent=bar})
        local function set(v, silent)
            value = Clamp(v, mn, mx)
            vl.Text = tostring(Round(value, 2))
            local tt = (value-mn)/(mx-mn)
            TweenService:Create(fill, T_FAST, {Size=UDim2.new(tt,0,1,0)}):Play()
            TweenService:Create(thumb, T_FAST, {Position=UDim2.new(tt,-7,0.5,-7)}):Play()
            if not silent and type(cfg.OnChanged) == "function" then pcall(cfg.OnChanged, value) end
        end
        hit.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                dragging = true; set(mn + (mx-mn) * math.clamp((i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1))
            end
        end)
        UIS.InputChanged:Connect(function(i)
            if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                set(mn + (mx-mn) * math.clamp((i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1))
            end
        end)
        UIS.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
        end)
        if cfg.Flag then State.Register(cfg.Flag, function() return value end, set) end
        wrap.LayoutOrder = #sec._elements + 1; wrap.Parent = sec._inner
        table.insert(sec._elements, wrap)
        return {Instance=wrap, _id=id, Get=function() return value end, Set=function(_, v, s) set(v, s) end, Destroy=function() wrap:Destroy() end}
    end
    
    function creators.Input(sec, cfg)
        local wrap, t, s_, id = createElementFrame(sec, cfg, 70)
        local box = New("TextBox", {Size=UDim2.new(1,-28,0,30), Position=UDim2.fromOffset(14,30), BackgroundColor3=C.Surface, Text=tostring(cfg.Default or ""), PlaceholderText=cfg.Placeholder or "Type...", PlaceholderColor3=C.TextFaint, TextColor3=C.Text, Font=Enum.Font.Gotham, TextSize=11, BorderSizePixel=0, ClearTextOnFocus=false, Parent=wrap})
        Corner(box, 6)
        box.FocusLost:Connect(function()
            if type(cfg.OnChanged) == "function" then pcall(cfg.OnChanged, box.Text) end
        end)
        if cfg.Flag then State.Register(cfg.Flag, function() return box.Text end, function(v) box.Text = tostring(v) end) end
        wrap.LayoutOrder = #sec._elements + 1; wrap.Parent = sec._inner
        table.insert(sec._elements, wrap)
        return {Instance=wrap, _id=id, Get=function() return box.Text end, Set=function(_, v) box.Text = tostring(v) end, Destroy=function() wrap:Destroy() end}
    end
    
    function creators.Label(sec, cfg)
        if type(cfg) == "string" then cfg = {Text=cfg} end
        local wrap = New("Frame", {Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y, BackgroundTransparency=1})
        local lbl = New("TextLabel", {Size=UDim2.new(1,-16,0,0), Position=UDim2.fromOffset(8,0), AutomaticSize=Enum.AutomaticSize.Y, BackgroundTransparency=1, Text=cfg.Text or "", TextColor3=C.TextDim, Font=Enum.Font.Gotham, TextSize=11, TextXAlignment=Enum.TextXAlignment.Left, TextWrapped=true, Parent=wrap})

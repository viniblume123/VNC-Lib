    function Win:CreateTab(tabCfg)
        tabCfg = type(tabCfg) == "table" and tabCfg or {Name = tostring(tabCfg)}
        local Tab = {_win=Win, _name=tabCfg.Name or "Tab", _id="tab_"..UUID(), _sections={}, _elements={}}
        local btn = New("TextButton", {Size=UDim2.new(1,0,0,36), BackgroundColor3=C.Card, Text="", AutoButtonColor=false, BorderSizePixel=0, LayoutOrder=#Win._tabs+1, Parent=tabHolder})
        Corner(btn, 8)
        local lbl = New("TextLabel", {Size=UDim2.new(1,-50,1,0), Position=UDim2.fromOffset(12,0), BackgroundTransparency=1, Text=tabCfg.Name or "Tab", Font=Enum.Font.GothamMedium, TextSize=12, TextColor3=C.TextDim, TextXAlignment=Enum.TextXAlignment.Left, Parent=btn})
        local star = New("TextButton", {Size=UDim2.fromOffset(20,20), Position=UDim2.new(1,-26,0.5,-10), BackgroundTransparency=1, Text="☆", Font=Enum.Font.GothamBold, TextSize=12, TextColor3=C.TextFaint, AutoButtonColor=false, Parent=btn})
        if Favorites.Is(Tab._id) then star.Text = "★"; star.TextColor3 = C.Warning end
        local frame = New("ScrollingFrame", {Size=UDim2.fromScale(1,1), BackgroundTransparency=1, BorderSizePixel=0, ScrollBarThickness=4, ScrollBarImageColor3=C.Accent, CanvasSize=UDim2.new(0,0,0,0), AutomaticCanvasSize=Enum.AutomaticSize.Y, Visible=false, Parent=content})
        New("UIListLayout", {Padding=UDim.new(0,8), SortOrder=Enum.SortOrder.LayoutOrder, Parent=frame})
        New("UIPadding", {PaddingTop=UDim.new(0,4), PaddingLeft=UDim.new(0,4), PaddingRight=UDim.new(0,4), PaddingBottom=UDim.new(0,8), Parent=frame})
        Tab._btn, Tab._frame, Tab._star = btn, frame, star
        
        star.MouseButton1Click:Connect(function()
            local fav = Favorites.Toggle(Tab._id)
            star.Text = fav and "★" or "☆"
            star.TextColor3 = fav and C.Warning or C.TextFaint
        end)
        btn.MouseButton1Click:Connect(function()
            if Win._active == Tab then return end
            Win:SelectTab(Tab)
        end)
        btn.MouseEnter:Connect(function() if Win._active ~= Tab then TweenService:Create(btn, T_OUT, {BackgroundColor3=C.CardHover}):Play() end end)
        btn.MouseLeave:Connect(function() if Win._active ~= Tab then TweenService:Create(btn, T_OUT, {BackgroundColor3=C.Card}):Play() end end)
        
        table.insert(Win._tabs, Tab)
        if #Win._tabs == 1 then Win:SelectTab(Tab) end
        
        -- Tab methods
        function Tab:CreateSection(secCfg)
            secCfg = type(secCfg) == "table" and secCfg or {Name = tostring(secCfg)}
            local Sec = {_name=secCfg.Name or "Section", _collapsed=secCfg.Collapsed == true, _elements={}}
            local holder = New("Frame", {Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y, BackgroundTransparency=1, Parent=frame})
            New("UIListLayout", {Padding=UDim.new(0,6), SortOrder=Enum.SortOrder.LayoutOrder, Parent=holder})
            local header = New("TextButton", {Size=UDim2.new(1,0,0,28), BackgroundTransparency=1, Text="", AutoButtonColor=false, LayoutOrder=0, Parent=holder})
            local arrow = New("TextLabel", {Size=UDim2.fromOffset(16,16), Position=UDim2.new(0,0,0.5,-8), BackgroundTransparency=1, Text="▾", TextColor3=C.TextFaint, Font=Enum.Font.GothamBold, TextSize=10, Parent=header})
            New("Frame", {Size=UDim2.fromOffset(3,16), Position=UDim2.new(0,20,0.5,-8), BackgroundColor3=C.Accent, BorderSizePixel=0, Parent=header}).Name = "Bar"
            New("TextLabel", {Size=UDim2.new(1,-40,1,0), Position=UDim2.fromOffset(32,0), BackgroundTransparency=1, Text=(secCfg.Name or "Section"):upper(), Font=Enum.Font.GothamBold, TextSize=10, TextColor3=C.TextDim, TextXAlignment=Enum.TextXAlignment.Left, Parent=header})
            local inner = New("Frame", {Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y, BackgroundTransparency=1, LayoutOrder=1, Parent=holder})
            New("UIListLayout", {Padding=UDim.new(0,6), SortOrder=Enum.SortOrder.LayoutOrder, Parent=inner})
            Sec._inner = inner
            local function refresh() inner.Visible = not Sec._collapsed; arrow.Text = Sec._collapsed and "▸" or "▾" end
            refresh()
            header.MouseButton1Click:Connect(function() Sec._collapsed = not Sec._collapsed; refresh() end)
            table.insert(Tab._sections, Sec)
            -- Attach creators
            for name, creator in pairs(creators) do
                Sec["Create"..name] = function(_, c) return creator(Sec, c) end
            end
            return Sec
        end
        function Tab:SetFavorite(v) Favorites.Set(Tab._id, v); star.Text = v and "★" or "☆"; star.TextColor3 = v and C.Warning or C.TextFaint end
        function Tab:Destroy() local i = table.find(Win._tabs, Tab); if i then table.remove(Win._tabs, i) end; btn:Destroy(); frame:Destroy(); if Win._active == Tab and Win._tabs[1] then Win:SelectTab(Win._tabs[1]) end end
        return Tab
    end
    
    function Win:SelectTab(tab)
        for _, t in ipairs(Win._tabs) do
            local active = t == tab
            t._frame.Visible = active
            TweenService:Create(t._btn, T_OUT, {BackgroundColor3=active and C.AccentSoft or C.Card}):Play()
            TweenService:Create(t._btn.Children and t._btn:FindFirstChildOfClass("TextLabel") or nil, T_OUT, {TextColor3=active and C.White or C.TextDim}):Play()
        end
        Win._active = tab
    end
    
    tabSearch:GetPropertyChangedSignal("Text"):Connect(function()
        local q = tabSearch.Text:lower()
        for _, t in ipairs(Win._tabs) do
            t._btn.Visible = q == "" or tostring(t._name):lower():find(q, 1, true) ~= nil
        end
    end)
    
    -- Fade in
    main.BackgroundTransparency = 1
    TweenService:Create(main, T_BACK, {BackgroundTransparency=0}):Play()
    
    Win._headerBtns = {holder=btnHolder}
    return Win
end


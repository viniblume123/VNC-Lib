L._hwidCache = nil

function L:GetHWID()
    if self._hwidCache then return self._hwidCache end

    local hwid = nil

    -- Tenta métodos por executor (do mais confiável pro menos)
    pcall(function()
        if syn and syn.get_hwid then
            hwid = syn.get_hwid()
        elseif gethwid then
            hwid = gethwid()
        elseif KRNL_LOADED and krnl and krnl.get_hwid then
            hwid = krnl.get_hwid()
        elseif fluxus and fluxus.HWID then
            hwid = fluxus.HWID
        elseif identifyexecutor and identifyexecutor():lower():find("fluxus") then
            hwid = getgenv().fluxus and getgenv().fluxus.HWID or nil
        elseif secure_load and get_hwid then
            hwid = get_hwid()
        end
    end)

    -- Fallback: gera um baseado no UserId + plataforma
    if not hwid or hwid == "" then
        local fallback = tostring(LP.UserId) .. "_" .. tostring(LP.UserId)
        hwid = "FALLBACK_" .. self.Crypto.Hash(fallback):sub(1, 24)
    end

    -- Cacheia
    self._hwidCache = hwid
    return hwid
end

-- Hash do HWID (pra não salvar em plain text)
function L:GetHashedHWID()
    return self.Crypto.Hash(self:GetHWID())
end

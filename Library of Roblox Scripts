            SetFromClick(i.Position.X)
        end
    end))
    table.insert(pointerConnections,UIS.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dragging=false end end))
    local function disconnectPointer() for _,connection in ipairs(pointerConnections) do if connection then connection:Disconnect() end end; table.clear(pointerConnections) end
    Wrapped.Destroying:Connect(disconnectPointer)
    if cfg.Flag then
        Sec._lib:RegisterState(cfg.Flag, function() return val end, function(v, silent)
            applyValue(v,not silent,false)
        end)
    end
    local Element = setmetatable({Instance=Wrapped, _lib=Sec._lib, _favoriteId=cfg.Flag or cfg.Name, _favoriteName=cfg.Name, _favoriteTab=Sec._tab, Value=val, _label=Lb}, ElementMethods)
    elementHandle=Element
    Element._setInputEnabled=function(enabled) inputEnabled=enabled==true; if not inputEnabled then dragging=false end end
    Element:InitFavorite()
    function Element:Set(v,fireCallback)
        applyValue(v,fireCallback~=false,true)
    end
    function Element:Reset() applyValue(defaultValue,true,true); return val end
    function Element:Focus() GuiService.SelectedObject=Btn; return true end
    function Element:SetColor(c)
        if typeof(c)~="Color3" then return false end
        fillColor = c
        SetCustomThemeColor(ValL,"TextColor3",c)
        SetCustomThemeColor(Fill,"BackgroundColor3",c)
        SetCustomThemeColor(Ts,"Color",c)
        return true
    end
    function Element:Get() return val end
    function Element:Destroy() disconnectPointer(); Wrapped:Destroy() end
    Sec:_AddElement(Wrapped)
    if cfg.Callback then InvokeUserCallback(cfg.Callback, val) end
    return Element
end


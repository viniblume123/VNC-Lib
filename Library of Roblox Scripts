            OB.MouseLeave:Connect(function() if not IsSelected(o) then TweenService:Create(OB, T_OUT, {BackgroundColor3=C.Card}):Play() end end)
            OB.MouseButton1Click:Connect(function()
                if multi then
                    local found = false
                    for i, x in ipairs(selected) do if x == o then table.remove(selected, i); found = true; break end end
                    if not found then table.insert(selected, o) end
                    ValL.Text = #selected .. " sel."
                    if cfg.Callback then pcall(cfg.Callback, selected) end
                    if cfg.Flag then Sec._lib:_ScheduleConfigAutoSave() end
                else
                    selected = o
                    ValL.Text = tostring(o)
                    List.Visible = false
                    if followConn then followConn:Disconnect(); followConn=nil end

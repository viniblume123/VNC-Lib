        column.AutomaticSize=Enum.AutomaticSize.Y; column.BackgroundTransparency=1
        column.BorderSizePixel=0; column.LayoutOrder=index; column.Parent=root
        local columnLayout=Instance.new("UIListLayout"); columnLayout.Padding=UDim.new(0,8); columnLayout.SortOrder=Enum.SortOrder.LayoutOrder; columnLayout.Parent=column
        columns[index]=setmetatable({_inner=column,_holder=column,_elements={},_tab=parent._tab or (parent._frame and parent),_window=parent._window,_lib=lib,C=C}, {__index=L})
    end
    local group={Instance=root,Columns=columns,_nextColumn=0}
    function group:AddElement(index)
        if index~=nil then
            local requested=tonumber(index)
            if not requested or requested~=requested or requested==math.huge or requested==-math.huge then return nil end
            return columns[math.floor(requested)]
        end
        self._nextColumn+=1
        return columns[self._nextColumn]
    end
    group.AddColumn=group.AddElement
    function group:GetColumn(index)
        local requested=tonumber(index)
        if not requested or requested~=requested or requested==math.huge or requested==-math.huge then return nil end
        return columns[math.floor(requested)]
    end
    function group:Destroy() if root.Parent then root:Destroy() end end
    parent:_AddElement(root)
    return group
end


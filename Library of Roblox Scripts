L.Profiles = {_list = {}, _current = nil, _folder = "library_profiles"}
local function SafeProfileName(name)
    name=tostring(name or ""):gsub("[%z\1-\31<>:\"/\\|%?%*]",""):gsub("%s+"," "):match("^%s*(.-)%s*$") or ""
    if utf8 and type(utf8.offset)=="function" then
        local ok,cut=pcall(utf8.offset,name,49)
        if ok and cut then name=name:sub(1,cut-1) end
    elseif #name>48 then
        name=name:sub(1,48):gsub("[\128-\191]+$","")
        local last=name:byte(-1)
        if last and last>=192 and last<=244 then name=name:sub(1,-2) end
    end
    return name~="" and name or nil
end

function L:ListProfiles()
    local index=JsonRead("library_profiles_index.json",{names={}})
    local names,seen={},{}
    if type(index)=="table" and type(index.names)=="table" then
        for _,value in ipairs(index.names) do
            if type(value)=="string" then local name=SafeProfileName(value); if name and not seen[name] then seen[name]=true; table.insert(names,name) end end
        end
    end
    self.Profiles._list=names
    return self.Profiles._list
end

function L:SaveProfile(name,data)
    name=SafeProfileName(name); if not name then return false end
    if not self:SaveConfig(name, data) then return false end
    local idx = JsonRead("library_profiles_index.json", {names={}})
    idx.names = type(idx.names) == "table" and idx.names or {}
    local found = false
    for _, n in ipairs(idx.names or {}) do if n == name then found = true; break end end
    if not found then
        table.insert(idx.names, name)
        if not JsonWrite("library_profiles_index.json", idx) then return false end
    end
    self:ListProfiles()
    return true
end

function L:LoadProfile(name)
    name=SafeProfileName(name); if not name then return nil end
    local data=JsonRead("library_config_"..name..".json",nil) or JsonRead("library_profile_"..name..".json",nil)
    if type(data)=="table" then
        local loaded = self:LoadConfig(name, true)
        if not loaded then
            local values=data.values or data
            if type(values)~="table" then return nil end
            self:PushConfigUndoPoint()
            local previous = self._loadingConfig; self._loadingConfig=true
            local ok=pcall(function() for flag,value in pairs(values) do if type(flag)=="string" then ApplySerializedState(self._state[flag],value,true) end end end)
            self._loadingConfig=previous
            if not ok then return nil end
            self._lastHistorySnapshot=self:CaptureConfig()
        end
        self.Profiles._current=name
        return data
    end
    return nil
end

function L:DeleteProfile(name)
    name=SafeProfileName(name); if not name then return false end
    if not DF or not ISF then return false end
    for _,file in ipairs({"library_profile_"..name..".json","library_config_"..name..".json"}) do if ISF(file) then local ok=pcall(DF,file); if not ok then return false end end end
    local idx = JsonRead("library_profiles_index.json", {names={}}); if type(idx)~="table" then idx={} end; if type(idx.names)~="table" then idx.names={} end
    for i, n in ipairs(idx.names or {}) do
        if n == name then table.remove(idx.names, i); break end
    end
    if not JsonWrite("library_profiles_index.json", idx) then return false end
    self:ListProfiles()
    return true
end

function L:ExportConfig(data)
    data = data or self:CaptureConfig()
    local sanitized=TrySanitizeForJson(data); if not sanitized then return nil,"config cannot be serialized" end
    local encodedOk,json=pcall(HS.JSONEncode,HS,sanitized); if not encodedOk then return nil,tostring(json) end
    if #json>2*1024*1024 then return nil,"config exceeds the 2 MiB export limit" end
    local enc = self.Crypto.Base64Encode(json)
    if CLIP then pcall(CLIP, enc) end
    return enc
end

function L:ImportConfig(encoded, apply)
    if type(encoded)~="string" then return nil,"encoded config must be a string" end
    if #encoded>3*1024*1024 then return nil,"encoded config exceeds the 3 MiB import limit" end
    local ok, dec = pcall(self.Crypto.Base64Decode, encoded)
    if not ok or type(dec)~="string" then return nil,"invalid base64 config" end
    if #dec>2*1024*1024 then return nil,"decoded config exceeds the 2 MiB limit" end
    local ok2, parsed = pcall(HS.JSONDecode, HS, dec)
    if ok2 and type(parsed) == "table" and (parsed.values==nil or type(parsed.values)=="table") then
        if apply then
            self:PushConfigUndoPoint()
            local wasLoading=self._loadingConfig; self._loadingConfig=true
            local applied,applyErr=pcall(function() for flag,value in pairs(parsed.values or parsed) do if type(flag)=="string" then ApplySerializedState(self._state[flag],value,true) end end end)
            self._loadingConfig=wasLoading
            if not applied then return nil,tostring(applyErr) end
            self._lastHistorySnapshot=self:CaptureConfig()
        end
        return parsed
    end
    return nil
end

function L:CaptureConfig()
    local data = {version=2, values={}}
    for flag, entry in pairs(self._state) do
        if entry and entry.Get then
            local ok, value = pcall(entry.Get)
            if ok and TrySanitizeForJson(value)~=nil then
                data.values[flag] = value
            end
        end
    end
    return data
end

function L:SaveConfiguration(name, data) return self:SaveConfig(name, data) end

function L:LoadConfiguration(name, silent) return self:LoadConfig(name, silent) end

function L:SaveConfig(name, data)
    name = SafeProfileName(name)
    if not name then return false end
    data = data or self:CaptureConfig()
    local clean=TrySanitizeForJson(data)
    if not clean then return false end
    local saved=JsonWrite("library_config_"..name..".json", clean)
    if not saved then return false end
    self.Config.LastConfig = name
    return true
end

function L:LoadConfig(name, silent)
    name = SafeProfileName(name)
    if not name then return false end
    local data = JsonRead("library_config_"..name..".json", nil)
    if type(data) ~= "table" or (data.values~=nil and type(data.values)~="table") then return false end
    self:PushConfigUndoPoint()
    local wasLoading = self._loadingConfig
    self._loadingConfig = true
    local ok, err = pcall(function()
        for flag, value in pairs(data.values or data) do
            if type(flag)=="string" then ApplySerializedState(self._state[flag],value,silent ~= false) end
        end
    end)
    self._loadingConfig = wasLoading
    if not ok then warn("[VNC-Lib] Config load stopped: "..tostring(err)); return false end
    self._lastHistorySnapshot=self:CaptureConfig()
    self.Config.LastConfig = name
    return true
end

function L:OverwriteConfig(name)
    return self:SaveConfig(name, self:CaptureConfig())
end

function L:SetAutoSaveConfig(name, enabled, delay)
    if type(name) ~= "string" or name == "" then return false end
    name = SafeProfileName(name)
    if not name then return false end
    self.Config.AutoSaveConfigName = name
    self.Config.AutoSaveConfig = enabled ~= false
    if delay then self.Config.AutoSaveConfigDelay = ClampNumber(delay,0.75,0.1,60) end
    if self.Config.AutoSaveConfig and not self:OverwriteConfig(name) then
        self.Config.AutoSaveConfig=false; self.Config.AutoSaveConfigName=nil
        return false,"failed to write the autosave configuration"
    end
    return true
end

function L:EnableAutoSaveConfig(name, delay) return self:SetAutoSaveConfig(name, true, delay) end

function L:DisableAutoSaveConfig()
    self.Config.AutoSaveConfig = false
    self.Config.AutoSaveConfigName = nil
    return true
end

function L:ListConfigs()
    local names,seen = {},{}
    if not ISF then return names end
    local listfilesFn = listfiles
    if type(listfilesFn) == "function" then
        local ok, files = pcall(listfilesFn, ".")
        if ok and type(files) == "table" then
            for _, file in ipairs(files) do
                local rawName=tostring(file):match("library_config_(.+)%.json$")
                local name=rawName and SafeProfileName(rawName)
                if name and not seen[name] then seen[name]=true; table.insert(names,name) end
            end
        end
    end
    table.sort(names, function(a,b) return a:lower() < b:lower() end)
    return names
end

function L:DeleteConfig(name)
    name = SafeProfileName(name)
    if not name then return false end
    local file = "library_config_"..name..".json"
    if not DF or not ISF then return false end
    if ISF(file) then local ok=pcall(DF,file); if not ok then return false end end
    if self.Config.AutoSaveConfigName == name then self:DisableAutoSaveConfig() end
    return true
end


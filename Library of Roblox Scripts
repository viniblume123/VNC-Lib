L.Profiles = {_list = {}, _current = nil, _folder = "library_profiles"}
local function SafeProfileName(name) name=tostring(name or ""):gsub("[^%w%-%_ ]",""):gsub("%s+"," "):sub(1,48); return name~="" and name or nil end

function L:ListProfiles()
    self.Profiles._list = JsonRead("library_profiles_index.json", {names={}}).names or {}
    return self.Profiles._list
end

function L:SaveProfile(name,data)
    name=SafeProfileName(name); if not name then return false end
    self:SaveConfig(name, data)
    local idx = JsonRead("library_profiles_index.json", {names={}})
    idx.names = type(idx.names) == "table" and idx.names or {}
    local found = false
    for _, n in ipairs(idx.names or {}) do if n == name then found = true; break end end
    if not found then
        table.insert(idx.names, name)
        JsonWrite("library_profiles_index.json", idx)
    end
    self:ListProfiles()
    return true
end

function L:LoadProfile(name)
    name=SafeProfileName(name); if not name then return nil end
    local data=JsonRead("library_config_"..name..".json",nil) or JsonRead("library_profile_"..name..".json",nil)
    if type(data)=="table" then
        local loaded = self:LoadConfig(name, true)
        if not loaded then
            local previous = self._loadingConfig
            self._loadingConfig=true
            pcall(function() for flag,value in pairs(data.values or data) do local entry=self._state[flag]; if entry and entry.Set then entry.Set(value,true) end end end)
            self._loadingConfig=previous
        end
        self.Profiles._current=name
    end
    return data
end

function L:DeleteProfile(name)
    name=SafeProfileName(name); if not name then return false end
    for _,file in ipairs({"library_profile_"..name..".json","library_config_"..name..".json"}) do if DF and ISF and ISF(file) then pcall(DF, file) end end
    local idx = JsonRead("library_profiles_index.json", {names={}})
    for i, n in ipairs(idx.names or {}) do
        if n == name then table.remove(idx.names, i); break end
    end
    JsonWrite("library_profiles_index.json", idx)
    self:ListProfiles()
    return true
end

function L:ExportConfig(data)
    data = data or self:CaptureConfig()
    local json = HS:JSONEncode(data)
    local enc = self.Crypto.Base64Encode(json)
    if CLIP then pcall(CLIP, enc) end
    return enc
end

function L:ImportConfig(encoded, apply)
    local ok, dec = pcall(self.Crypto.Base64Decode, encoded)
    if not ok or not dec then return nil end
    local ok2, parsed = pcall(HS.JSONDecode, HS, dec)
    if ok2 and type(parsed) == "table" then
        if apply then
            self._loadingConfig=true
            for flag,value in pairs(parsed.values or parsed) do
                local entry=self._state[flag]
                if entry and entry.Set then pcall(entry.Set,value,true) end
            end
            self._loadingConfig=false
        end
        return parsed
    end
    return nil
end

function L:CaptureConfig()
    local data = {version=2, values={}}
    for flag, entry in pairs(self._state) do
        if entry and entry.Get then
            local ok, value = pcall(entry.Get)
            if ok and (type(value)=="boolean" or type(value)=="number" or type(value)=="string" or type(value)=="table") then
                data.values[flag] = value
            end
        end
    end
    return data
end

function L:SaveConfiguration(name, data) return self:SaveConfig(name, data) end

function L:LoadConfiguration(name, silent) return self:LoadConfig(name, silent) end

function L:SaveConfig(name, data)
    name = SafeProfileName(name)
    if not name then return false end
    data = data or self:CaptureConfig()
    JsonWrite("library_config_"..name..".json", data)
    self.Config.LastConfig = name
    return true
end

function L:LoadConfig(name, silent)
    name = SafeProfileName(name)
    if not name then return false end
    local data = JsonRead("library_config_"..name..".json", nil)
    if type(data) ~= "table" then return false end
    self:PushConfigUndoPoint()
    local wasLoading = self._loadingConfig
    self._loadingConfig = true
    local ok, err = pcall(function()
        for flag, value in pairs(data.values or data) do
            local entry = self._state[flag]
            if entry and entry.Set then entry.Set(value, silent ~= false) end
        end
    end)
    self._loadingConfig = wasLoading
    if not ok then warn("[VNC-Lib] Config load stopped: "..tostring(err)); return false end
    self._lastHistorySnapshot=self:CaptureConfig()
    self.Config.LastConfig = name
    return true
end

function L:OverwriteConfig(name)
    return self:SaveConfig(name, self:CaptureConfig())
end

function L:SetAutoSaveConfig(name, enabled, delay)
    if type(name) ~= "string" or name == "" then return false end
    name = SafeProfileName(name)
    if not name then return false end
    self.Config.AutoSaveConfigName = name
    self.Config.AutoSaveConfig = enabled ~= false
    if delay then self.Config.AutoSaveConfigDelay = math.max(0.1, tonumber(delay) or 0.75) end
    if self.Config.AutoSaveConfig then self:OverwriteConfig(name) end
    return true
end

function L:EnableAutoSaveConfig(name, delay) return self:SetAutoSaveConfig(name, true, delay) end

function L:DisableAutoSaveConfig()
    self.Config.AutoSaveConfig = false
    self.Config.AutoSaveConfigName = nil
    return true
end

function L:ListConfigs()
    local names = {}
    if not ISF then return names end
    local listfilesFn = listfiles
    if type(listfilesFn) == "function" then
        local ok, files = pcall(listfilesFn, ".")
        if ok and type(files) == "table" then
            for _, file in ipairs(files) do
                local name = tostring(file):match("library_config_(.+)%.json$")
                if name then table.insert(names, name) end
            end
        end
    end
    table.sort(names, function(a,b) return a:lower() < b:lower() end)
    return names
end

function L:DeleteConfig(name)
    name = SafeProfileName(name)
    if not name then return false end
    local file = "library_config_"..name..".json"
    if DF and ISF and ISF(file) then pcall(DF, file) end
    if self.Config.AutoSaveConfigName == name then self:DisableAutoSaveConfig() end
    return true
end

L.Macros = {_list = {}, _recording = false, _steps = {}}

function L:StartMacroRecording(name)
    self.Macros._recording = true
    self.Macros._steps = {}
    self.Macros._name = name or ("Macro_"..os.time())
end

function L:AddMacroStep(action)
    if not self.Macros._recording then return end
    table.insert(self.Macros._steps, action)
end

function L:StopMacroRecording()
    self.Macros._recording = false
    local m = {name=self.Macros._name, steps=self.Macros._steps}
    table.insert(self.Macros._list, m)
    JsonWrite("library_macros.json", {macros=self.Macros._list})
    return m
end

function L:LoadMacros()
    local d = JsonRead("library_macros.json", {macros={}})
    self.Macros._list = d.macros or {}
    return self.Macros._list
end

function L:PlayMacro(name)
    for _, m in ipairs(self.Macros._list) do
        if m.name == name then
            for _, step in ipairs(m.steps) do
                if step.type == "wait" then task.wait(step.time)
                elseif step.type == "callback" and step.fn then pcall(step.fn) end
            end
            return true
        end
    end
    return false
end

return L

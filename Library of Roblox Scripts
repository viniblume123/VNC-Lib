        local backgroundKeys = {"Bg","Surface","CardHover","CardActive","Card","AccentSoft","Accent","SuccessBg","DangerBg","WarningBg","InfoBg","Success","Danger","Warning","Info","Overlay","White"}
        local textKeys = {"Text","TextDim","TextFaint","White","Accent","Success","Danger","Warning","Info"}
        local strokeKeys = {"Stroke","StrokeHot","Accent","AccentSoft"}
        local imageKeys = {"Accent","Text","TextDim","TextFaint","Success","Danger","Warning","Info","White"}
        local function remapTree(tree, excludeOwnThemes)
            if not tree or not tree.Parent then return end
            local ownThemeFrames = {}
            local ownAccentFrames = {}
            if excludeOwnThemes then
                for _,tab in ipairs(self._tabs) do
                    if tab._ownTheme and tab._frame then ownThemeFrames[tab._frame]=true end
                    if tab._ownAccent and tab._frame then ownAccentFrames[tab._frame]=true end
                end
            end
            local function hasOwnThemeAncestor(obj)
                if not excludeOwnThemes then return false end
                local node=obj
                while node and node~=tree do
                    if ownThemeFrames[node] then return true end
                    node=node.Parent
                end
                return false
            end
            local function hasOwnAccentAncestor(obj)
                if not excludeOwnThemes then return false end
                local node=obj
                while node and node~=tree do
                    if ownAccentFrames[node] then return true end
                    node=node.Parent
                end
                return false
            end
            local function remapProperty(obj, property, keys, preserveAccent)
                local current=obj[property]
                for _,key in ipairs(keys) do
                    local accentRole=key=="Accent" or key=="AccentSoft" or key=="StrokeHot"
                    if not (preserveAccent and accentRole) and old[key]==current and typeof(c[key])=="Color3" then
                        local goal=c[key]
                        local ok,tween=pcall(function() return TweenService:Create(obj,TweenInfo.new(0),{[property]=goal}) end)
                        if ok and tween then pcall(function() tween:Play() end) else pcall(function() obj[property]=goal end) end
                        return
                    end
                end
            end
            for _,obj in ipairs(tree:GetDescendants()) do
                if not hasOwnThemeAncestor(obj) then
                    local preserveAccent=hasOwnAccentAncestor(obj)
                    if obj:IsA("GuiObject") then remapProperty(obj,"BackgroundColor3",backgroundKeys,preserveAccent) end
                    if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then remapProperty(obj,"TextColor3",textKeys,preserveAccent) end
                    if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then remapProperty(obj,"ImageColor3",imageKeys,preserveAccent) end
                    if obj:IsA("UIStroke") then remapProperty(obj,"Color",strokeKeys,preserveAccent) end
                end
            end
        end
        if old then
            remapTree(root,true)
            for _,gui in ipairs(self._auxGuis or {}) do remapTree(gui,false) end
            task.delay(T_OUT.Time+0.04,function()
                if not self._destroyed and self._themeRevision==themeRevision then
                    remapTree(root,true)
                    for _,gui in ipairs(self._auxGuis or {}) do remapTree(gui,false) end

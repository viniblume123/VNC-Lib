local KeySystem = {Validated = false}
function KeySystem.CheckCache()
    local c = Storage.Load(Storage.Folder.."/key.json", {})
    if c.key and c.hwid == Executor.HWID() then
        if not c.expires or c.expires > os.time() then
            KeySystem.Validated = true
            return true
        end
    end
    return false
end
function KeySystem.Validate(cfg, key)
    if cfg.Provider == "Luarmor" then
        local body = HttpService:JSONEncode({key = key, hwid = Executor.HWID()})
        local ok, res = Http.Request("POST", "https://api.luarmor.net/v3/script/"..cfg.ScriptId.."/validate", body, {["Content-Type"]="application/json"})
        if not ok then return false, "network error" end
        local dok, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
        if dok and data.status == "success" then
            Storage.Save(Storage.Folder.."/key.json", {key=key, hwid=Executor.HWID(), expires=os.time()+86400})
            KeySystem.Validated = true
            return true
        end
        return false, data and data.message or "invalid key"
    elseif cfg.Provider == "Custom" and type(cfg.Validate) == "function" then
        local ok, r = pcall(cfg.Validate, key)
        if ok and r then KeySystem.Validated = true; return true end
        return false, "invalid"
    elseif cfg.Provider == "Whitelist" then
        for _, k in ipairs(cfg.Keys or {}) do if k == key then KeySystem.Validated = true; return true end end
        return false, "not whitelisted"
    end
    return false, "unknown provider"
end


function L:CreateGlobalSearch(cfg)
    cfg = cfg or {}
    local Win = self._window
    if not Win or Win._destroyed then return nil end
    local C = Win.C
    local items = cfg.Items or {}
    local gui = Instance.new("ScreenGui")
    gui.Name = "LibraryGlobalSearch_"..tostring(math.random(1,999999))
    gui.ResetOnSpawn = false
    gui.DisplayOrder = 999999
    gui.IgnoreGuiInset = true
    if PROT then pcall(PROT, gui) end
    gui.Parent = GetHui()
    Win._auxGuis = Win._auxGuis or {}
    table.insert(Win._auxGuis, gui)
    if cfg.StartHidden then gui.Enabled = false end
    local Overlay = Instance.new("TextButton")
    Overlay.Size = UDim2.new(1,0,1,0)
    Overlay.BackgroundColor3 = C.Overlay
    Overlay.BackgroundTransparency = 0.5
    Overlay.BorderSizePixel = 0
    Overlay.Text = ""
    Overlay.AutoButtonColor = false
    Overlay.Parent = gui
    local Box = Instance.new("Frame")
    Box.Size = UDim2.new(0,500,0,60)
    Box.Position = UDim2.new(0.5,-250,0.3,0)
    Box.BackgroundColor3 = C.Surface
    Box.BorderSizePixel = 0
    Box.Parent = gui
    local Bc = Instance.new("UICorner"); Bc.CornerRadius = UDim.new(0,12); Bc.Parent = Box
    local Bs = Instance.new("UIStroke"); Bs.Color = C.Accent; Bs.Thickness = 1.2; Bs.Transparency = 0.3; Bs.Parent = Box
    local Input = Instance.new("TextBox")
    Input.Size = UDim2.new(1,-20,1,0)
    Input.Position = UDim2.new(0,10,0,0)
    Input.BackgroundTransparency = 1
    Input.Text = ""
    Input.PlaceholderText = cfg.Placeholder or "Search all tabs......"
    Input.Font = Enum.Font[L.CurrentFont]
    Input.TextSize = 14
    Input.TextColor3 = C.Text
    Input.PlaceholderColor3 = C.TextFaint
    Input.TextXAlignment = Enum.TextXAlignment.Left
    Input.ClearTextOnFocus = false
    Input.Parent = Box
    local Results = Instance.new("ScrollingFrame")
    Results.Size = UDim2.new(0,500,0,300)
    Results.Position = UDim2.new(0.5,-250,0.3,68)
    Results.BackgroundColor3 = C.Surface
    Results.BorderSizePixel = 0
    Results.ScrollBarThickness = 5
    Results.ScrollBarImageColor3 = C.Accent
    Results.CanvasSize = UDim2.new(0,0,0,0)
    Results.AutomaticCanvasSize = Enum.AutomaticSize.Y
    Results.Visible = false
    Results.Parent = gui
    local Rc = Instance.new("UICorner"); Rc.CornerRadius = UDim.new(0,12); Rc.Parent = Results
    local Rp = Instance.new("UIPadding"); Rp.PaddingTop = UDim.new(0,8); Rp.PaddingLeft = UDim.new(0,8); Rp.PaddingRight = UDim.new(0,8); Rp.Parent = Results
    local Rl = Instance.new("UIListLayout"); Rl.Padding = UDim.new(0,4); Rl.Parent = Results
    local function Close() gui:Destroy() end
    Overlay.MouseButton1Click:Connect(Close)
    local function Search()
        for _, c in ipairs(Results:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        local q = Input.Text:lower():gsub("^%s+",""):gsub("%s+$","")
        if q == "" then Results.Visible = false; return end
        Results.Visible = true
        for _, item in ipairs(items) do
            local itemName=tostring(item.Name or item.Title or "Action")
            local itemTab=tostring(item.Tab or "")
            if itemName:lower():find(q, 1, true) or itemTab:lower():find(q, 1, true) then
                local B = Instance.new("TextButton")
                B.Size = UDim2.new(1,-4,0,34)
                B.BackgroundColor3 = C.Card
                B.Text = ""
                B.AutoButtonColor = false
                B.BorderSizePixel = 0
                B.Parent = Results
                local Bc2 = Instance.new("UICorner"); Bc2.CornerRadius = UDim.new(0,8); Bc2.Parent = B
                local Lb = Instance.new("TextLabel")
                Lb.Size = UDim2.new(1,-100,1,0)
                Lb.Position = UDim2.new(0,10,0,0)
                Lb.BackgroundTransparency = 1
                Lb.Text = itemName
                Lb.Font = Enum.Font[L.CurrentFontMedium]
                Lb.TextSize = 12
                Lb.TextColor3 = C.Text
                Lb.TextXAlignment = Enum.TextXAlignment.Left
                Lb.Parent = B
                local Tb = Instance.new("TextLabel")
                Tb.Size = UDim2.new(0,90,1,0)
                Tb.Position = UDim2.new(1,-100,0,0)
                Tb.BackgroundTransparency = 1
                Tb.Text = itemTab
                Tb.Font = Enum.Font[L.CurrentFont]
                Tb.TextSize = 10
                Tb.TextColor3 = C.TextFaint
                Tb.TextXAlignment = Enum.TextXAlignment.Right
                Tb.Parent = B
                B.MouseButton1Click:Connect(function()
                    if item.Callback then pcall(item.Callback) end
                    Close()
                end)
            end
        end
    end
    Input:GetPropertyChangedSignal("Text"):Connect(Search)
    if not cfg.StartHidden then Input:CaptureFocus() end
    if cfg.StartHidden then
        local ctrlKey = cfg.Modifier or Enum.KeyCode.LeftControl
        local paletteKey = cfg.Hotkey or Enum.KeyCode.K
        Win:_Connect(UIS.InputBegan, function(input, processed)
            if processed then return end
            if input.KeyCode == paletteKey and (UIS:IsKeyDown(ctrlKey) or UIS:IsKeyDown(Enum.KeyCode.RightControl)) then
                gui.Enabled = not gui.Enabled
                if gui.Enabled then Input:CaptureFocus() else Input:ReleaseFocus() end
            elseif input.KeyCode == Enum.KeyCode.Escape and gui.Enabled then
                gui.Enabled = false
                Input:ReleaseFocus()
            end
        end)
    end
    return gui
end

function L:CreateCommandPalette(cfg)
    cfg = cfg or {}
    local win=self._window or (self._main and self)
    if win and win._commandPalette and win._commandPalette.Parent then win._commandPalette:Destroy() end
    cfg.StartHidden = true
    cfg.Placeholder = cfg.Placeholder or "Search actions... (Ctrl+K)"
    cfg.Items=cfg.Items or {}
    if cfg.IncludeFavorites~=false then
        for id,item in pairs(self._favoriteItems or {}) do
            if self:IsFavorite(id) then
                table.insert(cfg.Items,{Name="★ "..item.Name,Tab=item.Tab and item.Tab._name or "Favorites",Callback=function() if item.Tab and item.Tab._window then item.Tab._window:SelectTab(item.Tab) end end})
            end
        end
    end
    local gui=self:CreateGlobalSearch(cfg)
    if win then win._commandPalette=gui end
    return gui
end


    ResizeHandle.InputBegan:Connect(function(i)
        if not ResizeHandle.Visible or (i.UserInputType~=Enum.UserInputType.MouseButton1 and i.UserInputType~=Enum.UserInputType.Touch) then return end
        resizing=true; resizeStart=i.Position; resizeSize=Main.AbsoluteSize/math.max(UIScaleObj.Scale,0.01)
    end)
    self:_Connect(UIS.InputChanged,function(i)
        if not resizing or (i.UserInputType~=Enum.UserInputType.MouseMovement and i.UserInputType~=Enum.UserInputType.Touch) then return end
        local delta=(i.Position-resizeStart)/math.max(UIScaleObj.Scale,0.01)
        local min=Win._minSize or {Width=cfg.MinWidth or 420,Height=cfg.MinHeight or 300}
        Main.Size=UDim2.fromOffset(math.max(min.Width,resizeSize.X+delta.X),math.max(min.Height,resizeSize.Y+delta.Y))
    end)
    self:_Connect(UIS.InputEnded,function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then resizing=false end end)
    table.insert(self._connections,conn)
    local handle={Name=name,Connection=conn}
    function handle:Set(newKey,newModifiers) binding.Key=newKey; binding.Modifiers=type(newModifiers)=="table" and table.clone(newModifiers) or {}; self.Key=binding.Key; self.Modifiers=binding.Modifiers; end
    handle.Key,handle.Modifiers=key,modifiers
    function handle:Destroy() if self.Connection then self.Connection:Disconnect(); self.Connection=nil end end
    return handle
end


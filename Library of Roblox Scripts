                if IsInsideThemePreview(obj,tree) then return end
                local current=obj[property]
                local role=obj:GetAttribute("__VNCColorRole_"..property)
                if type(role)=="string" then
                    if table.find(keys,role) then
                        local accentRole=role=="Accent" or role=="AccentSoft" or role=="StrokeHot"
                        if not (preserveAccent and accentRole) and typeof(c[role])=="Color3" then
                            local ok,tween=pcall(function() return TweenService:Create(obj,TweenInfo.new(0),{[property]=c[role]}) end)

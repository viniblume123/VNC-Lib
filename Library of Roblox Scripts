                    if cfg.Flag then Sec._lib:_ScheduleConfigAutoSave() end
                end
                Refresh()
            end)
        end
    end
    Refresh()
    local followConn
    local function PositionList()
        if not List.Visible or not Wrapped.Parent then return end
        local wp = Wrapped.AbsolutePosition
        local mp = Sec._window._main.AbsolutePosition
        local scale=math.max(Sec._window._uiscale.Scale,0.01)
        local mainSize=Sec._window._main.AbsoluteSize/scale
        local x=math.clamp((wp.X-mp.X)/scale,8,math.max(8,mainSize.X-math.max(Wrapped.AbsoluteSize.X/scale,180)-8))
        local y=(wp.Y-mp.Y)/scale+Wrapped.AbsoluteSize.Y/scale+6

function L:CreateSearch(cfg)
    local Tab = self
    if type(Tab)~="table" then return nil,"tab required" end
    local Win = Tab._window
    if not Win or Win._destroyed or not Tab._frame or type(Tab._sections)~="table" then return nil,"tab required" end
    cfg=type(cfg)=="table" and cfg or {}
    if Tab._searchElement and Tab._searchElement.Destroy then pcall(function() Tab._searchElement:Destroy() end) end
    local lib=Tab._lib or L
    local C = Tab.C or (Win and Win.C) or (lib and lib.C) or L.C
    local Wrapped = Instance.new("Frame")
    Wrapped.Size = UDim2.new(1,0,0,38)
    Wrapped.LayoutOrder = 0
    Wrapped.BackgroundColor3 = C.Card
    Wrapped.BorderSizePixel = 0
    Wrapped.Parent = Tab._frame
    local Wc = Instance.new("UICorner"); Wc.CornerRadius = UDim.new(0,10); Wc.Parent = Wrapped
    local Ws = Instance.new("UIStroke"); Ws.Color = C.Stroke; Ws.Thickness = 1; Ws.Transparency = 0.4; Ws.Parent = Wrapped
    local Box = Instance.new("TextBox")
    Box.Size = UDim2.new(1,-20,1,0)
    Box.Position = UDim2.new(0,10,0,0)
    Box.BackgroundTransparency = 1
    Box.Text = ""
    Box.PlaceholderText = cfg.Placeholder or "Search..."
    Box.Font = Enum.Font[lib.CurrentFont]
    Box.TextSize = 12
    Box.TextColor3 = C.Text
    Box.PlaceholderColor3 = C.TextFaint
    Box.TextXAlignment = Enum.TextXAlignment.Left
    Box.ClearTextOnFocus = false
    Box.Parent = Wrapped
    local function filterElements()
        local query=string.lower(tostring(Box.Text or ""))
        for _,section in ipairs(Tab._sections) do
            local sectionMatch=query~="" and string.lower(tostring(section._name or "")):find(query,1,true)~=nil
            local visibleCount=0
            for _,element in ipairs(section._elements or {}) do
                if element and element.Parent then
                    local wasVisible=element:GetAttribute("__VNCSearchVisible")
                    if wasVisible==nil then wasVisible=element.Visible; element:SetAttribute("__VNCSearchVisible",wasVisible) end
                    local matches=sectionMatch
                    if query=="" then matches=true
                    elseif not matches then
                        local chunks={element.Name or "",element:GetAttribute("__VNCSearchText") or ""}
                        for _,obj in ipairs(element:GetDescendants()) do
                            if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                                table.insert(chunks,obj.Text or "")
                                if obj:IsA("TextBox") then table.insert(chunks,obj.PlaceholderText or "") end
                            end
                        end
                        matches=string.lower(table.concat(chunks," ")):find(query,1,true)~=nil
                    end
                    element.Visible=wasVisible and matches
                    if element.Visible then visibleCount+=1 end
                end
            end
            if section._holder then
                section._holder.Visible=query=="" or sectionMatch or visibleCount>0
            end
            if section._inner then
                section._inner.Visible=query~="" and (sectionMatch or visibleCount>0) or (not section._collapsed)
            end
        end
    end
    Tab._searchRefresh=filterElements
    local connection=Win:_Connect(Box:GetPropertyChangedSignal("Text"),function()
        if cfg.Filter~=false then filterElements() end
        if cfg.Callback then pcall(cfg.Callback,Box.Text) end
    end)
    Tab._connections=Tab._connections or {}; table.insert(Tab._connections,connection)
    local Element = {Instance=Wrapped, TextBox=Box, _lib=lib}
    function Element:Get() return Box.Text end
    function Element:Set(value) Box.Text=tostring(value or "") end
    function Element:Destroy()
        if connection then connection:Disconnect(); connection=nil end
        Box.Text=""; filterElements()
        if Tab._searchRefresh==filterElements then Tab._searchRefresh=nil end
        if Tab._searchElement==Element then Tab._searchElement=nil end
        Wrapped:Destroy()
    end
    Element.Refresh=filterElements
    Tab._searchElement=Element
    if cfg.Filter~=false then filterElements() end
    return Element
end


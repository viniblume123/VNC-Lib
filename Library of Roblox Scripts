function L:AddFPSWidget()
    local last, frames, fps = os.clock(), 0, 0
    local conn
    local w=self:AddWidget({Id="fps",Name="FPS",Icon="F",Color=self.C.Info,Interval=0.5,Default="-",OnUpdate=function() return tostring(fps) end})
    conn=RS.RenderStepped:Connect(function()
        frames+=1
        local now=os.clock()
        if now-last>=0.5 then fps=math.floor(frames/(now-last)+0.5); frames=0; last=now end
    end)
    table.insert(self._connections,conn)
    local oldDestroy=w.Destroy
    function w:Destroy() if conn then pcall(function() conn:Disconnect() end); conn=nil end; oldDestroy(self) end
    return w
end


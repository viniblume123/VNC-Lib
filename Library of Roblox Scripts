local function NormalizeHttpResponse(response, backend, status, err)
    if type(response)=="string" then
        local code=tonumber(status)
        local success=code and code>=200 and code<300 or code==nil and err==nil
        return {Success=success==true,StatusCode=code,StatusKnown=code~=nil,Body=response,Provider=backend,Error=err and tostring(err) or nil}
    end
    if type(response)~="table" then
        local code=tonumber(status)
        return {Success=false,StatusCode=code,StatusKnown=code~=nil,Body="",Provider=backend,Error=tostring(err or "HTTP backend returned an invalid response")}
    end
    local code=tonumber(response.StatusCode or response.statusCode or status)
    local responseBody=response.Body
    if responseBody==nil then responseBody=response.body end
    local errorText=response.Error or response.error or response.StatusMessage or err
    local success=response.Success
    if success==nil then success=response.success end
    if success==nil then success=code~=nil and code>=200 and code<300 or code==nil and errorText==nil end
    return {Success=success==true,StatusCode=code,StatusKnown=code~=nil,Body=type(responseBody)=="string" and responseBody or "",Provider=backend,Error=errorText and tostring(errorText) or nil}
end

local function HttpRequest(method,url,body,headers)
    method=type(method)=="string" and method:upper() or "GET"
    url=type(url)=="string" and url or ""
    if (method~="GET" and method~="POST" and method~="PUT" and method~="PATCH" and method~="DELETE" and method~="HEAD") then
        return {Success=false,Body="",Provider="None",Error="unsupported HTTP method"}
    end
    if url=="" then return {Success=false,Body="",Provider="None",Error="URL is required"} end
    headers=type(headers)=="table" and headers or {}
    local mode=type(L.HttpMode)=="string" and L.HttpMode:lower() or "auto"
    local provider=L.HttpProvider
    local providerMethod=method=="GET" and "Get" or method=="POST" and "Post" or "Request"
    local canProvider=type(provider)=="table" and (type(provider[providerMethod])=="function" or type(provider.Request)=="function")
    local backend,invoke
    if mode=="provider" then
        if not canProvider then return {Success=false,Body="",Provider="Provider",Error="configured HTTP provider does not support this method"} end
        backend="Provider"
        invoke=function()
            local fn=provider[providerMethod] or provider.Request
            if method=="GET" and fn==provider.Request then return fn(method,url,nil,headers) end
            if method=="POST" and fn==provider.Request then return fn(method,url,body,headers) end
            if method=="GET" then return fn(url,headers) end
            if method=="POST" then return fn(url,body,headers) end
            return fn(method,url,body,headers)
        end
    elseif mode=="executor" then
        if type(REQ)~="function" then return {Success=false,Body="",Provider="Executor",Error="executor request API is unavailable"} end
        backend="Executor"
        invoke=function() return REQ({Url=url,Method=method,Body=body,Headers=headers}) end
    elseif mode=="roblox" then
        backend="Roblox"
        invoke=function()
            local request={Url=url,Method=method,Headers=headers}
            if method~="GET" and method~="HEAD" then request.Body=tostring(body or "") end
            return HS:RequestAsync(request)
        end
    elseif mode=="auto" then
        if canProvider then
            local fn=provider[providerMethod] or provider.Request
            backend="Provider"
            invoke=function()
                if method=="GET" and fn==provider.Request then return fn(method,url,nil,headers) end
                if method=="POST" and fn==provider.Request then return fn(method,url,body,headers) end
                if method=="GET" then return fn(url,headers) end
                if method=="POST" then return fn(url,body,headers) end
                return fn(method,url,body,headers)
            end
        elseif type(REQ)=="function" then
            backend="Executor"
            invoke=function() return REQ({Url=url,Method=method,Body=body,Headers=headers}) end
        elseif method=="GET" and type(SafeInstanceMember(game,"HttpGet"))=="function" then
            backend="GameHttpGet"
            invoke=function() return game:HttpGet(url) end
        else
            backend="Roblox"
            invoke=function()
                local request={Url=url,Method=method,Headers=headers}
                if method~="GET" and method~="HEAD" then request.Body=tostring(body or "") end
                return HS:RequestAsync(request)
            end
        end
    else
        return {Success=false,Body="",Provider="None",Error="HttpMode must be Auto, Provider, Executor, or Roblox"}
    end

    local ok,response,detail
    if backend=="Provider" then ok,response,detail=InvokeUserCallback(invoke)
    else ok,response=pcall(invoke) end
    local detailStatus=tonumber(detail)
    local detailError=detail~=nil and detailStatus==nil and tostring(detail) or nil
    local result=ok and NormalizeHttpResponse(response,backend,detailStatus,detailError) or NormalizeHttpResponse(nil,backend,nil,response)
    if not result.Success and not result.Error then result.Error="HTTP request failed" end
    return result
end

local function HttpGet(url)
    local result=HttpRequest("GET",url)
    if result.Success then return result.Body,result.StatusCode end
    return nil,result.Error or result.StatusCode
end

local function HttpPost(url, body, headers)
    local result=HttpRequest("POST",url,body,headers or {["Content-Type"]="application/json"})
    if result.Success then return result.Body,result.StatusCode end
    return nil,result.Error or result.StatusCode
end

local function JsonRead(file, def)
    local provider=L.StorageProvider
    if type(provider)=="table" then
        if type(provider.Read)~="function" then return def end
        local providerOk,providerResult=InvokeUserCallback(provider.Read,file)
        if providerOk and type(providerResult)=="table" then return providerResult end
        if providerOk and type(providerResult)=="string" and providerResult~="" then
            local decodeOk,decoded=pcall(HS.JSONDecode,HS,providerResult)
            if decodeOk and type(decoded)=="table" then return decoded end
        end
        return def
    end
    if not ISF then return def end
    local existsOk,exists=pcall(ISF,file)
    if not existsOk or not exists then return def end
    local ok, c = pcall(RF, file)
    if not ok or not c then return def end
    local ok2, d = pcall(HS.JSONDecode, HS, c)
    if ok2 and type(d)=="table" then return d end
    return def
end

local function JsonWrite(file, data)
    local provider=L.StorageProvider
    if type(provider)=="table" and type(provider.Write)=="function" then
        local providerOk,providerResult=InvokeUserCallback(provider.Write,file,data)
        if not providerOk then return false,tostring(providerResult) end
        if providerResult==false then return false,"storage provider rejected the write" end
        return true
    end
    if not WF then return false, "writefile is unavailable" end
    local encodedOk, encoded = pcall(HS.JSONEncode, HS, data)
    if not encodedOk then return false, tostring(encoded) end
    local writeOk, writeResult = pcall(WF, file, encoded)
    if not writeOk then return false, tostring(writeResult) end
    if writeResult==false then return false,"writefile reported failure" end
    return true
end

local function StorageDelete(file)
    if type(file)~="string" or file=="" then return false,"file path required" end
    local provider=L.StorageProvider
    if type(provider)=="table" then
        if type(provider.Delete)~="function" then return false,"configure StorageProvider.Delete to remove saved data" end
        local providerOk,providerResult=InvokeUserCallback(provider.Delete,file)
        if not providerOk then return false,tostring(providerResult) end
        if providerResult==false then return false,"storage provider rejected the delete" end
        return true
    end
    if type(ISF)~="function" or type(DF)~="function" then return false,"delete is unavailable; configure StorageProvider.Delete" end
    local existsOk,exists=pcall(ISF,file)
    if not existsOk then return false,tostring(exists) end
    if not exists then return true end
    local deleteOk,deleteError=pcall(DF,file)
    if not deleteOk then return false,tostring(deleteError) end
    return true
end

local function StorageList(prefix)
    prefix=type(prefix)=="string" and prefix or ""
    local provider=L.StorageProvider
    if type(provider)=="table" then
        if type(provider.List)~="function" then return {},"configure StorageProvider.List to enumerate saved data" end
        local providerOk,providerResult=InvokeUserCallback(provider.List,prefix)
        if providerOk and type(providerResult)=="table" then
            local files={}
            for _,file in ipairs(providerResult) do if type(file)=="string" then table.insert(files,file) end end
            return files
        end
        return {},tostring(providerOk and "storage provider List must return an array" or providerResult)
    end
    if type(listfiles)~="function" then return {},"listfiles is unavailable" end
    local listOk,files=pcall(listfiles,".")
    if not listOk or type(files)~="table" then return {},tostring(files or "listfiles returned an invalid value") end
    local result={}
    for _,file in ipairs(files) do
        if type(file)=="string" then
            local base=file:gsub("\\","/"):match("([^/]+)$") or file
            if prefix=="" or base:sub(1,#prefix)==prefix then table.insert(result,file) end
        end
    end
    return result
end

local function StorageExists(file)
    if type(file)~="string" or file=="" then return false,"file path required" end
    local provider=L.StorageProvider
    if type(provider)=="table" then
        if type(provider.Exists)~="function" then return false,"configure StorageProvider.Exists to check file existence" end
        local ok,result=InvokeUserCallback(provider.Exists,file)
        if not ok then return false,tostring(result) end
        return result==true
    end
    if type(ISF)~="function" then return false,"isfile is unavailable" end
    local ok,result=pcall(ISF,file)
    if not ok then return false,tostring(result) end
    return result==true
end

local function StorageRename(fromPath,toPath)
    if type(fromPath)~="string" or fromPath=="" or type(toPath)~="string" or toPath=="" then return false,"source and destination paths are required" end
    local provider=L.StorageProvider
    if type(provider)=="table" then
        if type(provider.Rename)~="function" then return false,"configure StorageProvider.Rename to rename saved data" end
        local ok,result=InvokeUserCallback(provider.Rename,fromPath,toPath)
        if not ok then return false,tostring(result) end
        return result~=false,result==false and "storage provider rejected the rename" or nil
    end
    if type(MVF)~="function" then return false,"movefile is unavailable" end
    local ok,result=pcall(MVF,fromPath,toPath)
    if not ok then return false,tostring(result) end
    return result~=false,result==false and "movefile reported failure" or nil
end

local function StorageClear(prefix)
    if type(prefix)~="string" or prefix=="" then return false,"a non-empty path prefix is required" end
    local provider=L.StorageProvider
    if type(provider)=="table" and type(provider.Clear)=="function" then
        local ok,result=InvokeUserCallback(provider.Clear,prefix)
        if not ok then return false,tostring(result) end
        if result==false then return false,"storage provider rejected the clear" end
        return type(result)=="number" and result or true
    end
    if type(provider)=="table" and (type(provider.List)~="function" or type(provider.Delete)~="function") then return false,"configure StorageProvider.Clear or both List and Delete" end
    if type(provider)~="table" and type(listfiles)~="function" then return false,"listfiles is unavailable" end
    local files,listError=StorageList(prefix)
    if listError then return false,tostring(listError) end
    local removed=0
    for _,file in ipairs(files) do
        if type(file)=="string" then
            local normalized=file:gsub("\\","/")
            local basename=normalized:match("([^/]+)$") or normalized
            if basename:sub(1,#prefix)==prefix then
                local ok,err=StorageDelete(file)
                if not ok then return false,tostring(err) end
                removed+=1
            end
        end
    end
    return removed
end

local function StorageEnsureDirectory(path)
    if type(path)~="string" or path=="" then return false,"directory path required" end
    local provider=L.StorageProvider
    if type(provider)=="table" then
        if type(provider.EnsureDirectory)=="function" then
            local ok,result=InvokeUserCallback(provider.EnsureDirectory,path)
            if not ok then return false,tostring(result) end
            return result~=false,result==false and "storage provider rejected the directory" or nil
        end
        return true,"storage provider uses logical paths and does not require directories"
    end
    if type(MFN)~="function" then return false,"makefolder is unavailable" end
    if type(ISDIR)=="function" then
        local checkOk,exists=pcall(ISDIR,path)
        if checkOk and exists then return true end
    end
    local ok,result=pcall(MFN,path)
    if not ok then
        if type(ISDIR)=="function" then local checkOk,exists=pcall(ISDIR,path); if checkOk and exists then return true end end
        return false,tostring(result)
    end
    return result~=false,result==false and "makefolder reported failure" or nil
end

local function HexToColor(h)
    if not h then return nil end
    h = tostring(h):gsub("#","")
    if #h==3 then h = h:sub(1,1):rep(2)..h:sub(2,2):rep(2)..h:sub(3,3):rep(2) end
    if #h~=6 then return nil end
    local r,g,b = tonumber(h:sub(1,2),16), tonumber(h:sub(3,4),16), tonumber(h:sub(5,6),16)
    if not r or not g or not b then return nil end
    return Color3.fromRGB(r,g,b)
end

local function ColorToHex(c)
    return string.format("#%02X%02X%02X", math.floor(c.R*255+0.5), math.floor(c.G*255+0.5), math.floor(c.B*255+0.5))
end

local function FormatControlNumber(value, maxDigits)
    maxDigits=tonumber(maxDigits) or 3
    if maxDigits~=maxDigits or maxDigits==math.huge or maxDigits==-math.huge then maxDigits=3 end
    maxDigits=math.floor(math.clamp(maxDigits,0,8))
    local n = tonumber(value) or 0
    if n ~= n or n == math.huge or n == -math.huge then n = 0 end
    local sign = n < 0 and "-" or ""
    local a = math.abs(n)
    if maxDigits==0 then local rounded=math.floor(a+0.5); return (rounded==0 and "" or sign)..tostring(rounded) end
    if a < 1 then
        local t = string.format("%."..maxDigits.."f", a):gsub("0+$", ""):gsub("%.$", "")
        if t=="" then return "0" end
        return sign .. t
    end
    local whole = tostring(math.floor(a))
    if a == math.floor(a) then return sign .. whole end
    local formatted=string.format("%."..maxDigits.."f",a):gsub("0+$",""):gsub("%.$","")
    return (formatted=="0" and "" or sign)..formatted
end

local function ClampNumber(value, fallback, minimum, maximum)
    local number=tonumber(value)
    minimum=tonumber(minimum) or -math.huge
    maximum=tonumber(maximum) or math.huge
    if minimum>maximum then minimum,maximum=maximum,minimum end
    if not number or number~=number or number==math.huge or number==-math.huge then number=tonumber(fallback) end
    if not number or number~=number or number==math.huge or number==-math.huge then
        number=minimum~=-math.huge and minimum or (maximum~=math.huge and maximum or 0)
    end
    return math.clamp(number,minimum,maximum)
end

local function SafeColor(value, fallback)
    return typeof(value) == "Color3" and value or fallback
end

local function NormalizeIcon(value)
    if type(value)=="number" and value>0 and value<math.huge then
        return "rbxassetid://"..tostring(math.floor(value))
    end
    if type(value)=="string" then
        local numericId=value:match("^%s*(%d+)%s*$")
        if numericId and tonumber(numericId) and tonumber(numericId)>0 then return "rbxassetid://"..numericId end
        return value
    end
    return ""
end

local function ParseAspectRatio(value)
    if type(value)=="number" then
        if value>0 and value<math.huge then return math.clamp(value,0.1,10) end
        return nil
    end
    if type(value)~="string" then return nil end
    local width,height=value:match("^%s*(%d+%.?%d*)%s*:%s*(%d+%.?%d*)%s*$")
    width,height=tonumber(width),tonumber(height)
    if width and height and width>0 and height>0 and width<math.huge and height<math.huge then return math.clamp(width/height,0.1,10) end
    return nil
end

local function SetAspectConstraint(parent,constraint,value)
    local ratio=ParseAspectRatio(value)
    if not ratio then return constraint,false end
    if not constraint or not constraint.Parent then
        constraint=Instance.new("UIAspectRatioConstraint")
        constraint.DominantAxis=Enum.DominantAxis.Width
        constraint.Parent=parent
    end
    constraint.AspectRatio=ratio
    return constraint,true
end

local function SanitizeForJson(value, seen, depth)
    depth=depth or 0
    local kind=typeof(value)
    if kind=="Color3" then return {__vncType="Color3",r=value.R,g=value.G,b=value.B} end
    if kind=="Vector2" then return {__vncType="Vector2",x=value.X,y=value.Y} end
    if kind=="Vector3" then return {__vncType="Vector3",x=value.X,y=value.Y,z=value.Z} end
    if kind=="UDim" then return {__vncType="UDim",scale=value.Scale,offset=value.Offset} end
    if kind=="UDim2" then return {__vncType="UDim2",xs=value.X.Scale,xo=value.X.Offset,ys=value.Y.Scale,yo=value.Y.Offset} end
    if kind=="EnumItem" then return {__vncType="EnumItem",enumType=value.EnumType.Name,name=value.Name} end
    if kind=="CFrame" then
        local components={value:GetComponents()}
        return {__vncType="CFrame",components=components}
    end
    if kind=="NumberSequence" then
        local keys={}; for _,keypoint in ipairs(value.Keypoints) do table.insert(keys,{keypoint.Time,keypoint.Value,keypoint.Envelope}) end
        return {__vncType="NumberSequence",keys=keys}
    end
    if kind=="ColorSequence" then
        local keys={}; for _,keypoint in ipairs(value.Keypoints) do table.insert(keys,{keypoint.Time,keypoint.Value.R,keypoint.Value.G,keypoint.Value.B}) end

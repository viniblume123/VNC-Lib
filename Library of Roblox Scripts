function L:CreateViewportFrame(cfg)
    local Sec=self
    if not IsElementContainer(Sec) then return nil,"section or tab required" end
    cfg=type(cfg)=="table" and cfg or {}
    local C=Sec.C or (Sec._window and Sec._window.C) or (Sec._lib and Sec._lib.C) or L.C
    local source=cfg.Model or cfg.Object or cfg.Instance
    if typeof(source)~="Instance" or not (source:IsA("Model") or source:IsA("BasePart")) then
        return nil,"Model or BasePart required"
    end
    local height=ClampNumber(cfg.Height,220,100,1200)
    local root=Instance.new("Frame")
    root.Name="ViewportPreview"
    root.Size=UDim2.new(1,0,0,height)
    root.BackgroundColor3=SafeColor(cfg.BackgroundColor,C.Surface)
    root.BorderSizePixel=0
    root.ClipsDescendants=true
    root.Parent=Sec._inner or Sec._holder
    local corner=Instance.new("UICorner"); corner.CornerRadius=UDim.new(0,ClampNumber(cfg.Radius,10,0,32)); corner.Parent=root
    local aspectConstraint=SetAspectConstraint(root,nil,cfg.AspectRatio)
    local viewport=Instance.new("ViewportFrame")
    viewport.Name="Viewport"
    viewport.Size=UDim2.new(1,-12,1,-12)
    viewport.Position=UDim2.fromOffset(6,6)
    viewport.BackgroundTransparency=1
    viewport.Ambient=SafeColor(cfg.Ambient,Color3.fromRGB(190,190,190))
    viewport.LightColor=SafeColor(cfg.LightColor,Color3.fromRGB(255,255,255))
    viewport.LightDirection=typeof(cfg.LightDirection)=="Vector3" and cfg.LightDirection or Vector3.new(-1,-1,-1).Unit
    viewport.Parent=root
    local world=Instance.new("WorldModel"); world.Name="WorldModel"; world.Parent=viewport
    local camera=Instance.new("Camera"); camera.Name="ViewportCamera"; camera.FieldOfView=ClampNumber(cfg.FieldOfView,35,15,75); camera.Parent=viewport
    viewport.CurrentCamera=camera
    local clone,original
    local destroyed=false
    local focusCenter=Vector3.zero
    local focusDistance=8
    local cameraYaw=math.pi/4
    local cameraPitch=0.35
    local function applyCamera()
        local cosPitch=math.cos(cameraPitch)
        local direction=Vector3.new(math.sin(cameraYaw)*cosPitch,math.sin(cameraPitch),math.cos(cameraYaw)*cosPitch)
        camera.CFrame=CFrame.lookAt(focusCenter+direction*focusDistance,focusCenter)
    end
    local function focusObject(object,keepCamera)
        local center,size
        if object:IsA("Model") then
            local boundsOk,boundsCFrame,boundsSize=pcall(function() return object:GetBoundingBox() end)
            if boundsOk then center,size=boundsCFrame.Position,boundsSize end
        else
            center,size=object.Position,object.Size
        end
        center=typeof(center)=="Vector3" and center or Vector3.zero
        size=typeof(size)=="Vector3" and size or Vector3.new(6,6,6)
        local radius=ClampNumber(size.Magnitude*0.5,3,0.1,10000)
        local fov=math.rad(camera.FieldOfView)
        focusCenter=center
        focusDistance=ClampNumber(radius/math.max(math.tan(fov*0.5),0.01)*1.2,8,1,20000)
        if not keepCamera then
            local direction=typeof(cfg.CameraDirection)=="Vector3" and cfg.CameraDirection or Vector3.new(1,0.6,1)
            if direction.Magnitude<0.001 then direction=Vector3.new(1,0.6,1) end
            direction=direction.Unit
            cameraYaw=math.atan2(direction.X,direction.Z)
            cameraPitch=math.asin(math.clamp(direction.Y,-1,1))
        end
        applyCamera()
    end
    local interactionConnections={}
    if cfg.Interactive==true then
        viewport.Active=true
        local dragging,dragType,lastPosition=false,nil,nil
        table.insert(interactionConnections,viewport.InputBegan:Connect(function(input)
            if input.UserInputType==Enum.UserInputType.MouseButton1 then
                dragging=true; dragType="mouse"; lastPosition=Vector2.new(input.Position.X,input.Position.Y)
            elseif input.UserInputType==Enum.UserInputType.Touch then
                dragging=true; dragType="touch"; lastPosition=Vector2.new(input.Position.X,input.Position.Y)
            end
        end))
        table.insert(interactionConnections,UIS.InputChanged:Connect(function(input)
            if not dragging or not lastPosition then return end
            local validInput=(dragType=="mouse" and input.UserInputType==Enum.UserInputType.MouseMovement) or (dragType=="touch" and input.UserInputType==Enum.UserInputType.Touch)
            if not validInput then return end
            local current=Vector2.new(input.Position.X,input.Position.Y)
            local delta=current-lastPosition
            lastPosition=current
            cameraYaw-=delta.X*0.01
            cameraPitch=ClampNumber(cameraPitch+delta.Y*0.01,cameraPitch,-1.45,1.45)
            applyCamera()
        end))
        table.insert(interactionConnections,UIS.InputEnded:Connect(function(input)
            if (dragType=="mouse" and input.UserInputType==Enum.UserInputType.MouseButton1) or (dragType=="touch" and input.UserInputType==Enum.UserInputType.Touch) then
                dragging=false; dragType=nil; lastPosition=nil
            end
        end))
    end
    local function cleanupInteractions()
        for _,connection in ipairs(interactionConnections) do if connection then connection:Disconnect() end end
        table.clear(interactionConnections)
    end
    root.Destroying:Connect(function() destroyed=true; cleanupInteractions() end)
    local function setObject(object,keepCamera)
        if destroyed then return false,"viewport is destroyed" end
        if typeof(object)~="Instance" or not (object:IsA("Model") or object:IsA("BasePart")) then return false,"Model or BasePart required" end
        local ok,candidate=pcall(function() return object:Clone() end)
        if not ok or typeof(candidate)~="Instance" then return false,ok and "object is not Archivable" or tostring(candidate) end
        if not (candidate:IsA("Model") or candidate:IsA("BasePart")) then candidate:Destroy(); return false,"unsupported viewport object" end
        if clone and clone.Parent then clone:Destroy() end
        clone=candidate
        original=object
        clone.Parent=world
        focusObject(clone,keepCamera==true)
        if type(cfg.OnObjectChanged)=="function" then InvokeUserCallback(cfg.OnObjectChanged,object,clone) end
        return true
    end
    local ok,err=setObject(source)
    if not ok then root:Destroy(); return nil,err end
    local Element=setmetatable({Instance=root,_lib=Sec._lib,_favoriteId=cfg.Flag or cfg.Name,_favoriteName=cfg.Name,_favoriteTab=Sec._tab},ElementMethods)
    Element:InitFavorite()
    function Element:SetObject(object,keepCamera) return setObject(object,keepCamera) end
    function Element:SetAspectRatio(value)
        local constraint,ok=SetAspectConstraint(root,aspectConstraint,value)
        if ok then aspectConstraint=constraint end
        return ok
    end
    Element.SetModel=Element.SetObject
    function Element:Focus()
        if destroyed then return false end
        if not clone or not clone.Parent then return false end
        focusObject(clone,true)
        return true
    end
    function Element:GetObject() return original,clone end
    function Element:Destroy()
        if destroyed then return false end
        destroyed=true
        cleanupInteractions()
        if clone and clone.Parent then clone:Destroy() end
        clone=nil; original=nil
        if root.Parent then root:Destroy() end
        return true
    end
    Sec:_AddElement(root)
    return Element
end

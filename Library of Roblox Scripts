function L:ValidateHttpProvider(provider)
    local issues={}
    local function issue(field,message) table.insert(issues,{Field=field,Message=message}) end
    if provider==nil then return true,issues end
    if type(provider)~="table" then return false,{{Field="Provider",Message="expected a table or nil"}} end
    local usable=false
    for _,method in ipairs({"Get","Post","Request"}) do
        if provider[method]~=nil and type(provider[method])~="function" then issue(method,"expected a function")
        elseif type(provider[method])=="function" then usable=true end
    end
    if not usable then issue("Provider","implement at least one of Get, Post, or Request") end
    return #issues==0,issues
end

function L:ValidateStorageProvider(provider)
    local issues={}
    local function issue(field,message) table.insert(issues,{Field=field,Message=message}) end
    if provider==nil then return true,issues end
    if type(provider)~="table" then return false,{{Field="Provider",Message="expected a table or nil"}} end
    for _,method in ipairs({"Read","Write"}) do
        if type(provider[method])~="function" then issue(method,"required function") end
    end
    for _,method in ipairs({"Delete","List","Exists","Rename","Clear","EnsureDirectory"}) do
        if provider[method]~=nil and type(provider[method])~="function" then issue(method,"expected a function") end
    end
    return #issues==0,issues
end

function L:ValidateTheme(theme)
    local issues={}
    local function issue(field,message) table.insert(issues,{Field=field,Message=message}) end
    if type(theme)=="string" then
        if theme=="Custom" and type(self._customPalette)=="table" then return true,issues end
        if theme=="Animated" and self.Palettes[self.ThemeBase] then return true,issues end
        if not self.Palettes[theme] then issue("Theme","unknown palette name") end
    elseif type(theme)=="table" then
        local reference=self.Palettes.Dark or {}
        for key,value in pairs(theme) do
            if reference[key]==nil then issue(tostring(key),"unknown palette key")
            elseif typeof(value)~="Color3" then issue(tostring(key),"expected Color3") end
        end
    else
        issue("Theme","expected a palette name or Color3 table")
    end
    return #issues==0,issues
end

function L:ValidateSound(cfg)
    local issues={}
    local function issue(field,message) table.insert(issues,{Field=field,Message=message}) end
    if type(cfg)~="table" then return false,{{Field="Sound",Message="expected a settings table"}} end
    for _,field in ipairs({"enabled","Enabled","silent","Silent"}) do
        if cfg[field]~=nil and type(cfg[field])~="boolean" then issue(field,"expected a boolean") end
    end
    local volume=cfg.volume
    if volume==nil then volume=cfg.Volume end
    if volume~=nil then
        local number=tonumber(volume)
        if not number or number~=number or number==math.huge or number==-math.huge or number<0 or number>1 then issue("Volume","expected a finite number from 0 to 1") end
    end
    local channels=cfg.channels or cfg.Channels
    if channels~=nil then
        if type(channels)~="table" then issue("Channels","expected a table")
        else
            for name,value in pairs(channels) do
                local number=tonumber(value)
                if type(name)~="string" or name=="" then issue("Channels","channel names must be non-empty strings")
                elseif not number or number~=number or number==math.huge or number==-math.huge or number<0 or number>1 then issue("Channels."..name,"expected a finite number from 0 to 1") end
            end
        end
    end
    for _,slot in ipairs(DefaultSoundSlots) do
        local upperSlot=slot:sub(1,1):upper()..slot:sub(2)
        local value=cfg[slot]
        if value==nil then value=cfg[upperSlot] end
        if value~=nil and tostring(value):match("^%s*$")==nil and not NormalizeSoundId(value) then
            issue(upperSlot,"expected an asset ID or rbxassetid:// URI")
        end
    end
    local ducking=cfg.ducking or cfg.Ducking
    if ducking~=nil and type(ducking)~="boolean" and type(ducking)~="table" then issue("Ducking","expected a boolean or settings table")
    elseif type(ducking)=="table" then
        if ducking.enabled~=nil and type(ducking.enabled)~="boolean" then issue("Ducking.enabled","expected a boolean") end
        if ducking.Enabled~=nil and type(ducking.Enabled)~="boolean" then issue("Ducking.Enabled","expected a boolean") end
        local duckVolume=ducking.volume
        if duckVolume==nil then duckVolume=ducking.Volume end
        if duckVolume~=nil then
            local number=tonumber(duckVolume)
            if not number or number~=number or number==math.huge or number==-math.huge or number<0 or number>1 then issue("Ducking.Volume","expected a finite number from 0 to 1") end
        end
        local duckChannels=ducking.channels or ducking.Channels
        if duckChannels~=nil then
            if type(duckChannels)~="table" then issue("Ducking.Channels","expected a table")
            else for channel,value in pairs(duckChannels) do if type(channel)~="string" or channel=="" or type(value)~="boolean" then issue("Ducking.Channels","channel names must map to booleans") end end end
        end
    end
    return #issues==0,issues
end

function L:ValidateNotification(cfg)
    local issues={}
    local function issue(field,message) table.insert(issues,{Field=field,Message=message}) end
    if type(cfg)~="table" then return false,{{Field="Notification",Message="expected a table"}} end
    for _,field in ipairs({"Title","Text","Content"}) do
        if cfg[field]~=nil and type(cfg[field])~="string" and type(cfg[field])~="number" then issue(field,"expected text") end
    end
    local kind=cfg.Type
    if kind~=nil and (type(kind)~="string" or not ({info=true,success=true,warning=true,error=true})[kind:lower()]) then issue("Type","expected info, success, warning, or error") end
    if cfg.Duration~=nil then
        local duration=tonumber(cfg.Duration)
        if not duration or duration~=duration or duration==math.huge or duration==-math.huge then issue("Duration","expected a finite number") end
    end
    if cfg.ReturnHandle~=nil and type(cfg.ReturnHandle)~="boolean" then issue("ReturnHandle","expected a boolean") end
    return #issues==0,issues
end


Adicione como métodos da lib:

lua
L.Blocklist = {
    _cache = {},
    _remoteUrl = nil,
    _lastFetch = 0,
    _cacheDuration = 300
}

-- Configura a blocklist
function L:SetBlocklist(cfg)
    cfg = cfg or {}
    self.Blocklist._remoteUrl = cfg.RemoteUrl
    self.Blocklist._localFile = cfg.LocalFile or "library_blocklist.json"
    self.Blocklist._cacheDuration = cfg.CacheSeconds or 300
    self.Blocklist._onBlocked = cfg.OnBlocked
    self.Blocklist._byHwid = cfg.ByHwid ~= false
    self.Blocklist._byUserId = cfg.ByUserId ~= false
    self.Blocklist._byKey = cfg.ByKey or false
    self.Blocklist._local = JsonRead(self.Blocklist._localFile, {
        hwids = {}, userIds = {}, keys = {}
    })
end

-- Baixa a lista remota (pastebin, GitHub raw, etc)
function L.Blocklist:FetchRemote()
    local url = self._remoteUrl
    if not url or url == "" then return false end
    local now = os.time()
    if (now - self._lastFetch) < self._cacheDuration then return true end

    local body = HttpGet(url)
    if not body or body == "" then return false end

    local ok, data = pcall(HS.JSONDecode, HS, body)
    if not ok or type(data) ~= "table" then
        -- Tenta parsear como lista de linhas (formato simples)
        local lines = {}
        for line in body:gmatch("[^\r\n]+") do
            if line ~= "" and line:sub(1, 1) ~= "#" then
                table.insert(lines, line)
            end
        end
        data = { hwids = lines, userIds = lines }
    end

    self._cache = {
        hwids = data.hwids or data.hardwareIds or {},
        userIds = data.userIds or data.ids or {},
        keys = data.keys or data.bannedKeys or {}
    }
    self._lastFetch = now
    return true
end

-- Verifica se um identificador está na blocklist
function L.Blocklist:IsBlocked(kind, value)
    if not value or value == "" then return false end
    self:FetchRemote()

    local function check(list)
        for _, v in ipairs(list) do
            if tostring(v) == tostring(value) then return true end
        end
        return false
    end

    if kind == "hwid" and self._byHwid then
        if check(self._local.hwids) then return true end
        if check(self._cache.hwids or {}) then return true end
    elseif kind == "userId" and self._byUserId then
        if check(self._local.userIds) then return true end
        if check(self._cache.userIds or {}) then return true end
    elseif kind == "key" and self._byKey then
        if check(self._local.keys) then return true end
        if check(self._cache.keys or {}) then return true end
    end
    return false
end

-- Adiciona à blocklist local
function L.Blocklist:Add(kind, value)
    if not value or value == "" then return end
    local list = self._local[kind.."s"] or self._local[kind.."Ids"] or self._local[kind.."s"]
    if not list then
        if kind == "hwid" then self._local.hwids = self._local.hwids or {}
        elseif kind == "userId" then self._local.userIds = self._local.userIds or {}
        elseif kind == "key" then self._local.keys = self._local.keys or {} end
        list = self._local[kind.."s"] or self._local[kind.."Ids"]
    end
    table.insert(list, tostring(value))
    JsonWrite(self._localFile, self._local)
end

-- Remove da blocklist local
function L.Blocklist:Remove(kind, value)
    local list
    if kind == "hwid" then list = self._local.hwids
    elseif kind == "userId" then list = self._local.userIds
    elseif kind == "key" then list = self._local.keys end
    if not list then return end
    for i, v in ipairs(list) do
        if tostring(v) == tostring(value) then
            table.remove(list, i)
            JsonWrite(self._localFile, self._local)
            return
        end
    end
end

-- Roda checagem completa no boot
function L.Blocklist:RunCheck()
    local hwid = L:GetHWID()
    local uid = tostring(LP.UserId)
    local savedKey = JsonRead("library_key.json", {key=""}).key or ""

    local blockedBy = nil

    if self._byHwid and self:IsBlocked("hwid", hwid) then blockedBy = "HWID" end
    if not blockedBy and self._byUserId and self:IsBlocked("userId", uid) then blockedBy = "UserID" end
    if not blockedBy and self._byKey and self:IsBlocked("key", savedKey) then blockedBy = "Key" end

    if blockedBy then
        if self._onBlocked then
            pcall(self._onBlocked, blockedBy)
        else
            pcall(function() LP:Kick("Você foi bloqueado ("..blockedBy..")") end)
        end
        return false
    end
    return true
end

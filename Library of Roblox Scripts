function L:_Connect(signal, callback)
    if not signal or not callback then return nil end
    local ok, conn = pcall(function() return signal:Connect(callback) end)
    if ok and conn then table.insert(self._connections, conn); return conn end
end

function L:_DisconnectAll()
    for i = #self._connections, 1, -1 do
        local c = self._connections[i]
        if c then pcall(function() c:Disconnect() end) end
        self._connections[i] = nil
    end
end

function L:_ScheduleConfigAutoSave()
    if self._loadingConfig then return end
    self:_TrackConfigChange()
    if not self.Config.AutoSaveConfig or not self.Config.AutoSaveConfigName then return end
    self._configSaveToken = (self._configSaveToken or 0) + 1
    local token = self._configSaveToken
    task.delay(self.Config.AutoSaveConfigDelay or 0.75, function()
        if self._destroyed or token ~= self._configSaveToken then return end
        pcall(function() self:OverwriteConfig(self.Config.AutoSaveConfigName) end)
    end)
end

function L:RegisterState(flag, getter, setter)
    if type(flag) ~= "string" or flag == "" or type(getter) ~= "function" then return false end
    local entry = {Get=getter, Set=setter}
    self._state[flag] = entry
    self._lastHistorySnapshot=self:CaptureConfig()
    return true
end
function L:UnregisterState(flag) self._state[flag] = nil end
function L:On(eventName, callback)
    if type(eventName) ~= "string" or type(callback) ~= "function" then return nil end
    self._events[eventName] = self._events[eventName] or {}
    local event = self._events[eventName]
    local record = {Callback=callback, Connected=true}
    table.insert(event, record)
    return {Disconnect=function()
        if not record.Connected then return end
        record.Connected=false
        local index=table.find(event,record)
        if index then table.remove(event,index) end
    end}
end
function L:Emit(eventName, ...)
    local event=self._events[eventName] or {}
    local args=table.pack(...)
    for _, record in ipairs(event) do if record.Connected then pcall(record.Callback,table.unpack(args,1,args.n)) end end
    return #event
end
function L:Debounce(key, interval, callback, ...)
    if type(callback) ~= "function" then return false end
    local now=os.clock()
    self._debounce=self._debounce or {}
    if (self._debounce[key] or 0)>now then return false end
    self._debounce[key]=now+math.max(0,tonumber(interval) or 0.25)
    local ok,err=pcall(callback,...)
    if not ok then warn("[VNC-Lib] Debounced callback failed: "..tostring(err)); return false end
    return true
end
function L:CachedRequest(url, ttl)
    self._requestCache=self._requestCache or {}
    local now=os.clock()
    local cached=self._requestCache[url]
    if cached and cached.Expires>now then return cached.Body,true end
    local body=HttpGet(url)
    if body then self._requestCache[url]={Body=body,Expires=now+math.max(0,tonumber(ttl) or 30)} end
    return body,false
end
function L:SetFavorite(id, enabled)
    id=tostring(id or "")
    if id=="" then return false end
    local wasFavorite=self.Favorites[id]==true
    if enabled==false then self.Favorites[id]=nil else self.Favorites[id]=true end
    if wasFavorite~=(self.Favorites[id]==true) then JsonWrite("library_favorites.json",self.Favorites) end
    return self.Favorites[id]==true
end
function L:IsFavorite(id) return self.Favorites[tostring(id or "")] == true end
function L:GetFavorites()
    local out={}; for id,enabled in pairs(self.Favorites) do if enabled then table.insert(out,id) end end; table.sort(out); return out
end
function L:RegisterSound(name, id, category)
    if type(name)~="string" or name=="" or not id then return false end
    self.Sounds.library=self.Sounds.library or {}
    local soundId=tostring(id)
    if soundId:match("^%d+$") then soundId="rbxassetid://"..soundId end
    self.Sounds.library[name]={Name=name,Id=soundId,Category=category or "General"}
    return true
end
function L:SearchSounds(query, category, favoritesOnly)
    local out={}; local q=tostring(query or ""):lower()
    for name,sound in pairs(self.Sounds.library or {}) do
        local match=(q=="" or name:lower():find(q,1,true) or tostring(sound.Id):lower():find(q,1,true) or tostring(sound.Category):lower():find(q,1,true))
        local categoryMatch=not category or category=="All" or sound.Category==category
        local favoriteMatch=not favoritesOnly or self:IsFavorite(sound.Id)
        if match and categoryMatch and favoriteMatch then table.insert(out,sound) end
    end
    table.sort(out,function(a,b) return a.Name:lower()<b.Name:lower() end)
    return out
end
function L:CheckForUpdate(url)
    if type(url)~="string" or url=="" then return nil,"update manifest URL required" end
    local body=self:CachedRequest(url,300)
    if not body then return nil,"unable to fetch update manifest" end
    local ok,manifest=pcall(HS.JSONDecode,HS,body)
    if not ok or type(manifest)~="table" or type(manifest.version)~="string" then return nil,"invalid update manifest" end
    local function newer(a,b)
        local aa,bb={},{}
        for n in tostring(a):gmatch("%d+") do table.insert(aa,tonumber(n)) end
        for n in tostring(b):gmatch("%d+") do table.insert(bb,tonumber(n)) end
        for i=1,math.max(#aa,#bb) do local x,y=aa[i] or 0,bb[i] or 0; if x~=y then return x>y end end
        return false
    end
    return {current=self.Version,latest=manifest.version,updateAvailable=newer(manifest.version,self.Version),downloadUrl=manifest.url,notes=manifest.notes}
end
function L:_TrackConfigChange()
    local history=self.ConfigHistory
    local current=self:CaptureConfig()
    local previous=self._lastHistorySnapshot
    local changed = previous ~= nil
    if changed then
        local okPrevious, encodedPrevious = pcall(HS.JSONEncode, HS, previous)
        local okCurrent, encodedCurrent = pcall(HS.JSONEncode, HS, current)
        changed = not okPrevious or not okCurrent or encodedPrevious ~= encodedCurrent
    end
    if changed then
        table.insert(history.Undo,previous)
        while #history.Undo>history.Limit do table.remove(history.Undo,1) end
        table.clear(history.Redo)
    end
    self._lastHistorySnapshot=current
end
function L:PushConfigUndoPoint()
    local snapshot=self:CaptureConfig()
    table.insert(self.ConfigHistory.Undo,snapshot)
    while #self.ConfigHistory.Undo>self.ConfigHistory.Limit do table.remove(self.ConfigHistory.Undo,1) end
    table.clear(self.ConfigHistory.Redo)
    self._lastHistorySnapshot=snapshot
    return true
end
local function ApplyConfigSnapshot(lib,snapshot)
    local wasLoading=lib._loadingConfig; lib._loadingConfig=true
    local ok,err=pcall(function()
        for flag,value in pairs(snapshot.values or snapshot) do local entry=lib._state[flag]; if entry and entry.Set then entry.Set(value,true) end end
    end)
    lib._loadingConfig=wasLoading
    if not ok then warn("[VNC-Lib] History restore failed: "..tostring(err)); return false end
    lib._lastHistorySnapshot=lib:CaptureConfig()
    return true
end
function L:UndoConfig()
    local history=self.ConfigHistory
    local previous=table.remove(history.Undo)
    if not previous then return false end
    table.insert(history.Redo,self:CaptureConfig())
    return ApplyConfigSnapshot(self,previous)
end
function L:RedoConfig()
    local history=self.ConfigHistory
    local nextState=table.remove(history.Redo)
    if not nextState then return false end
    table.insert(history.Undo,self:CaptureConfig())
    return ApplyConfigSnapshot(self,nextState)
end
function L:SaveState(file)
    file = file or self._stateFile
    local data = {version=1, values={}}
    for flag, entry in pairs(self._state) do
        if entry.Get then
            local ok, value = pcall(entry.Get)
            if ok and (type(value)=="boolean" or type(value)=="number" or type(value)=="string" or type(value)=="table") then data.values[flag]=value end
        end
    end
    JsonWrite(file, data)
    return data
end
function L:LoadState(file, silent)
    local data = JsonRead(file or self._stateFile, nil)
    if type(data) ~= "table" then return false end
    for flag, value in pairs(data.values or data) do
        local entry = self._state[flag]
        if entry and entry.Set then pcall(entry.Set, value, silent ~= false) end
    end
    return true
end
function L:SetAutoSave(enabled, delay)
    self.Config.AutoSave = enabled ~= false
    if delay then self.Config.SaveDelay = math.max(0.1, tonumber(delay) or 0.75) end
end
function L:Destroy()
    if self._destroyed then return end
    self._destroyed = true
    pcall(function() self:SaveState() end)
    self:SetAutoSave(false)
    self:_DisconnectAll()
    pcall(function() self:StopSound(0) end)
    table.clear(self._activeWatchers or {})
    if self.WidgetGui then pcall(function() self.WidgetGui:Destroy() end); self.WidgetGui=nil end
    for _, gui in ipairs(self._auxGuis or {}) do if gui and gui.Parent then pcall(function() gui:Destroy() end) end end
    self._auxGuis = {}
    local windows=table.clone(self._allWindows or {})
    for _, w in ipairs(windows) do
        if w and not w._destroyed then pcall(function() w:Destroy() end) end
    end
    self._allWindows = {}
    self._window = nil
end
function L:SetAccent(color)
    if typeof(color) ~= "Color3" then return false end
    local oldAccent, oldSoft = self.C.Accent, self.C.AccentSoft
    local newSoft=color:Lerp(Color3.new(0,0,0),0.35)
    self.C.Accent=color; self.C.StrokeHot=color; self.C.AccentSoft=newSoft
    for _, win in ipairs(self._allWindows or {}) do
        if win and not win._destroyed then pcall(function() win:_ApplyAccent(oldAccent, color, newSoft, oldSoft) end) end
    end
    return true
end
function L:GetThemeSnapshot() local out={}; for k,v in pairs(self.C) do out[k]=v end; return out end
function L:SetTransparency(value)
    value=math.clamp(tonumber(value) or 0,0,0.45); self.Config=self.Config or {}; self.Config.Transparency=value
    for _, win in ipairs(self._allWindows or {}) do if win and not win._destroyed then win:_ApplyTheme(nil, self.C) end end
    return value
end
function L:SetReducedMotion(enabled) self.Config=self.Config or {}; self.Config.ReducedMotion=enabled==true; return self.Config.ReducedMotion end
function L:GetReducedMotion() return self.Config and self.Config.ReducedMotion==true or false end


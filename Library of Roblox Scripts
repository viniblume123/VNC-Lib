function L:RegisterEffect(name,def)
    if type(name)~="string" or name:gsub("%s","")=="" or type(def)~="table" then return false,"effect name and definition required" end
    local copy=table.clone(def)
    copy.minS=math.floor(ClampNumber(copy.minS,4,1,500)); copy.maxS=math.floor(ClampNumber(copy.maxS,copy.minS,1,500))
    if copy.maxS<copy.minS then copy.minS,copy.maxS=copy.maxS,copy.minS end
    copy.dur=ClampNumber(copy.dur,1,0.05,30)
    if copy.color~=nil and typeof(copy.color)~="Color3" then return false,"effect color must be a Color3" end
    self.Effects.List[name]=copy
    return true
end
function L:RegisterEffectCategory(name,list)
    if type(name)~="string" or name:gsub("%s","")=="" or type(list)~="table" then return false,"category name and effect list required" end
    local categories={}; for _,effectName in ipairs(list) do if type(effectName)=="string" and self.Effects.List[effectName] then table.insert(categories,effectName) end end
    self.Effects.Categories=self.Effects.Categories or {}; self.Effects.Categories[name]=categories
    return true
end
function L:RemoveEffect(name)
    if not self.Effects.List[name] then return false end
    self.Effects.List[name]=nil
    for _,category in pairs(self.Effects.Categories or {}) do for i=#category,1,-1 do if category[i]==name then table.remove(category,i) end end end
    return true
end
function L:RegisterTransition(name,def)
    if type(name)~="string" or name:gsub("%s","")=="" or type(def)~="table" then return false,"transition name and definition required" end
    local copy=table.clone(def); copy.dur=ClampNumber(copy.dur,0.4,0.05,30)
    if copy.offset~=nil and typeof(copy.offset)~="UDim2" then return false,"transition offset must be UDim2" end
    if copy.scale~=nil and typeof(copy.scale)~="UDim2" then return false,"transition scale must be UDim2" end
    if copy.rotation~=nil and not tonumber(copy.rotation) then return false,"transition rotation must be numeric" end
    copy.rotation=ClampNumber(copy.rotation,0,-3600,3600)
    if copy.style~=nil and (typeof(copy.style)~="EnumItem" or copy.style.EnumType~=Enum.EasingStyle) then return false,"transition style must be an EasingStyle" end
    if copy.dir~=nil and (typeof(copy.dir)~="EnumItem" or copy.dir.EnumType~=Enum.EasingDirection) then return false,"transition direction must be an EasingDirection" end
    self.Transitions.List[name]=copy
    return true
end
function L:RemoveTransition(name)
    if not self.Transitions.List[name] then return false end
    self.Transitions.List[name]=nil
    return true
end


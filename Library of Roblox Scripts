local function ClonePalette(source)
    local out = {}
    for k, v in pairs(source or {}) do out[k] = v end
    return out
end

local function ReplacePaletteInPlace(target, source)
    for key in pairs(target) do if source[key] == nil then target[key] = nil end end
    for key, value in pairs(source) do target[key] = value end
    return target
end

local function NormalizePalette(p)
    local out = ClonePalette(p)
    local function lift(c, minimum)
        if typeof(c) ~= "Color3" then return c end
        local h, sat, val = c:ToHSV()
        if val < minimum then val = minimum end
        return Color3.fromHSV(h, sat, val)
    end
    out.Bg = lift(out.Bg, 0.14)
    out.Surface = lift(out.Surface, 0.19)
    out.Card = lift(out.Card, 0.24)
    out.CardHover = lift(out.CardHover, 0.30)
    out.CardActive = lift(out.CardActive, 0.27)
    out.Stroke = lift(out.Stroke, 0.28)

    local function linearChannel(value)
        if value <= 0.04045 then return value / 12.92 end
        return ((value + 0.055) / 1.055) ^ 2.4
    end
    local function luminance(color)
        return 0.2126 * linearChannel(color.R) + 0.7152 * linearChannel(color.G) + 0.0722 * linearChannel(color.B)
    end
    local backgrounds = {out.Bg, out.Surface, out.Card, out.CardHover, out.CardActive}
    local function contrast(a, b)
        local high, low = math.max(luminance(a), luminance(b)), math.min(luminance(a), luminance(b))
        return (high + 0.05) / (low + 0.05)
    end
    local function minimumContrast(color)
        local minimum = math.huge
        for _, background in ipairs(backgrounds) do
            if typeof(background) == "Color3" then minimum = math.min(minimum, contrast(color, background)) end
        end
        return minimum
    end
    local function ensureContrast(color, required)
        if typeof(color) ~= "Color3" or minimumContrast(color) >= required then return color end
        local black, white = Color3.new(0, 0, 0), Color3.new(1, 1, 1)
        local target = minimumContrast(black) >= minimumContrast(white) and black or white
        local low, high = 0, 1
        for _ = 1, 16 do
            local amount = (low + high) * 0.5
            if minimumContrast(color:Lerp(target, amount)) >= required then high = amount else low = amount end
        end
        return color:Lerp(target, high)
    end
    out.Text = ensureContrast(out.Text, 4.5)
    out.TextDim = ensureContrast(out.TextDim, 4.5)
    out.TextFaint = ensureContrast(out.TextFaint, 4.5)
    return out
end

function L:SetTheme(name)
    local palette = self.Palettes[name]
    if not palette then return false end
    local old = ClonePalette(self.C)
    self.Theme = name
    ReplacePaletteInPlace(self.C, NormalizePalette(palette))
    self._themeNormalized = true
    self.ThemeAnimated = false
    self.ThemeBase = name
    self.ThemeHue = 0
    for _, win in ipairs(self._allWindows or {}) do if win and not win._destroyed then win:_ApplyTheme(old, self.C) end end
    return true
end

function L:SetTimeBasedTheme(enabled,cfg)
    if enabled==false then self._timeTheme=nil; return false end
    cfg=cfg or {}
    local day=cfg.DayTheme or "Light"; local night=cfg.NightTheme or "Dark"
    if not self.Palettes[day] or not self.Palettes[night] then return false end
    self._timeTheme={DayTheme=day,NightTheme=night,DayStart=math.clamp(tonumber(cfg.DayStart) or 7,0,23),NightStart=math.clamp(tonumber(cfg.NightStart) or 19,0,23)}
    local hour=tonumber(os.date("%H")) or 12
    local target=(hour>=self._timeTheme.DayStart and hour<self._timeTheme.NightStart) and day or night
    if self.Theme~=target then self:SetTheme(target) end
    return true
end


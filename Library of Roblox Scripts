    TabsHolder.Position = UDim2.new(0,4,0,4)
    TabsHolder.BackgroundTransparency = 1
    TabsHolder.BorderSizePixel = 0
    TabsHolder.ScrollBarThickness = 0
    TabsHolder.CanvasSize = UDim2.new(0,0,0,0)
    TabsHolder.AutomaticCanvasSize = Enum.AutomaticSize.Y
    TabsHolder.Parent = Sidebar
    local Tl = Instance.new("UIListLayout")
    Tl.Padding = UDim.new(0,4)
    Tl.SortOrder = Enum.SortOrder.LayoutOrder
    Tl.Parent = TabsHolder
    local Tp = Instance.new("UIPadding")
    Tp.PaddingTop = UDim.new(0,6)
    Tp.PaddingLeft = UDim.new(0,6)
    Tp.PaddingRight = UDim.new(0,6)
    Tp.Parent = TabsHolder
    local Content = Instance.new("Frame")
    Content.Size = UDim2.new(1,-(cfg.TabWidth or 170)-20,1,-88)
    Content.Position = UDim2.new(0,(cfg.TabWidth or 170)+16,0,58)
    Content.BackgroundTransparency = 1
    Content.Parent = Main
    local StatusBar = Instance.new("Frame")
    StatusBar.Size = UDim2.new(1,-24,0,20)
    StatusBar.Position = UDim2.new(0,12,1,-28)
    StatusBar.BackgroundTransparency = 1
    StatusBar.Parent = Main
    local StatusL = Instance.new("TextLabel")
    StatusL.Size = UDim2.new(0.6,0,1,0)
    StatusL.BackgroundTransparency = 1
    StatusL.Text = "User: "..LP.Name.." - "..EXEC
    StatusL.Font = Enum.Font.Gotham
    StatusL.TextSize = 10
    StatusL.TextColor3 = C.TextFaint
    StatusL.TextXAlignment = Enum.TextXAlignment.Left
    StatusL.Parent = StatusBar
    local StatusR = Instance.new("TextLabel")
    StatusR.Size = UDim2.new(0.4,0,1,0)
    StatusR.Position = UDim2.new(0.6,0,0,0)
    StatusR.BackgroundTransparency = 1
    StatusR.Text = IS_MOBILE and "Mobile" or "RightControl"
    StatusR.Font = Enum.Font.Gotham
    StatusR.TextSize = 10
    StatusR.TextColor3 = C.TextFaint
    StatusR.TextXAlignment = Enum.TextXAlignment.Right
    StatusR.Parent = StatusBar
    local Win = setmetatable({
        _lib=self, _gui=sg, _main=Main, _sidebar=Sidebar, _tabsHolder=TabsHolder,
        _content=Content, _tabs={}, _active=nil, _cfg=cfg, _mode=savedMode,
        _sizes=sizes, _uiscale=UIScaleObj, _gradient=Grad,
        _header=Header, _logo=Logo, _title=Title, _sub=Sub,
        _statusBar=StatusBar, _statusL=StatusL, _statusR=StatusR,
        _accentStrip=AccentStrip, _winFile=WinFile, _modeFile=modeFile,
        _allElements={}
    }, {__index=L})
    Win.C = C
    function Win:_ApplyTheme()
        local c = self._lib.C
        self._main.BackgroundColor3 = c.Bg
        self._gradient.Color = ColorSequence.new(c.Bg, c.Surface)
        self._sidebar.BackgroundColor3 = c.Surface
        self._title.TextColor3 = c.Text
        self._sub.TextColor3 = c.TextFaint
        self._accentStrip.BackgroundColor3 = c.Accent
        self._logo.BackgroundColor3 = c.Accent
        self._statusL.TextColor3 = c.TextFaint
        self._statusR.TextColor3 = c.TextFaint
    end
    function Win:_ApplyAccent()
        local c = self._lib.C
        self._accentStrip.BackgroundColor3 = c.Accent
        self._logo.BackgroundColor3 = c.Accent
    end
    function Win:_ApplyFont()
        local f, fb, fm = self._lib.CurrentFont, self._lib.CurrentFontBold, self._lib.CurrentFontMedium
        self._title.Font = Enum.Font[fb]
        self._sub.Font = Enum.Font[f]
        self._statusL.Font = Enum.Font[f]
        self._statusR.Font = Enum.Font[f]
        for _, t in ipairs(self._tabs) do
            t._btnLabel.Font = Enum.Font[fm]
            for _, s in ipairs(t._sections) do
                s._headerLabel.Font = Enum.Font[fb]
            end
        end
    end
    function Win:_ApplyUIScale()
        self._uiscale.Scale = self._lib:GetUIScale("window")
    end
    function Win:_RefreshIcons()
        for _, t in ipairs(self._tabs) do
            if t._icon and t._iconName then
                t._icon.Image = self._lib.Icons[t._iconName] or t._icon.Image
            end
        end
    end
    function Win:SetMode(mode)
        if not self._sizes[mode] then return end
        self._mode = mode
        JsonWrite(self._modeFile, {mode=mode})
        TweenService:Create(self._main, T_INFO, {Size=GetSize(mode)}):Play()
    end
    BtnCompact.MouseButton1Click:Connect(function() self:PlaySound("click"); Win:SetMode("compact") end)
    BtnNormal.MouseButton1Click:Connect(function() self:PlaySound("click"); Win:SetMode("normal") end)
    BtnWide.MouseButton1Click:Connect(function() self:PlaySound("click"); Win:SetMode("wide") end)
    BtnClose.MouseButton1Click:Connect(function()
        self:PlaySound("click")
        if cfg.OnClose then pcall(cfg.OnClose) end
        TweenService:Create(Main, T_INFO, {GroupTransparency=1}):Play()
        task.delay(0.35, function() sg:Destroy() end)
    end)
    local dragging, dragStart, startPos, moved = false, nil, nil, false
    DragArea.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            dragStart = i.Position
            startPos = Main.Position
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - dragStart
            if math.abs(d.X) > 4 or math.abs(d.Y) > 4 then moved = true end
            if moved then
                Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            if dragging and moved then
                dragging = false
                if cfg.SnapToEdge ~= false then SnapToEdge(Main, WinFile) end
            else
                dragging = false
            end
        end
    end)
    function Win:Toggle()
        self._hidden = not self._hidden
        local target = self._hidden and 1 or 0
        TweenService:Create(Main, T_INFO, {GroupTransparency=target}):Play()
        if not self._hidden then self._lib:PlaySound("open") end
    end
    function Win:SelectTab(t)
        if self._active == t then return end
        for _, tab in ipairs(self._tabs) do
            local sel = tab == t
            tab._frame.Visible = sel
            TweenService:Create(tab._btn, T_OUT, {
                BackgroundColor3 = sel and C.AccentSoft or C.Card,
                TextColor3 = sel and C.White or C.TextDim
            }):Play()
            if tab._icon then
                TweenService:Create(tab._icon, T_OUT, {ImageColor3 = sel and C.White or C.TextDim}):Play()
            end
        end
        self._active = t
        self._lib:PlaySound("click")
    end
    local toggleKeys = cfg.ToggleKeys or {Enum.KeyCode.RightControl}
    UIS.InputBegan:Connect(function(i, gp)
        if gp then return end
        for _, k in ipairs(toggleKeys) do
            if i.KeyCode == k then Win:Toggle() break end
        end
    end)
    TweenService:Create(Main, T_INFO, {GroupTransparency=0}):Play()
    self._window = Win
    self._allWindows = self._allWindows or {}
    table.insert(self._allWindows, Win)
    return Win
end

function L:CreateTab(name, icon)
    local Win = self._window
    if not Win then return end
    local C = Win.C
    local opts = {}
    if type(name) == "table" then
        opts = name
        icon = opts.Icon
        name = opts.Name or opts.Title or "Tab"
    end
    local Tab = setmetatable({
        _window=Win, _lib=self, _name=name, _sections={}, _elements={},
        _iconName=icon, C=C, _ownTheme=nil, _ownAccent=nil
    }, {__index=L})
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1,0,0,36)
    Btn.BackgroundColor3 = C.Card
    Btn.Text = ""
    Btn.AutoButtonColor = false
    Btn.BorderSizePixel = 0
    Btn.LayoutOrder = #Win._tabs + 1
    Btn.Parent = Win._tabsHolder
    local Bc = Instance.new("UICorner"); Bc.CornerRadius = UDim.new(0,8); Bc.Parent = Btn
    local Bs = Instance.new("UIStroke"); Bs.Color = C.Stroke; Bs.Thickness = 1; Bs.Transparency = 0.4; Bs.Parent = Btn
    local DragHandle = Instance.new("Frame")
    DragHandle.Size = UDim2.new(0,6,0.6,0)
    DragHandle.Position = UDim2.new(0,2,0.2,0)
    DragHandle.BackgroundColor3 = C.Stroke
    DragHandle.BackgroundTransparency = 1
    DragHandle.BorderSizePixel = 0
    DragHandle.Parent = Btn
    local Dhc = Instance.new("UICorner"); Dhc.CornerRadius = UDim.new(1,0); Dhc.Parent = DragHandle
    local iconImg
    if icon then
        local ib = Instance.new("Frame")
        ib.Size = UDim2.new(0,18,0,18)
        ib.Position = UDim2.new(0,12,0.5,-9)
        ib.BackgroundTransparency = 1
        ib.Parent = Btn
        iconImg = Instance.new("ImageLabel")
        iconImg.Size = UDim2.new(1,0,1,0)
        iconImg.BackgroundTransparency = 1
        iconImg.Image = self.Icons[icon] or icon
        iconImg.ImageColor3 = C.TextDim
        iconImg.Parent = ib
    end
    local Lb = Instance.new("TextLabel")
    Lb.Size = UDim2.new(1, icon and -42 or -22, 1, 0)
    Lb.Position = UDim2.new(0, icon and 38 or 16, 0, 0)
    Lb.BackgroundTransparency = 1
    Lb.Text = name
    Lb.Font = Enum.Font[self.CurrentFontMedium]
    Lb.TextSize = 12
    Lb.TextColor3 = C.TextDim
    Lb.TextXAlignment = Enum.TextXAlignment.Left
    Lb.Parent = Btn
    local Frame = Instance.new("ScrollingFrame")
    Frame.Size = UDim2.new(1,0,1,0)
    Frame.BackgroundTransparency = 1
    Frame.BorderSizePixel = 0
    Frame.ScrollBarThickness = 5
    Frame.ScrollBarImageColor3 = C.Accent
    Frame.CanvasSize = UDim2.new(0,0,0,0)
    Frame.AutomaticCanvasSize = Enum.AutomaticSize.Y
    Frame.Visible = false
    Frame.Parent = Win._content
    local Fl = Instance.new("UIListLayout")
    Fl.Padding = UDim.new(0,10)
    Fl.SortOrder = Enum.SortOrder.LayoutOrder
    Fl.Parent = Frame
    local Fp = Instance.new("UIPadding")
    Fp.PaddingTop = UDim.new(0,4)
    Fp.PaddingLeft = UDim.new(0,2)
    Fp.PaddingRight = UDim.new(0,4)
    Fp.PaddingBottom = UDim.new(0,10)
    Fp.Parent = Frame
    Btn.MouseButton1Click:Connect(function()
        if Btn:GetAttribute("__Dragging") then return end
        Win:SelectTab(Tab)
        if Tab._onClick then Tab._onClick() end
    end)
    Btn.MouseEnter:Connect(function()
        if Win._active == Tab then return end
        TweenService:Create(Btn, T_OUT, {BackgroundColor3=C.CardHover}):Play()
        TweenService:Create(Bs, T_OUT, {Color=C.StrokeHot}):Play()
        TweenService:Create(DragHandle, T_OUT, {BackgroundTransparency=0.5}):Play()
    end)
    Btn.MouseLeave:Connect(function()
        if Win._active == Tab then return end
        TweenService:Create(Btn, T_OUT, {BackgroundColor3=C.Card}):Play()
        TweenService:Create(Bs, T_OUT, {Color=C.Stroke}):Play()
        TweenService:Create(DragHandle, T_OUT, {BackgroundTransparency=1}):Play()
    end)
    do
        local dragging, dragStart, startY, dragged = false, nil, nil, false
        Btn.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                if i.Position.X - Btn.AbsolutePosition.X < 10 then
                    dragging = true
                    dragged = false
                    Btn:SetAttribute("__Dragging", true)
                    dragStart = i.Position.Y
                    startY = Btn.Position.Y.Offset
                end
            end
        end)
        UIS.InputChanged:Connect(function(i)
            if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                local d = i.Position.Y - dragStart
                if math.abs(d) > 4 then dragged = true end
                if dragged then
                    Btn.Position = UDim2.new(0, 0, 0, startY + d)
                    Btn.ZIndex = 50
                end
            end
        end)
        UIS.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                if dragging then
                    dragging = false
                    Btn.Position = UDim2.new(0,0,0,0)
                    Btn.ZIndex = 1
                    task.delay(0.15, function() Btn:SetAttribute("__Dragging", false) end)
                    if dragged then
                        local myY = Btn.AbsolutePosition.Y
                        local target = nil
                        for _, t in ipairs(Win._tabs) do
                            if t ~= Tab then
                                local y = t._btn.AbsolutePosition.Y
                                if myY < y + t._btn.AbsoluteSize.Y/2 then
                                    target = t
                                    break
                                end
                            end
                        end
                        local oldIdx = table.find(Win._tabs, Tab)
                        table.remove(Win._tabs, oldIdx)
                        local newIdx = target and (table.find(Win._tabs, target) or (#Win._tabs+1)) or (#Win._tabs+1)
                        table.insert(Win._tabs, newIdx, Tab)
                        for idx, t in ipairs(Win._tabs) do t._btn.LayoutOrder = idx end
                    end
                end
            end
        end)
    end
    Tab._btn = Btn
    Tab._btnLabel = Lb
    Tab._frame = Frame
    Tab._icon = iconImg
    Tab._layout = Fl
    Tab._stroke = Bs
    Tab._dragHandle = DragHandle
    function Tab:SetAccent(color)
        self._ownAccent = color
        self._frame.ScrollBarImageColor3 = color
        if self._icon then self._icon.ImageColor3 = color end
    end
    function Tab:SetTheme(themeName)
        if self._lib.Palettes[themeName] then self._ownTheme = self._lib.Palettes[themeName] end
    end
    function Tab:SetName(n) self._name = n; Lb.Text = n end
    function Tab:Destroy()
        table.remove(Win._tabs, table.find(Win._tabs, Tab))
        Btn:Destroy()
        Frame:Destroy()
    end
    table.insert(Win._tabs, Tab)
    if #Win._tabs == 1 then Win:SelectTab(Tab) end
    return Tab
end

function L:CreateSection(name)
    local Tab = self
    local Win = Tab._window
    local C = Win.C
    local opts = {}
    if type(name) == "table" then opts = name; name = opts.Name or opts.Title or "Section" end
    local collapsible = opts.Collapsible ~= false
    local defaultCollapsed = opts.Collapsed or false
    local Sec = setmetatable({
        _tab=Tab, _lib=Tab._lib, _name=name, _elements={}, C=C,
        _collapsed=defaultCollapsed, _collapsible=collapsible
    }, {__index=L})
    local Holder = Instance.new("Frame")
    Holder.Size = UDim2.new(1,0,0,0)
    Holder.AutomaticSize = Enum.AutomaticSize.Y
    Holder.BackgroundTransparency = 1

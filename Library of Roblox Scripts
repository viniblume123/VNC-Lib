local NotifyGui, NotifyContainer
function Athic:Notify(cfg)
    cfg = type(cfg) == "table" and cfg or {}
    if not NotifyGui or not NotifyGui.Parent then
        NotifyGui = New("ScreenGui", {Name="AthicNotify", ResetOnSpawn=false, DisplayOrder=1000003, IgnoreGuiInset=true, Parent=getHui()})
        if PROT then pcall(PROT, NotifyGui) end
        NotifyContainer = New("Frame", {Size=UDim2.new(0,320,0,500), Position=UDim2.new(1,-340,0,20), BackgroundTransparency=1, Parent=NotifyGui})
        New("UIListLayout", {Padding=UDim.new(0,8), SortOrder=Enum.SortOrder.LayoutOrder, Parent=NotifyContainer})
    end
    local C = Theme.Get()
    local kind = cfg.Type or "info"
    local col = kind == "success" and C.Success or kind == "error" and C.Danger or kind == "warning" and C.Warning or C.Info
    local card = New("Frame", {Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y, BackgroundColor3=C.Surface, BorderSizePixel=0, Parent=NotifyContainer})
    Corner(card, 10); Stroke(card, col, 0.4)
    New("Frame", {Size=UDim2.new(0,3,1,-12), Position=UDim2.fromOffset(6,6), BackgroundColor3=col, BorderSizePixel=0, Parent=card})
    New("UIPadding", {PaddingTop=UDim.new(0,12), PaddingBottom=UDim.new(0,12), PaddingLeft=UDim.new(0,18), PaddingRight=UDim.new(0,32), Parent=card})
    New("TextLabel", {Size=UDim2.new(1,0,0,16), BackgroundTransparency=1, Text=cfg.Title or "Notificação", Font=Enum.Font.GothamBold, TextSize=12, TextColor3=C.Text, TextXAlignment=Enum.TextXAlignment.Left, Parent=card})
    New("TextLabel", {Size=UDim2.new(1,0,0,0), Position=UDim2.fromOffset(0,18), AutomaticSize=Enum.AutomaticSize.Y, BackgroundTransparency=1, Text=cfg.Text or "", Font=Enum.Font.Gotham, TextSize=10, TextColor3=C.TextDim, TextXAlignment=Enum.TextXAlignment.Left, TextWrapped=true, Parent=card})
    card.Position = UDim2.new(1,30,0,0)
    TweenService:Create(card, T_BACK, {Position=UDim2.new(0,0,0,0)}):Play()
    task.delay(cfg.Duration or 4, function()
        TweenService:Create(card, T_INFO, {Position=UDim2.new(1,30,0,0)}):Play()
        task.delay(0.35, function() card:Destroy() end)
    end)
    return card
end


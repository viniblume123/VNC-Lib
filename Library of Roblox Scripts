        self:PlaySound("click")
        local key = InputB.Text
        if key == "" then
            SL.Text = "Digite uma key"
            SL.TextColor3 = C.Danger
            return
        end
        local ok = false
        local reason = ""
        if cfg.UseHubKey then
            ok = true
        elseif cfg.RemoteValidate then
            SL.Text = "Validando..."
            SL.TextColor3 = C.Warning
            local body = HS:JSONEncode({key=key, hwid=hashedHwid, userId=LP.UserId, userName=LP.Name, executor=self.Executor, script=cfg.ScriptId or "library"})
            local url = cfg.RemoteValidate .. "?key=" .. HS:UrlEncode(key) .. "&hwid=" .. HS:UrlEncode(hashedHwid)
            local resBody = HttpPost(url, body)
            if resBody then
                local ok2, parsed = pcall(HS.JSONDecode, HS, resBody)
                if ok2 and type(parsed) == "table" then
                    ok = parsed.valid == true or parsed.success == true
                    reason = parsed.reason or parsed.error or ""
                end
            end
        elseif cfg.Validate then
            local succ, res = pcall(cfg.Validate, key, hashedHwid)
            ok = succ and res
        else
            ok = key ~= ""
        end
        if cfg.Webhook and cfg.Webhook.Enabled then
            task.spawn(function() self.Webhook:LogKeyAttempt(cfg.Webhook.Url, key, hashedHwid, ok) end)
        end
        if ok then
            JsonWrite(file, {key=key, hwid=hashedHwid})
            SL.Text = "Key validada!"
            SL.TextColor3 = C.Success
            self:PlaySound("success")
            task.delay(0.5, function()
                if gui then gui:Destroy() end
                done = true
                success = true
            end)
        else
            SL.Text = reason ~= "" and ("Invalida: "..reason) or "Key invalida"
            SL.TextColor3 = C.Danger
            self:PlaySound("error")
        end
    end)
    while not done do task.wait(0.1) end
    return success
end

local function SnapToEdge(Frame, File)
    local cam = workspace.CurrentCamera
    if not cam then return end
    local vp = cam.ViewportSize
    local pos = Frame.AbsolutePosition
    local sz = Frame.AbsoluteSize
    local th = 30
    local nx, ny = Frame.Position.X.Offset, Frame.Position.Y.Offset
    if pos.X < th then nx = nx + (th - pos.X) + 8
    elseif pos.X + sz.X > vp.X - th then nx = nx - ((pos.X + sz.X) - (vp.X - th)) - 8 end
    if pos.Y < th then ny = ny + (th - pos.Y) + 8
    elseif pos.Y + sz.Y > vp.Y - th then ny = ny - ((pos.Y + sz.Y) - (vp.Y - th)) - 8 end
    Frame.Position = UDim2.new(Frame.Position.X.Scale, nx, Frame.Position.Y.Scale, ny)
    if File then JsonWrite(File, {xs=Frame.Position.X.Scale, x=nx, ys=Frame.Position.Y.Scale, y=ny}) end
end


        local preview = New("TextButton", {Size=UDim2.fromOffset(52,26), Position=UDim2.new(1,-66,0.5,-13), BackgroundColor3=color, Text="", AutoButtonColor=false, BorderSizePixel=0, Parent=wrap})
        Corner(preview, 6)
        local h, sat, val = color:ToHSV()
        local function hexFrom(c) return string.format("#%02X%02X%02X", math.floor(c.R*255+0.5), math.floor(c.G*255+0.5), math.floor(c.B*255+0.5)) end
        preview.MouseButton1Click:Connect(function()
            -- cycle through some predef colors as simple picker
            local palette = {Color3.fromRGB(255,80,80), Color3.fromRGB(80,255,120), Color3.fromRGB(80,150,255), Color3.fromRGB(255,200,80), Color3.fromRGB(200,100,255), Color3.fromRGB(255,255,255)}
            local idx = 1
            for i, c in ipairs(palette) do if c == color then idx = i % #palette + 1; break end end
            color = palette[idx]
            preview.BackgroundColor3 = color
            if type(cfg.OnChanged) == "function" then pcall(cfg.OnChanged, color) end
        end)
        if cfg.Flag then State.Register(cfg.Flag, function() return hexFrom(color) end, function(v) local c = Color3.fromHex(v); if c then color = c; preview.BackgroundColor3 = c end end) end

--============================================================
-- CONFIG PANEL (aba de sistema)
--============================================================
function Athic:CreateConfigPanel(parent)
    local C = Theme.Get()
    local sec = parent:CreateSection({Name="Gerenciador de Config"})
    local nameInput = sec:CreateInput({Name="Nome da config", Placeholder="minha_config"})
    local configs = Config.List()
    local selected = configs[1]
    local dropdown = sec:CreateDropdown({Name="Config selecionada", Options=#configs > 0 and configs or {"(vazio)"}, Default=selected, OnChanged=function(v) selected = v end})
    
    sec:CreateButton({Name="➕ Criar", OnClick=function()
        local n = nameInput:Get()
        if n and n ~= "" then
            Config.Save(n)
            Athic:Notify({Title="Config criada", Text=n, Type="success"})
            dropdown:SetOptions(Config.List())
        end
    end})
    sec:CreateButton({Name="📂 Carregar", OnClick=function()
        if selected then
            local ok = Config.Load(selected)
            Athic:Notify({Title=ok and "Carregada" or "Falhou", Text=selected, Type=ok and "success" or "error"})
        end
    end})
    sec:CreateButton({Name="💾 Salvar (overwrite)", OnClick=function()
        if selected then Config.Save(selected); Athic:Notify({Title="Salvo", Text=selected, Type="success"}) end
    end})
    sec:CreateButton({Name="🗑 Excluir", OnClick=function()
        if selected then
            Config.Delete(selected)
            Athic:Notify({Title="Excluída", Text=selected, Type="warning"})
            local l = Config.List()
            dropdown:SetOptions(#l > 0 and l or {"(vazio)"})
        end
    end})
    sec:CreateToggle({Name="Auto-load ao iniciar", Flag="autoload_toggle", Default=Config.GetAutoLoad() == selected, OnChanged=function(v)
        if v then Config.SetAutoLoad(selected) end
    end})
    return {Instance=sec._inner}
end


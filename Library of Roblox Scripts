            return
        end
        local ok = false
        local reason = ""
        if cfg.UseHubKey then
            ok = true
        elseif cfg.RemoteValidate then
            SL.Text = "Validando..."
            SL.TextColor3 = C.Warning
            local body = HS:JSONEncode({key=key, hwid=hashedHwid, userId=LP.UserId, userName=LP.Name, executor=self.Executor, script=cfg.ScriptId or "library"})
            local url = cfg.RemoteValidate .. "?key=" .. HS:UrlEncode(key) .. "&hwid=" .. HS:UrlEncode(hashedHwid)
            local resBody = HttpPost(url, body)
            if resBody then
                local ok2, parsed = pcall(HS.JSONDecode, HS, resBody)
                if ok2 and type(parsed) == "table" then
                    ok = parsed.valid == true or parsed.success == true
                    reason = parsed.reason or parsed.error or ""
                end
            end
        elseif cfg.Validate then
            local succ, res = pcall(cfg.Validate, key, hashedHwid)
            ok = succ and res
        else
            ok = key ~= ""
        end
        if cfg.Webhook and cfg.Webhook.Enabled then
            task.spawn(function() self.Webhook:LogKeyAttempt(cfg.Webhook.Url, key, hashedHwid, ok) end)
        end
        if ok then
            JsonWrite(file, {key=key, hwid=hashedHwid})
            SL.Text = "Key validada!"
            SL.TextColor3 = C.Success
            self:PlaySound("success")
            task.delay(0.5, function()
                if gui then gui:Destroy() end
                done = true
                success = true
            end)
        else
            SL.Text = reason ~= "" and ("Invalida: "..reason) or "Key invalida"
            SL.TextColor3 = C.Danger
            self:PlaySound("error")
        end
    end)
    while not done do task.wait(0.1) end
    return success
end

local function SnapToEdge(Frame, File)
    local cam = workspace.CurrentCamera
    if not cam then return end
    local vp = cam.ViewportSize
    local pos = Frame.AbsolutePosition
    local sz = Frame.AbsoluteSize
    local th = 30
    local nx, ny = Frame.Position.X.Offset, Frame.Position.Y.Offset
    if pos.X < th then nx = nx + (th - pos.X) + 8
    elseif pos.X + sz.X > vp.X - th then nx = nx - ((pos.X + sz.X) - (vp.X - th)) - 8 end
    if pos.Y < th then ny = ny + (th - pos.Y) + 8
    elseif pos.Y + sz.Y > vp.Y - th then ny = ny - ((pos.Y + sz.Y) - (vp.Y - th)) - 8 end
    Frame.Position = UDim2.new(Frame.Position.X.Scale, nx, Frame.Position.Y.Scale, ny)
    if File then JsonWrite(File, {xs=Frame.Position.X.Scale, x=nx, ys=Frame.Position.Y.Scale, y=ny}) end
end

function L:CreateWindow(cfg)
    cfg = cfg or {}
    if cfg.Splash then
        self:ShowSplash(cfg.Splash)
        task.wait(cfg.Splash.Duration or 2)
    end
    if cfg.Theme and self.Palettes[cfg.Theme] then self:SetTheme(cfg.Theme) end
    if cfg.AnimatedTheme then self:SetAnimatedTheme(cfg.AnimatedTheme) end
    if cfg.CustomTheme then self:SetCustomTheme(cfg.CustomTheme) end
    if cfg.Sounds then self:SetSounds(cfg.Sounds) end
    if cfg.Font then self:SetFont(cfg.Font, cfg.FontBold, cfg.FontMedium) end
    if cfg.Key then self:SetKeySystem(cfg.Key) end
    if cfg.Blocklist then
        self:SetBlocklist(cfg.Blocklist)
        if not self.Blocklist:RunCheck() then return end
    end
    if cfg.AskPlatform ~= false then self:_SetupPlatform() end
    if cfg.Key and cfg.Key.Enabled then
        if not self:_RunKeyFlow() then return end
    end
    local C = self.C
    local WinFile = "library_window.json"
    local savedPos = JsonRead(WinFile, nil)
    local modeFile = "library_mode.json"
    local savedMode = JsonRead(modeFile, {mode="normal"}).mode or "normal"
    local sizes = {
        compact = {w = cfg.CompactWidth or 480, h = cfg.CompactHeight or 320},
        normal = {w = cfg.Width or 620, h = cfg.Height or 420},
        wide = {w = cfg.WideWidth or 840, h = cfg.WideHeight or 480}
    }
    local function GetSize(m)
        local s = sizes[m] or sizes.normal
        return UDim2.new(0, s.w, 0, s.h)
    end
    local sg = Instance.new("ScreenGui")
    sg.Name = "LibraryUI_"..tostring(math.random(1,999999))
    sg.ResetOnSpawn = false
    sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    sg.DisplayOrder = 999996
    sg.IgnoreGuiInset = true
    if PROT then pcall(PROT, sg) end
    sg.Parent = GetHui()
    local UIScaleObj = Instance.new("UIScale")
    UIScaleObj.Scale = self:GetUIScale("window")
    UIScaleObj.Parent = sg
    local Main = Instance.new("CanvasGroup")
    Main.Name = "Main"
    Main.Size = GetSize(savedMode)
    if savedPos then
        Main.Position = UDim2.new(savedPos.xs or 0.5, savedPos.x or -300, savedPos.ys or 0.5, savedPos.y or -200)
    else
        Main.Position = UDim2.new(0.5, -sizes[savedMode].w/2, 0.5, -sizes[savedMode].h/2)
    end
    Main.BackgroundColor3 = C.Bg
    Main.GroupTransparency = 1
    Main.BorderSizePixel = 0
    Main.Parent = sg
    local Mc = Instance.new("UICorner"); Mc.CornerRadius = UDim.new(0,18); Mc.Parent = Main
    local Ms = Instance.new("UIStroke"); Ms.Color = C.Stroke; Ms.Thickness = 1; Ms.Transparency = 0.4; Ms.Parent = Main
    local Grad = Instance.new("UIGradient")

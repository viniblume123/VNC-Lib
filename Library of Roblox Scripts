function L:SetFont(font, bold, medium)
    if self._destroyed then return false,"library is destroyed" end
    local function valid(name)
        if type(name) ~= "string" then return false end
        local ok, value = pcall(function() return Enum.Font[name] end)
        return ok and value ~= nil
    end
    font = valid(font) and font or "Gotham"
    bold = valid(bold) and bold or (valid(font.."Bold") and font.."Bold" or font)
    medium = valid(medium) and medium or (valid(font.."Medium") and font.."Medium" or font)
    self.CurrentFont=font; self.CurrentFontBold=bold; self.CurrentFontMedium=medium
    for _, win in ipairs(self._allWindows or {}) do if win and not win._destroyed then win:_ApplyFont() end end
    self:Emit("FontChanged",font,bold,medium)
end


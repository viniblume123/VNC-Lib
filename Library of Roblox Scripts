end
function L:SearchSounds(query, category, favoritesOnly)
    local out={}; local q=tostring(query or ""):lower()
    local library=type(self.Sounds.library)=="table" and self.Sounds.library or {}
    for name,sound in pairs(library) do
        if type(name)=="string" and type(sound)=="table" then
            local match=(q=="" or name:lower():find(q,1,true) or tostring(sound.Id):lower():find(q,1,true) or tostring(sound.Category):lower():find(q,1,true))

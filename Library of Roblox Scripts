    function Win:_ApplyTransparency()
        local transparency=math.clamp(tonumber(self._lib.Config.Transparency) or 0,0,0.45)
        self._main.BackgroundTransparency=transparency
        for _,obj in ipairs(self._main:GetDescendants()) do
            if obj:IsA("GuiObject") then
                if obj:GetAttribute("__VNCBaseTransparency")==nil then obj:SetAttribute("__VNCBaseTransparency",obj.BackgroundTransparency) end
                local base=obj:GetAttribute("__VNCBaseTransparency")
                obj.BackgroundTransparency=math.clamp(base+transparency*(1-base),0,1)
            end
        end
    end
    function Win:_ApplyAccent(oldAccent, newAccent, newSoft, oldSoft)
        local c = self._lib.C
        oldAccent = oldAccent or c.Accent
        newAccent = newAccent or c.Accent
        newSoft = newSoft or c.AccentSoft
        for _, tab in ipairs(self._tabs) do
            if not tab._ownTheme then local fresh=ClonePalette(c); for key,value in pairs(fresh) do tab.C[key]=value end end
            if tab._ownAccent then tab.C.Accent=tab._ownAccent; tab.C.StrokeHot=tab._ownAccent; tab.C.AccentSoft=tab._ownAccent:Lerp(Color3.new(0,0,0),0.35) end
            for _, section in ipairs(tab._sections) do section.C=tab.C end
        end
        self._accentStrip.BackgroundColor3 = newAccent
        self._logo.BackgroundColor3 = newAccent
        if self._accentTargetsDirty or not self._accentTargets then
            local targets={}
            local ownThemeFrames={}
            for _,tab in ipairs(self._tabs) do if (tab._ownTheme or tab._ownAccent) and tab._frame then ownThemeFrames[tab._frame]=true end end
            local function hasOwnThemeAncestor(obj)
                local node=obj
                while node and node~=self._main do
                    if ownThemeFrames[node] then return true end
                    node=node.Parent
                end
                return false
            end
            local function add(obj,property,role)
                local value=obj[property]
                local matches=(role=="soft" and oldSoft and value==oldSoft) or (role=="accent" and value==oldAccent)
                if matches then
                    table.insert(targets,{Object=obj,Property=property,Role=role})
                end
            end
            local function scan(root,isWindowRoot)
                if not root or not root.Parent then return end
                for _,obj in ipairs(root:GetDescendants()) do
                    if not (isWindowRoot and hasOwnThemeAncestor(obj)) then
                        if obj:IsA("GuiObject") then add(obj,"BackgroundColor3","accent"); add(obj,"BackgroundColor3","soft") end
                        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then add(obj,"TextColor3","accent") end
                        if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then add(obj,"ImageColor3","accent") end
                        if obj:IsA("UIStroke") then add(obj,"Color","accent") end
                    end
                end
            end
            scan(self._main,true)
            for _,gui in ipairs(self._auxGuis or {}) do scan(gui,false) end
            self._accentTargets=targets
            self._accentTargetsDirty=false
        end
        local function targetStillOwned(object)
            if not object or not object.Parent then return false end
            if object:IsDescendantOf(self._main) then return true end
            for _,gui in ipairs(self._auxGuis or {}) do if gui and gui.Parent and object:IsDescendantOf(gui) then return true end end
            return false
        end
        for i=#self._accentTargets,1,-1 do
            local target=self._accentTargets[i]
            if not targetStillOwned(target.Object) then
                table.remove(self._accentTargets,i)
            else
                target.Object[target.Property]=target.Role=="soft" and newSoft or newAccent
            end
        end
    end

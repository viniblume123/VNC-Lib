        local uptime
        if type(cfg.GetServerUptime)=="function" then local ok,value=pcall(cfg.GetServerUptime); if ok then uptime=tonumber(value) end end
        if not uptime and cfg.ServerUptime~=nil then uptime=tonumber(cfg.ServerUptime) end

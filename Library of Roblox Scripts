function L:BindGlobal(name,key,callback,modifiers)
    if type(callback)~="function" then return nil end
    modifiers=type(modifiers)=="table" and table.clone(modifiers) or {}
    local binding={Key=key,Modifiers=modifiers}
    local conn=UIS.InputBegan:Connect(function(input,processed)
        if processed or UIS:GetFocusedTextBox() then return end
        if input.KeyCode~=binding.Key then return end
        local control=UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl)
        local shift=UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.RightShift)
        local alt=UIS:IsKeyDown(Enum.KeyCode.LeftAlt) or UIS:IsKeyDown(Enum.KeyCode.RightAlt)
        if control==(binding.Modifiers.Control==true) and shift==(binding.Modifiers.Shift==true) and alt==(binding.Modifiers.Alt==true) then InvokeUserCallback(callback,input,binding.Modifiers) end
    end)
    table.insert(self._connections,conn)
    self._globalBindings=self._globalBindings or {}
    local handle={Name=tostring(name or ""),Connection=conn,_lib=self}
    table.insert(self._globalBindings,handle)
    function handle:Set(newKey,newModifiers) binding.Key=newKey; binding.Modifiers=type(newModifiers)=="table" and table.clone(newModifiers) or {}; self.Key=binding.Key; self.Modifiers=binding.Modifiers; end
    handle.Key,handle.Modifiers=key,modifiers
    function handle:Destroy()
        if self.Connection then self.Connection:Disconnect(); self.Connection=nil end
        local list=self._lib and self._lib._globalBindings
        local index=list and table.find(list,self)
        if index then table.remove(list,index) end
        return true
    end
    return handle
end
function L:UnbindGlobal(name)
    local list=self._globalBindings or {}; local removed=0
    for index=#list,1,-1 do
        local binding=list[index]
        if tostring(binding.Name)==tostring(name) then binding:Destroy(); removed+=1 end
    end
    return removed>0,removed
end


    function Win:Destroy()
        if self._destroyed then return end
        self._destroyed=true
        if self._lib and self._lib._hubIdleState and self._lib._hubIdleState.hiddenWindows then self._lib._hubIdleState.hiddenWindows[self]=nil end
        if self._lib and self._lib.Macros then
            local anotherWindowOpen=false
            for _,window in ipairs(self._lib._allWindows or {}) do
                if window~=self and window and not window._destroyed then anotherWindowOpen=true; break end
            end
            if not anotherWindowOpen then pcall(function() self._lib:StopMacroPlayback() end) end
        end
        if self._particleHandle then pcall(function() self._particleHandle:Destroy() end) end
        if self._spotlightHandle then pcall(function() self._spotlightHandle:Destroy() end) end
        if self._logoAnimation then pcall(function() self._logoAnimation:Stop() end) end
        if cfg.OnClose then pcall(cfg.OnClose) end
        for _, gui in ipairs(table.clone(self._auxGuis or {})) do if gui and gui.Parent then pcall(function() gui:Destroy() end) end end
        self._auxGuis = {}
        if self._main and self._main.Parent then self._main.Parent:Destroy() end
        for i = #self._connections, 1, -1 do pcall(function() self._connections[i]:Disconnect() end); self._connections[i]=nil end
        local wins = self._lib._allWindows or {}
        local index = table.find(wins, self)
        if index then table.remove(wins, index) end
        if self._lib._window==self then
            self._lib._window=nil
            for i=#wins,1,-1 do if wins[i] and not wins[i]._destroyed then self._lib._window=wins[i]; break end end
        end
        table.clear(self._tabs or {})
        table.clear(self._allElements or {})
        table.clear(self._accentTargets or {})
        self._active=nil
    end
    Main.GroupTransparency = 0
    self._window=Win
    self._allWindows = self._allWindows or {}
    table.insert(self._allWindows, Win)
    if self.StreamerMode then self:SetStreamerMode(true) end
    if self._hubIdleState and self._hubIdleState.locked then
        self._hubIdleState.hiddenWindows[Win]={WasHidden=false,Interactable=Win._main.Interactable}
        Win._main.Interactable=false
        Win:Toggle()
    end
    return Win
end


function L.Crypto.Encrypt(plain, secret)
    local hash = L.Crypto.SHA256(secret or "lib_secret")
    local seed = tonumber(hash:sub(1, 8), 16) or 12345
    local out = {}
    for i = 1, #plain do
        local c = plain:byte(i)
        local k = (seed + i * 31) % 256
        table.insert(out, string.char(BitOp(c, k, "xor")))
    end
    local raw = table.concat(out)
    return Base64Encode(raw)
end

function L.Crypto.Decrypt(cipher, secret)
    local raw = Base64Decode(cipher)
    local hash = L.Crypto.SHA256(secret or "lib_secret")
    local seed = tonumber(hash:sub(1, 8), 16) or 12345
    local out = {}
    for i = 1, #raw do
        local c = raw:byte(i)
        local k = (seed + i * 31) % 256
        table.insert(out, string.char(BitOp(c, k, "xor")))
    end
    return table.concat(out)
end

function L.Crypto.Hash(text)
    return L.Crypto.SHA256(tostring(text))
end

function L.Crypto.Base64Encode(t) return Base64Encode(t) end
function L.Crypto.Base64Decode(t) return Base64Decode(t) end


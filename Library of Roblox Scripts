        local function append(value) chunks[#chunks+1]=value end
        local function colored(token,color) append('<font color="'..color..'">'..escapeRichText(token)..'</font>') end
        while i<=length do
            local two=source:sub(i,i+1); local char=source:sub(i,i)
            if two=="--" then
                local stop=source:find("\n",i,true) or (length+1); colored(source:sub(i,stop-1),"#7F9B83"); i=stop

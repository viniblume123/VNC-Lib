function Athic:CreatePlayerPanel(parent)
    local C = Theme.Get()
    local sec = parent:CreateSection({Name="Info do Servidor"})
    local infoLabel = sec:CreateLabel({Text="Carregando..."})
    local function update()
        local i = PlayerSvc.GetServerInfo()
        infoLabel:Set(string.format("👥 %d/%d · 📶 %d ms · 🆔 %s", i.Count, i.Max, i.Ping, string.sub(i.JobId, 1, 20).."..."))
    end
    update()
    task.spawn(function()
        while parent._win and parent._win._main and parent._win._main.Parent do
            task.wait(2)
            update()
        end
    end)
    
    local playersSec = sec._tab:CreateSection({Name="Jogadores no Server"})
    local playersFrame = New("Frame", {Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y, BackgroundTransparency=1})
    New("UIListLayout", {Padding=UDim.new(0,4), Parent=playersFrame})

local Storage = {Folder = "Athic"}
function Storage.Ensure(p)
    p = p or Storage.Folder
    if MFN and not (isfolder and isfolder(p)) then pcall(MFN, p) end
end
function Storage.Save(path, data)
    if not WF then return false, "no writefile" end
    local ok, enc = pcall(HttpService.JSONEncode, HttpService, data)
    if not ok then return false, enc end
    return pcall(WF, path, enc)
end
function Storage.Load(path, def)
    if not RF or not ISF then return def end
    local ok, ex = pcall(ISF, path)
    if not ok or not ex then return def end
    local rok, raw = pcall(RF, path)
    if not rok then return def end
    local dok, data = pcall(HttpService.JSONDecode, HttpService, raw)
    if dok and type(data) == "table" then return data end
    return def
end
function Storage.Delete(path)
    if not DF then return false end
    return pcall(DF, path)
end


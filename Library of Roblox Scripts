        local average=#samples>0 and math.floor(sum/#samples+0.5) or nil
        local uptime,uptimeKind=getUptime()
        local region=tostring(cfg.Region or "unavailable")
        label.Text=string.format("Players: %d/%d\nAverage ping: %s\nRegion: %s  ·  %s: %02d:%02d:%02d",playerCount,tonumber(Players.MaxPlayers) or 0,average and (average.." ms") or "unavailable",region,uptimeKind,math.floor(uptime/3600),math.floor(uptime/60)%60,math.floor(uptime)%60)
    end
    task.spawn(function() while active and root.Parent do update(); task.wait(interval) end end)
    local handle={Instance=root,Update=update,Get=function() local uptime,uptimeKind=getUptime(); return {PlayerCount=playerCount,MaxPlayers=tonumber(Players.MaxPlayers) or 0,AveragePing=#samples>0 and (function() local n=0; for _,v in ipairs(samples) do n+=v end; return n/#samples end)() or nil,Uptime=uptime,UptimeKind=uptimeKind,Region=cfg.Region} end}
    function handle:Destroy() active=false; if root.Parent then root:Destroy() end end
    return handle
end


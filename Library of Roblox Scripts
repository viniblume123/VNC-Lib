local Executor = {}
function Executor.Detect()
    if IDENT then local ok, r = pcall(IDENT); if ok and type(r) == "string" then return r end end
    local checks = {
        {test=function() return syn end, n="Synapse X"},
        {test=function() return KRNL_LOADED end, n="KRNL"},
        {test=function() return fluxus end, n="Fluxus"},
        {test=function() return secure_call end, n="SirHurt"},
    }
    for _, c in ipairs(checks) do if pcall(c.test) then return c.n end end
    return "Unknown"
end

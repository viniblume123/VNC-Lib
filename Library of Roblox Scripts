local DefaultSoundChannels={"Music","UI","Effects","Transitions","Ambient"}
local DefaultSoundSlots={"click","hover","success","error","open","close","key","notify"}
local DefaultSoundSlotValues={}
for _,slot in ipairs(DefaultSoundSlots) do DefaultSoundSlotValues[slot]=L.Sounds[slot] end
L.Sounds.favorites=JsonRead("library_sound_favorites.json",{})
if type(L.Sounds.favorites)~="table" then L.Sounds.favorites={} end

local savedSoundSlots=JsonRead("library_sound_slots.json",{})
if type(savedSoundSlots)=="table" then
    for _,slot in ipairs(DefaultSoundSlots) do
        if savedSoundSlots[slot]~=nil then L.Sounds[slot]=NormalizeSoundId(savedSoundSlots[slot]) or "" end
    end
end
local function GetSoundChannelNames(sounds)
    local names={}; local seen={}; local extras={}
    for _,name in ipairs(DefaultSoundChannels) do seen[name]=true; table.insert(names,name) end
    local channels=type(sounds)=="table" and type(sounds.channels)=="table" and sounds.channels or {}
    for name in pairs(channels) do
        if type(name)=="string" and name~="" and not seen[name] then seen[name]=true; table.insert(extras,name) end
    end
    table.sort(extras,function(a,b) return a:lower()<b:lower() end)
    for _,name in ipairs(extras) do table.insert(names,name) end
    return names
end

function L:SetSounds(cfg)
    if self._destroyed then return false,"library is destroyed" end
    cfg=type(cfg)=="table" and cfg or {}
    local aliases={Volume="volume",Enabled="enabled",Silent="silent",Channels="channels",Ducking="ducking",Favorites="favorites",History="history",Playlists="playlists",TransitionHooks="transitionHooks",Library="library"}
    for k,v in pairs(cfg) do
        if type(k)=="string" then
            local target=aliases[k]
            if not target then
                local lower=k:lower()
                if DefaultSoundSlotValues[lower]~=nil then target=lower else target=k end
            end
            if target~="channels" then self.Sounds[target]=v end
        end
    end
    self.Sounds.volume=ClampNumber(self.Sounds.volume,0.5,0,1)
    self.Sounds.enabled=self.Sounds.enabled~=false
    self.Sounds.silent=self.Sounds.silent==true
    self.Sounds.channels=type(self.Sounds.channels)=="table" and self.Sounds.channels or {}
    local configuredChannels=type(cfg.channels)=="table" and cfg.channels or cfg.Channels
    if type(configuredChannels)=="table" then
        for channel,value in pairs(configuredChannels) do
            if type(channel)=="string" and channel~="" then self.Sounds.channels[channel]=ClampNumber(value,self.Sounds.channels[channel] or 1,0,1) end
        end
    end
    for channel,value in pairs(self.Sounds.channels) do
        if type(channel)=="string" and channel~="" then self.Sounds.channels[channel]=ClampNumber(value,1,0,1) end
    end
    for _,channel in ipairs(DefaultSoundChannels) do self.Sounds.channels[channel]=ClampNumber(self.Sounds.channels[channel],1,0,1) end
    for _,slot in ipairs(DefaultSoundSlots) do
        local raw=self.Sounds[slot]
        if raw==nil or tostring(raw):match("^%s*$") then self.Sounds[slot]=""
        else self.Sounds[slot]=NormalizeSoundId(raw) or "" end
    end
    self.Sounds.favorites = type(self.Sounds.favorites)=="table" and self.Sounds.favorites or {}
    self.Sounds.history = type(self.Sounds.history)=="table" and self.Sounds.history or {}
    self.Sounds.playlists = type(self.Sounds.playlists)=="table" and self.Sounds.playlists or {}
    self.Sounds.transitionHooks = type(self.Sounds.transitionHooks)=="table" and self.Sounds.transitionHooks or {}
    self.Sounds.library=type(self.Sounds.library)=="table" and self.Sounds.library or {}
    if type(self.Sounds.ducking)=="boolean" then
        self.Sounds.ducking={enabled=self.Sounds.ducking,volume=.35,channels={UI=true}}
    elseif type(self.Sounds.ducking)~="table" then
        self.Sounds.ducking={enabled=false,volume=.35,channels={UI=true}}
    end
    if self.Sounds.ducking.enabled==nil then self.Sounds.ducking.enabled=self.Sounds.ducking.Enabled end
    if self.Sounds.ducking.volume==nil then self.Sounds.ducking.volume=self.Sounds.ducking.Volume end
    if self.Sounds.ducking.channels==nil then self.Sounds.ducking.channels=self.Sounds.ducking.Channels end
    self.Sounds.ducking.enabled=self.Sounds.ducking.enabled==true
    self.Sounds.ducking.volume=ClampNumber(self.Sounds.ducking.volume,.35,0,1)
    self.Sounds.ducking.channels=type(self.Sounds.ducking.channels)=="table" and self.Sounds.ducking.channels or {UI=true}
    local invalidSoundNames={}
    for name,entry in pairs(self.Sounds.library) do
        local normalized=type(entry)=="table" and NormalizeSoundId(entry.Id)
        if type(name)~="string" or type(entry)~="table" or not normalized then invalidSoundNames[#invalidSoundNames+1]=name
        else entry.Name=tostring(entry.Name or name); entry.Category=tostring(entry.Category or "General"); entry.Id=normalized end
    end
    for _,name in ipairs(invalidSoundNames) do self.Sounds.library[name]=nil end
    if self._UpdateSoundDucking then self:_UpdateSoundDucking() end
    self:Emit("SoundSettingsChanged",{
        Silent=self.Sounds.silent,Enabled=self.Sounds.enabled,Volume=self.Sounds.volume,
        Channels=table.clone(self.Sounds.channels),Ducking=self.Sounds.ducking.enabled
    })
    return true,self.Sounds
end

function L:SetSoundChannelVolume(channel, volume)
    if self._destroyed then return false,"library is destroyed" end
    if type(channel)~="string" or channel=="" then return false,"channel name required" end
    if type(self.Sounds.channels)~="table" then self.Sounds.channels={} end
    self.Sounds.channels[channel] = ClampNumber(volume,1,0,1)
    self:Emit("SoundSettingsChanged",{Silent=self.Sounds.silent,Enabled=self.Sounds.enabled,Volume=self.Sounds.volume,Channel=channel,ChannelVolume=self.Sounds.channels[channel]})
    return self.Sounds.channels[channel]
end

function L:_UpdateSoundDucking()
    local sounds=self._duckedSoundVolumes or {}
    local config=self.Sounds and self.Sounds.ducking or {}
    local factor=(config.enabled==true and (self._soundDuckCount or 0)>0) and ClampNumber(config.volume,.35,0,1) or 1
    for sound,baseVolume in pairs(sounds) do
        if sound and sound.Parent then
            pcall(function() TweenService:Create(sound,T_FAST,{Volume=ClampNumber(baseVolume,0,0,1)*factor}):Play() end)
        else
            sounds[sound]=nil
        end
    end
end

function L:_BeginSoundDuck(channel)
    local config=self.Sounds and self.Sounds.ducking
    if type(config)~="table" or config.enabled~=true then return nil end
    local channels=type(config.channels)=="table" and config.channels or {UI=true}
    if channels[channel]~=true then return nil end
    self._soundDuckCount=(self._soundDuckCount or 0)+1
    if self._soundDuckCount==1 then self:_UpdateSoundDucking() end
    local released=false
    return function()
        if released then return end
        released=true
        self._soundDuckCount=math.max(0,(self._soundDuckCount or 0)-1)
        if self._soundDuckCount==0 then self:_UpdateSoundDucking() end
    end
end

function L:SetSoundDucking(enabled,cfg)
    if self._destroyed then return false,"library is destroyed" end
    cfg=type(cfg)=="table" and cfg or {}
    self.Sounds.ducking=type(self.Sounds.ducking)=="table" and self.Sounds.ducking or {enabled=false,volume=.35,channels={UI=true}}
    self.Sounds.ducking.enabled=enabled==true
    if cfg.Volume~=nil then self.Sounds.ducking.volume=ClampNumber(cfg.Volume,.35,0,1) end
    if type(cfg.Channels)=="table" then
        local selected={}
        for channel,value in pairs(cfg.Channels) do if type(channel)=="string" and value==true then selected[channel]=true end end
        self.Sounds.ducking.channels=selected
    end
    self:_UpdateSoundDucking()
    self:Emit("SoundSettingsChanged",{Ducking=self.Sounds.ducking.enabled,Enabled=self.Sounds.enabled,Silent=self.Sounds.silent,Volume=self.Sounds.volume})
    return self.Sounds.ducking.enabled
end

function L:SetSoundSlot(slot, assetId)
    if self._destroyed then return false,"library is destroyed" end
    if type(slot)~="string" or not table.find(DefaultSoundSlots,slot) then
        return false,"unknown sound slot"
    end
    if assetId==nil or tostring(assetId):match("^%s*$") then
        self.Sounds[slot]=""
    else
        local normalized=NormalizeSoundId(assetId)
        if not normalized then return false,"sound id must be a numeric asset id or rbxassetid:// URI" end
        self.Sounds[slot]=normalized
    end
    local saved={}
    for _,soundSlot in ipairs(DefaultSoundSlots) do saved[soundSlot]=self.Sounds[soundSlot] or "" end
    JsonWrite("library_sound_slots.json",saved)
    self:Emit("SoundSettingsChanged",{Slot=slot,AssetId=self.Sounds[slot]})
    return true,self.Sounds[slot]
end

function L:GetSoundHistory(limit)
    local history=type(self.Sounds.history)=="table" and self.Sounds.history or {}
    local count=math.floor(ClampNumber(limit,#history,0,50))
    local result={}
    for index=1,math.min(count,#history) do
        local entry=history[index]
        result[index]=type(entry)=="table" and table.clone(entry) or entry
    end
    return result
end

function L:SetSoundSilent(silent,fadeDuration)
    if self._destroyed then return false,"library is destroyed" end
    self.Sounds.silent = silent == true
    if self.Sounds.silent then self:StopSound(ClampNumber(fadeDuration,0.15,0,10)) end
    self:Emit("SoundSettingsChanged",{Silent=self.Sounds.silent,Enabled=self.Sounds.enabled,Volume=self.Sounds.volume})
    return self.Sounds.silent
end

function L:SetSoundFavorite(id, enabled)
    if self._destroyed then return false,"library is destroyed" end
    if id==nil then return false end
    local key = tostring(id)
    if key=="" then return false end
    if type(self.Sounds.favorites)~="table" then self.Sounds.favorites={} end
    local normalized=NormalizeSoundId(key) or key
    local previous=self.Sounds.favorites[normalized]
    self.Sounds.favorites[normalized] = enabled ~= false and true or nil
    if key~=normalized then self.Sounds.favorites[key]=nil end
    if previous~=(self.Sounds.favorites[normalized]==true) then JsonWrite("library_sound_favorites.json",self.Sounds.favorites) end
    return self.Sounds.favorites[normalized]==true
end

function L:ImportSoundPlaylist(name, ids, category)
    if self._destroyed then return false,"library is destroyed" end
    name = tostring(name or "Playlist")
    local list = {}
    if type(ids) == "string" then
        for token in ids:gmatch("[^,%s;]+") do
            local id=NormalizeSoundId(token)
            if id then table.insert(list,id) end
        end
    elseif type(ids) == "table" then
        for _, id in ipairs(ids) do
            local normalized=NormalizeSoundId(id)
            if normalized then table.insert(list,normalized) end
        end
    end
    self.Sounds.playlists = self.Sounds.playlists or {}
    self.Sounds.playlists[name] = {category=category or "Custom", sounds=list}
    self:Emit("SoundPlaylistsChanged",name,table.clone(list))
    return list
end
function L:PlaySoundPlaylist(name,index)
    if self._destroyed then return false,"library is destroyed" end
    local playlist=(self.Sounds.playlists or {})[name]
    if type(playlist)~="table" or type(playlist.sounds)~="table" or #playlist.sounds==0 then return false end
    index=math.floor(ClampNumber(index,1,1,#playlist.sounds))
    return self:PlaySoundAsset(playlist.sounds[index],"Music")
end

function L:StopSound(fadeDuration)
    local sound = self._activeSound or self._pausedSound
    if not sound then return false end
    self._soundFadeToken=(self._soundFadeToken or 0)+1
    local token=self._soundFadeToken
    self._activeSound=nil
    self._pausedSound=nil
    self:Emit("SoundPlaybackChanged",{State="Stopped",Sound=sound})
    local duration=ClampNumber(fadeDuration,0,0,10)
    if duration == 0 then pcall(function() sound:Stop(); sound:Destroy() end); return true end
    local startVolume = sound.Volume
    local started = os.clock()
    task.spawn(function()
        while sound.Parent and sound.IsPlaying and token==self._soundFadeToken do
            local alpha = math.clamp((os.clock()-started)/duration, 0, 1)
            sound.Volume = startVolume * (1-alpha)
            if alpha >= 1 then break end
            task.wait(0.03)
        end
        pcall(function() sound:Stop(); sound:Destroy() end)
    end)
    return true
end

function L:PauseSound()
    if self._destroyed then return false,"library is destroyed" end
    local sound=self._activeSound
    if not sound or not sound.Parent or not sound.IsPlaying then return false end
    local ok=pcall(function() sound:Pause() end)
    if not ok then return false end
    self._pausedSound=sound
    self:Emit("SoundPlaybackChanged",{State="Paused",Sound=sound})
    return true
end

function L:ResumeSound()
    local sound=self._pausedSound
    if not sound or not sound.Parent then self._pausedSound=nil; return false end
    local ok=pcall(function() sound:Resume() end)
    if not ok then return false end
    self._pausedSound=nil
    self._activeSound=sound
    self:Emit("SoundPlaybackChanged",{State="Playing",Sound=sound})
    return true
end

function L:_PlaySoundId(id, slot, channel, options)
    if self._destroyed then return false,"library is destroyed" end
    if self.Sounds.silent or not self.Sounds.enabled then return false,"sound playback is disabled" end
    if type(id)~="string" or id == "" then return false,"sound id is empty" end
    options=type(options)=="table" and options or {}
    local fadeIn=ClampNumber(options.FadeIn,0,0,10)
    channel = channel or ((slot == "click" or slot == "hover" or slot == "open" or slot == "close") and "UI") or "Effects"
    self._activeSoundInstances=self._activeSoundInstances or setmetatable({}, {__mode="k"})
    local activeCount=0
    for existing in pairs(self._activeSoundInstances) do
        if existing and existing.Parent then activeCount+=1 else self._activeSoundInstances[existing]=nil end
    end
    if activeCount>=32 then return false,"active sound limit reached" end
    local createdSound; local releaseDuck
    local ok,sound=pcall(function()
        local s = Instance.new("Sound")
        createdSound=s
        s.SoundId = id
        local baseTargetVolume=ClampNumber(self.Sounds.volume,0.5,0,1) * ClampNumber((self.Sounds.channels or {})[channel],1,0,1)
        local targetVolume=baseTargetVolume
        self._duckedSoundVolumes=self._duckedSoundVolumes or setmetatable({}, {__mode="k"})
        if channel=="Music" or channel=="Ambient" then
            self._duckedSoundVolumes[s]=baseTargetVolume
            local ducking=self.Sounds.ducking
            if ducking and ducking.enabled and (self._soundDuckCount or 0)>0 then targetVolume*=ClampNumber(ducking.volume,.35,0,1) end
        end
        s.Volume = fadeIn>0 and 0 or targetVolume
        if options.Pitch~=nil then s.PlaybackSpeed=ClampNumber(options.Pitch,1,0.5,2) end
        s.Looped=options.Looped==true
        s.Parent = SS
        self._activeSoundInstances[s]=true
        releaseDuck=self:_BeginSoundDuck(channel)
        self.Sounds.history = self.Sounds.history or {}
        table.insert(self.Sounds.history, 1, {id=id, slot=slot, channel=channel, time=os.time()})
        while #self.Sounds.history > 50 do table.remove(self.Sounds.history) end
        if channel == "Music" or channel == "Ambient" or options.Track==true then
            self:StopSound(options and options.FadeOut or 0.15)
            self._activeSound = s
            self._pausedSound=nil
        end
        s:Play()
        if self._activeSound==s then self:Emit("SoundPlaybackChanged",{State="Playing",Sound=s}) end
        local startTime=ClampNumber(options.TimePosition,0,0,3600000)
        if startTime>0 then
            task.spawn(function()
                local deadline=os.clock()+5
                while s.Parent and not s.IsLoaded and os.clock()<deadline do task.wait(0.05) end
                if s.Parent and s.IsLoaded and s.TimeLength>0 then
                    pcall(function() s.TimePosition=math.clamp(startTime,0,math.max(s.TimeLength-0.05,0)) end)
                end
            end)
        end
        if fadeIn>0 then TweenService:Create(s,TweenInfo.new(math.max(fadeIn,0.05)),{Volume=targetVolume}):Play() end
        s.Ended:Connect(function()
            if self._activeSound == s then self._activeSound=nil end
            if self._pausedSound == s then self._pausedSound=nil end
            self:Emit("SoundPlaybackChanged",{State="Ended",Sound=s})
            s:Destroy()
        end)
        s.Destroying:Connect(function()
            if self._activeSoundInstances then self._activeSoundInstances[s]=nil end
            if self._duckedSoundVolumes then self._duckedSoundVolumes[s]=nil end
            if releaseDuck then releaseDuck(); releaseDuck=nil end
            if self._activeSound==s then self._activeSound=nil end
            if self._pausedSound==s then self._pausedSound=nil end
        end)
        local maxDuration=options.MaxDuration~=nil and ClampNumber(options.MaxDuration,120,1,86400)
            or (s.Looped and 0 or ((channel=="Music" or channel=="Ambient") and 3600 or 120))
        if maxDuration>0 then task.delay(maxDuration,function() if s and s.Parent then s:Destroy() end end) end
        self:Emit("SoundPlayed",{Id=id,Slot=slot,Channel=channel,Time=os.time()})
        return s
    end)
    if not ok then
        if createdSound then
            if self._activeSoundInstances then self._activeSoundInstances[createdSound]=nil end
            if self._activeSound==createdSound then self._activeSound=nil end
            pcall(function() createdSound:Stop(); createdSound:Destroy() end)
        end
        if releaseDuck then releaseDuck(); releaseDuck=nil end
        return false,tostring(sound)
    end
    return sound~=nil
end

function L:PlaySound(slot, channel, options)
    if self._destroyed then return false,"library is destroyed" end
    if type(slot)~="string" then return false,"sound slot must be a string" end
    local id=self.Sounds[slot]
    return self:_PlaySoundId(NormalizeSoundId(id) or id,slot,channel,options)
end

function L:PlaySoundAsset(id, channel, options)
    if self._destroyed then return false,"library is destroyed" end
    local soundId=NormalizeSoundId(id)
    if not soundId then return false,"sound id must be a numeric asset id or rbxassetid:// URI" end
    return self:_PlaySoundId(soundId,nil,channel or "Music",options)
end

function L:SetTransitionSound(name, soundId)

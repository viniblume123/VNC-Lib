        local abs = Bar.AbsolutePosition.X
        local sz = Bar.AbsoluteSize.X
        if sz<=0 then return end
        local t = math.clamp((x - abs) / sz, 0, 1)
        local nextValue=min+(max-min)*t
        if cfg.Round then nextValue=math.floor(nextValue+.5) end
        applyValue(nextValue,true,true)
    end
    local lastThumbClick=0
    Btn.InputBegan:Connect(function(i)
        if inputEnabled and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
            if i.UserInputType==Enum.UserInputType.MouseButton1 then
                local thumbX=Bar.AbsolutePosition.X+((val-min)/(max-min))*Bar.AbsoluteSize.X
                local nearThumb=math.abs(i.Position.X-thumbX)<=12
                local now=os.clock()
                if nearThumb and now-lastThumbClick<=.35 then
                    lastThumbClick=0; dragging=false; applyValue(defaultValue,true,true); return
                end
                lastThumbClick=nearThumb and now or 0
            end
            dragging=true
            SetFromClick(i.Position.X)
        end
    end)
    local pointerConnections={}
    local keyboardConnection=UIS.InputBegan:Connect(function(input,processed)
        if not inputEnabled or processed or UIS:GetFocusedTextBox() or GuiService.SelectedObject~=Btn then return end
        local step=ClampNumber(cfg.Step,cfg.Round and 1 or (max-min)/100,0.000001,max-min)
        if input.KeyCode==Enum.KeyCode.Left or input.KeyCode==Enum.KeyCode.Down then applyValue(val-step,true,true)
        elseif input.KeyCode==Enum.KeyCode.Right or input.KeyCode==Enum.KeyCode.Up then applyValue(val+step,true,true)
        elseif input.KeyCode==Enum.KeyCode.Home then applyValue(min,true,true)
        elseif input.KeyCode==Enum.KeyCode.End then applyValue(max,true,true) end
    end)

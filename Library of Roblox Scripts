    XT.BackgroundTransparency = 1
    XT.Text = text
    XT.Font = Enum.Font.Gotham
    XT.TextSize = 11
    SetThemeColor(XT,"TextColor3",C,"TextDim")
    XT.TextXAlignment = Enum.TextXAlignment.Left
    XT.TextWrapped = true
    XT.Position = UDim2.new(0,0,0,18)
    XT.Parent = Card
    local Cb = Instance.new("TextButton")
    Cb.Size = UDim2.new(0,20,0,20)
    Cb.Position = UDim2.new(1,-24,0,8)
    Cb.BackgroundTransparency = 1
    Cb.Text = "×"
    SetThemeColor(Cb,"TextColor3",C,"TextFaint")
    Cb.Font = Enum.Font.GothamBold
    Cb.TextSize = 12
    Cb.AutoButtonColor = false
    Cb.Parent = Card
    local removed=false
    local paused=false
    local remaining=dur
    local deadline
    local timerThread
    local handle={Instance=Card,Card=Card}
    local function cancelTimer()
        if timerThread then pcall(task.cancel,timerThread); timerThread=nil end
    end
    local function scheduleRemoval()
        cancelTimer()
        if removed or paused then return end
        deadline=os.clock()+math.max(remaining,0)
        timerThread=task.delay(math.max(remaining,0),function() timerThread=nil; handle:Close() end)
    end
    local function Remove()
        if removed then return false end
        removed=true
        cancelTimer()
        local handleIndex=table.find(lib._notificationHandles or {},handle)
        if handleIndex then table.remove(lib._notificationHandles,handleIndex) end
        if not Card.Parent then return true end
        TweenService:Create(Card, T_INFO, {GroupTransparency=1}):Play()
        task.delay(0.24, function() if Card.Parent then Card:Destroy() end end)
        lib:Emit("NotificationClosed",historyEntry,handle)
        return true
    end
    function handle:Close() return Remove() end
    function handle:Pause()
        if removed or paused then return false end
        if deadline then remaining=math.max(0,deadline-os.clock()) end
        paused=true; cancelTimer(); return true
    end
    function handle:Resume()
        if removed or not paused then return false end
        paused=false; scheduleRemoval(); return true
    end
    function handle:SetTitle(value)
        if removed or not Card.Parent then return false end
        title=tostring(value or ""); TL.Text=title; historyEntry.Title=title; historyEntry.Time=os.time(); return true
    end
    function handle:SetText(value)
        if removed or not Card.Parent then return false end
        text=tostring(value or ""); XT.Text=text; historyEntry.Text=text; historyEntry.Time=os.time(); return true
    end
    function handle:Update(values)
        if type(values)~="table" or removed or not Card.Parent then return false end
        if values.Title~=nil then self:SetTitle(values.Title) end
        if values.Text~=nil or values.Content~=nil then self:SetText(values.Text or values.Content) end
        if values.Type~=nil then
            kind=tostring(values.Type):lower()
            col=kind=="success" and C.Success or kind=="error" and C.Danger or kind=="warning" and C.Warning or C.Info
            Cs.Color=col; Bar.BackgroundColor3=col; historyEntry.Type=kind; historyEntry.Time=os.time()
        end
        if values.Duration~=nil then self:SetDuration(values.Duration) end
        return true
    end
    function handle:SetDuration(seconds)
        if removed then return false end
        remaining=ClampNumber(seconds,4,0.1,120)
        if not paused then scheduleRemoval() end
        return remaining
    end
    function handle:IsClosed() return removed end
    lib._notificationHandles=lib._notificationHandles or {}
    table.insert(lib._notificationHandles,handle)
    Cb.MouseButton1Click:Connect(Remove)
    TweenService:Create(Card, T_OUT, {GroupTransparency=0}):Play()
    scheduleRemoval()
    lib:Emit("NotificationShown",historyEntry,handle)
    if cfg.ReturnHandle==true then return handle end
    return Card
end

function L:GetNotificationHistory() local lib=self._lib or self; return table.clone(lib.NotificationHistory or {}) end
function L:ClearNotificationHistory()
    local lib=self._lib or self
    table.clear(lib.NotificationHistory or {})
    local old=lib._notificationHistoryGui
    if old and old.Parent then
        old:Destroy()
        lib._notificationHistoryGui=nil
        lib:ShowNotificationHistory()
    end
    return true
end
function L:ShowNotificationHistory()
    local lib=self._lib or self
    local old=lib._notificationHistoryGui
    lib._notificationHistoryGui=nil
    if old and old.Parent then old:Destroy() end
    local items={}
    for _,entry in ipairs(lib.NotificationHistory or {}) do
        table.insert(items,{Name=entry.Title.." — "..entry.Text,Tab=os.date("%H:%M:%S",entry.Time),Callback=function() lib:Notify({Title=entry.Title,Text=entry.Text,Type=entry.Type,Duration=3}) end})
    end
    if #items==0 then items={{Name="No notifications recorded",Tab="History",Callback=function() end}} end
    local search=lib:CreateGlobalSearch({Items=items,Placeholder="Search notification history..."})
    if not search then return nil,"Open a library window before showing notification history." end
    lib._notificationHistoryGui=search
    search.Destroying:Connect(function() if lib._notificationHistoryGui==search then lib._notificationHistoryGui=nil end end)
    return search
end


    local function Search()
        for _, c in ipairs(Results:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        local q = Input.Text:lower():gsub("^%s+",""):gsub("%s+$","")
        if q == "" then Results.Visible = false; return end
        Results.Visible = true
        local searchItems=table.clone(items)
        if type(cfg.GetItems)=="function" then
            local ok,extra=InvokeUserCallback(cfg.GetItems)
            if ok and type(extra)=="table" then for _,item in ipairs(extra) do table.insert(searchItems,item) end end
        end
        for _, item in ipairs(searchItems) do
            if type(item)=="table" then
            local itemName=tostring(item.Name or item.Title or "Action")
            local itemTab=tostring(item.Tab or "")
            if itemName:lower():find(q, 1, true) or itemTab:lower():find(q, 1, true) then

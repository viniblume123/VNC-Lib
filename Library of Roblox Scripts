local function HttpGet(url)
    if REQ then
        local ok, res = pcall(REQ, {Url=url, Method="GET"})
        local status=type(res)=="table" and tonumber(res.StatusCode) or nil
        if ok and type(res)=="table" and type(res.Body)=="string" and res.Body~="" and (res.StatusCode==nil or (status and status>=200 and status<300)) then return res.Body end
    end
    local ok, res = pcall(function() return game:HttpGet(url) end)
    if ok and type(res)=="string" and res~="" then return res end
    return nil
end

local function HttpPost(url, body, headers)
    if REQ then
        local ok, res = pcall(REQ, {Url=url, Method="POST", Body=body, Headers=headers or {["Content-Type"]="application/json"}})
        local status=type(res)=="table" and tonumber(res.StatusCode) or nil
        if ok and type(res)=="table" and type(res.Body)=="string" and res.Body~="" and (res.StatusCode==nil or (status and status>=200 and status<300)) then return res.Body end
    end
    local ok, res = pcall(function() return game:HttpPost(url, body) end)
    if ok and type(res)=="string" and res~="" then return res end
    return nil
end

local function JsonRead(file, def)
    if not ISF then return def end
    local existsOk,exists=pcall(ISF,file)
    if not existsOk or not exists then return def end
    local ok, c = pcall(RF, file)
    if not ok or not c then return def end
    local ok2, d = pcall(HS.JSONDecode, HS, c)
    if ok2 and type(d)=="table" then return d end
    return def
end

local function JsonWrite(file, data)
    if not WF then return false, "writefile is unavailable" end
    local encodedOk, encoded = pcall(HS.JSONEncode, HS, data)
    if not encodedOk then return false, tostring(encoded) end
    local writeOk, writeResult = pcall(WF, file, encoded)
    if not writeOk then return false, tostring(writeResult) end
    if writeResult==false then return false,"writefile reported failure" end
    return true
end

local function HexToColor(h)
    if not h then return nil end
    h = tostring(h):gsub("#","")
    if #h==3 then h = h:sub(1,1):rep(2)..h:sub(2,2):rep(2)..h:sub(3,3):rep(2) end
    if #h~=6 then return nil end
    local r,g,b = tonumber(h:sub(1,2),16), tonumber(h:sub(3,4),16), tonumber(h:sub(5,6),16)
    if not r or not g or not b then return nil end
    return Color3.fromRGB(r,g,b)
end

local function ColorToHex(c)
    return string.format("#%02X%02X%02X", math.floor(c.R*255+0.5), math.floor(c.G*255+0.5), math.floor(c.B*255+0.5))
end

local function FormatControlNumber(value, maxDigits)
    maxDigits=tonumber(maxDigits) or 3
    if maxDigits~=maxDigits or maxDigits==math.huge or maxDigits==-math.huge then maxDigits=3 end
    maxDigits=math.floor(math.clamp(maxDigits,0,8))
    local n = tonumber(value) or 0
    if n ~= n or n == math.huge or n == -math.huge then n = 0 end
    local sign = n < 0 and "-" or ""
    local a = math.abs(n)
    if maxDigits==0 then local rounded=math.floor(a+0.5); return (rounded==0 and "" or sign)..tostring(rounded) end
    if a < 1 then
        local t = string.format("%."..maxDigits.."f", a):gsub("0+$", ""):gsub("%.$", "")
        if t=="" then return "0" end
        return sign .. t
    end
    local whole = tostring(math.floor(a))
    if a == math.floor(a) then return sign .. whole end
    local formatted=string.format("%."..maxDigits.."f",a):gsub("0+$",""):gsub("%.$","")
    return (formatted=="0" and "" or sign)..formatted
end

local function ClampNumber(value, fallback, minimum, maximum)
    local number=tonumber(value)
    minimum=tonumber(minimum) or -math.huge
    maximum=tonumber(maximum) or math.huge
    if minimum>maximum then minimum,maximum=maximum,minimum end
    if not number or number~=number or number==math.huge or number==-math.huge then number=tonumber(fallback) end
    if not number or number~=number or number==math.huge or number==-math.huge then
        number=minimum~=-math.huge and minimum or (maximum~=math.huge and maximum or 0)
    end
    return math.clamp(number,minimum,maximum)
end

local function SafeColor(value, fallback)
    return typeof(value) == "Color3" and value or fallback
end

local function SanitizeForJson(value, seen)
    local kind=typeof(value)
    if kind=="Color3" then return {__vncType="Color3",r=value.R,g=value.G,b=value.B} end
    if kind=="Vector2" then return {__vncType="Vector2",x=value.X,y=value.Y} end
    if kind=="Vector3" then return {__vncType="Vector3",x=value.X,y=value.Y,z=value.Z} end
    if kind=="UDim" then return {__vncType="UDim",scale=value.Scale,offset=value.Offset} end
    if kind=="UDim2" then return {__vncType="UDim2",xs=value.X.Scale,xo=value.X.Offset,ys=value.Y.Scale,yo=value.Y.Offset} end
    if kind=="EnumItem" then return {__vncType="EnumItem",enumType=value.EnumType.Name,name=value.Name} end
    if kind=="CFrame" then
        local components={value:GetComponents()}
        return {__vncType="CFrame",components=components}
    end
    if kind=="NumberSequence" then
        local keys={}; for _,keypoint in ipairs(value.Keypoints) do table.insert(keys,{keypoint.Time,keypoint.Value,keypoint.Envelope}) end
        return {__vncType="NumberSequence",keys=keys}
    end
    if kind=="ColorSequence" then
        local keys={}; for _,keypoint in ipairs(value.Keypoints) do table.insert(keys,{keypoint.Time,keypoint.Value.R,keypoint.Value.G,keypoint.Value.B}) end
        return {__vncType="ColorSequence",keys=keys}
    end
    if kind=="table" then
        seen=seen or {}; if seen[value] then return nil end; seen[value]=true
        local count,maxIndex,numericOnly,stringOnly=0,0,true,true
        local hasReserved=value.__vncType~=nil
        for key in pairs(value) do
            count+=1
            if type(key)=="number" and key%1==0 and key>0 then maxIndex=math.max(maxIndex,key); stringOnly=false
            elseif type(key)=="string" then numericOnly=false
            else numericOnly=false; stringOnly=false end
        end
        local contiguous=numericOnly and count==maxIndex and not hasReserved
        local out={}
        if contiguous or (stringOnly and not hasReserved) then
            local skippedArrayValue=false
            for key,item in pairs(value) do
                local clean=SanitizeForJson(item,seen)
                if clean~=nil then out[key]=clean elseif numericOnly then skippedArrayValue=true end
            end
            if not skippedArrayValue then seen[value]=nil; return out end
            local entries={}
            for key,item in pairs(out) do table.insert(entries,{type="number",key=tostring(key),value=item}) end
            seen[value]=nil
            return {__vncType="Table",entries=entries}
        end
        local entries={}
        for key,item in pairs(value) do
            if type(key)=="string" or (type(key)=="number" and key==key and key~=math.huge and key~=-math.huge) then local clean=SanitizeForJson(item,seen); if clean~=nil then table.insert(entries,{type=type(key),key=tostring(key),value=clean}) end end
        end
        seen[value]=nil; return {__vncType="Table",entries=entries}
    end
    if kind=="number" then if value~=value or value==math.huge or value==-math.huge then return nil end; return value end
    if kind=="nil" or kind=="boolean" or kind=="string" then return value end
    return nil
end

local function DesanitizeFromJson(value)
    if type(value)~="table" then return value end
    local tag=value.__vncType
    if tag=="Table" and type(value.entries)=="table" then local out={}; for _,entry in ipairs(value.entries) do local key=entry.type=="number" and tonumber(entry.key) or entry.key; if key~=nil then out[key]=DesanitizeFromJson(entry.value) end end; return out end
    if tag=="Table" and type(value.value)=="table" then return DesanitizeFromJson(value.value) end
    if tag=="Color3" and type(value.r)=="number" and type(value.g)=="number" and type(value.b)=="number" then return Color3.new(value.r,value.g,value.b) end
    if tag=="Vector2" and type(value.x)=="number" and type(value.y)=="number" then return Vector2.new(value.x,value.y) end
    if tag=="Vector3" and type(value.x)=="number" and type(value.y)=="number" and type(value.z)=="number" then return Vector3.new(value.x,value.y,value.z) end
    if tag=="UDim" and type(value.scale)=="number" and type(value.offset)=="number" then return UDim.new(value.scale,value.offset) end
    if tag=="UDim2" and type(value.xs)=="number" and type(value.xo)=="number" and type(value.ys)=="number" and type(value.yo)=="number" then return UDim2.new(value.xs,value.xo,value.ys,value.yo) end
    if tag=="EnumItem" and type(value.enumType)=="string" and type(value.name)=="string" then local enum=Enum[value.enumType]; return enum and enum[value.name] or nil end
    if tag=="CFrame" and type(value.components)=="table" and #value.components==12 then return CFrame.new(table.unpack(value.components)) end
    if tag=="NumberSequence" and type(value.keys)=="table" then
        local keys={}; for _,k in ipairs(value.keys) do if #k>=2 then table.insert(keys,NumberSequenceKeypoint.new(k[1],k[2],k[3] or 0)) end end
        if #keys>=2 then return NumberSequence.new(keys) end
    end
    if tag=="ColorSequence" and type(value.keys)=="table" then
        local keys={}; for _,k in ipairs(value.keys) do if #k>=4 then table.insert(keys,ColorSequenceKeypoint.new(k[1],Color3.new(k[2],k[3],k[4]))) end end
        if #keys>=2 then return ColorSequence.new(keys) end
    end
    local out={}; for key,item in pairs(value) do out[key]=DesanitizeFromJson(item) end; return out
end
local function TrySanitizeForJson(value)
    local ok,result=pcall(SanitizeForJson,value)
    if ok then return result end
    return nil
end
local function ApplySerializedState(entry,value,silent)
    if not entry or type(entry.Set)~="function" then return false end
    local ok,restored=pcall(DesanitizeFromJson,value)
    if not ok then return false end
    return pcall(entry.Set,restored,silent)
end


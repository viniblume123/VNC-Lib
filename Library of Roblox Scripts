    if PROT then pcall(PROT, gui) end
    New("Frame", {Size=UDim2.fromScale(1,1), BackgroundColor3=C.Bg, BorderSizePixel=0, Parent=gui})
    local card = New("Frame", {Size=UDim2.fromOffset(360,260), Position=UDim2.new(0.5,-180,0.5,-130), BackgroundColor3=C.Surface, BorderSizePixel=0, Parent=gui})
    Corner(card, 14); Stroke(card, C.Stroke, 0.15)
    New("TextLabel", {Size=UDim2.new(1,0,0,30), Position=UDim2.fromOffset(0,24), BackgroundTransparency=1, Text="Autenticação", Font=Enum.Font.GothamBold, TextSize=18, TextColor3=C.Text, Parent=card})
    New("TextLabel", {Size=UDim2.new(1,-40,0,16), Position=UDim2.fromOffset(20,60), BackgroundTransparency=1, Text="Digite sua key para continuar", Font=Enum.Font.Gotham, TextSize=11, TextColor3=C.TextFaint, Parent=card})
    local input = New("TextBox", {Size=UDim2.new(1,-40,0,36), Position=UDim2.fromOffset(20,90), BackgroundColor3=C.Card, Text="", PlaceholderText="Sua key...", TextColor3=C.Text, PlaceholderColor3=C.TextFaint, Font=Enum.Font.Gotham, TextSize=12, BorderSizePixel=0, ClearTextOnFocus=false, Parent=card})
    Corner(input, 8)
    local btn = New("TextButton", {Size=UDim2.new(1,-40,0,36), Position=UDim2.fromOffset(20,136), BackgroundColor3=C.Accent, Text="Validar", TextColor3=C.White, Font=Enum.Font.GothamBold, TextSize=12, BorderSizePixel=0, Parent=card})
    Corner(btn, 8)
    local status = New("TextLabel", {Size=UDim2.new(1,-40,0,16), Position=UDim2.fromOffset(20,180), BackgroundTransparency=1, Text="", Font=Enum.Font.Gotham, TextSize=10, TextColor3=C.TextFaint, Parent=card})
    local link = New("TextButton", {Size=UDim2.new(1,-40,0,20), Position=UDim2.new(0,20,1,-40), BackgroundTransparency=1, Text=cfg.KeyLink or "", TextColor3=C.Accent, Font=Enum.Font.Gotham, TextSize=10, Parent=card})
    link.MouseButton1Click:Connect(function() if CLIP then pcall(CLIP, cfg.KeyLink or "") end end)
    btn.MouseButton1Click:Connect(function()
        if input.Text == "" then status.Text = "Digite uma key"; return end
        btn.Text = "Validando..."
        task.spawn(function()
            local ok, err = KeySystem.Validate(cfg, input.Text)
            if ok then
                status.Text = "Validado! Carregando..."
                task.wait(0.4)
                gui:Destroy()
            else
                btn.Text = "Validar"
                status.Text = "Falha: "..tostring(err)
                local orig = card.Position
                for i = 1, 3 do
                    TweenService:Create(card, TweenInfo.new(0.05), {Position=orig + UDim2.fromOffset(i%2==0 and -8 or 8, 0)}):Play()
                    task.wait(0.05)
                end
                TweenService:Create(card, TweenInfo.new(0.1), {Position=orig}):Play()
            end
        end)
    end)
    return gui
end


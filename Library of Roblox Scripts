function L:CreateKeybind(cfg)
    local Sec = self
    local C = Sec.C or Sec._window.C
    cfg = cfg or {}
    local key = cfg.Default or Enum.KeyCode.E
    local Wrapped = Instance.new("Frame")
    Wrapped.Size = UDim2.new(1,0,0,46)
    Wrapped.BackgroundColor3 = C.Card
    Wrapped.BorderSizePixel = 0
    Wrapped.Parent = Sec._inner or Sec._holder
    local Wc = Instance.new("UICorner"); Wc.CornerRadius = UDim.new(0,10); Wc.Parent = Wrapped
    local Ws = Instance.new("UIStroke"); Ws.Color = C.Stroke; Ws.Thickness = 1; Ws.Transparency = 0.4; Ws.Parent = Wrapped
    local Lb = Instance.new("TextLabel")
    Lb.Size = UDim2.new(1,-120,1,0)
    Lb.Position = UDim2.new(0,16,0,0)
    Lb.BackgroundTransparency = 1
    Lb.Text = cfg.Name or "Keybind"
    Lb.Font = Enum.Font[Sec._lib.CurrentFontMedium]
    Lb.TextSize = 13
    Lb.TextColor3 = C.Text
    Lb.TextXAlignment = Enum.TextXAlignment.Left
    Lb.Parent = Wrapped
    local KBtn = Instance.new("TextButton")
    KBtn.Size = UDim2.new(0,90,0,30)
    KBtn.Position = UDim2.new(1,-106,0.5,-15)
    KBtn.BackgroundColor3 = C.Surface
    KBtn.Text = key.Name
    KBtn.TextColor3 = C.Text
    KBtn.Font = Enum.Font[Sec._lib.CurrentFontBold]
    KBtn.TextSize = 12
    KBtn.BorderSizePixel = 0
    KBtn.AutoButtonColor = false
    KBtn.Parent = Wrapped
    local Kc = Instance.new("UICorner"); Kc.CornerRadius = UDim.new(0,8); Kc.Parent = KBtn
    local Ks = Instance.new("UIStroke"); Ks.Color = C.Stroke; Ks.Thickness = 1; Ks.Transparency = 0.4; Ks.Parent = KBtn
    local listening = false
    local modifiers = type(cfg.Modifiers)=="table" and table.clone(cfg.Modifiers) or {}
    local function formatKey()
        local parts={}
        if modifiers.Control then table.insert(parts,"Ctrl") end
        if modifiers.Shift then table.insert(parts,"Shift") end
        if modifiers.Alt then table.insert(parts,"Alt") end
        table.insert(parts,key.Name)
        return table.concat(parts,"+")
    end
    KBtn.Text=formatKey()
    KBtn.MouseButton1Click:Connect(function()
        listening = true
        modifiers = {
            Control=UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl),
            Shift=UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.RightShift),
            Alt=UIS:IsKeyDown(Enum.KeyCode.LeftAlt) or UIS:IsKeyDown(Enum.KeyCode.RightAlt)
        }
        KBtn.Text = "..."
        TweenService:Create(Ks, T_OUT, {Color=C.Accent, Transparency=0}):Play()
    end)
    local keyConnection=UIS.InputBegan:Connect(function(i,gp)
        if i.UserInputType~=Enum.UserInputType.Keyboard then return end
        if listening and i.KeyCode==Enum.KeyCode.Escape then
            listening=false; KBtn.Text=formatKey()
            TweenService:Create(Ks,T_OUT,{Color=C.Stroke,Transparency=0.4}):Play()
            return
        end
        if listening and not gp and i.KeyCode~=Enum.KeyCode.Unknown then
            local code=i.KeyCode
            if code==Enum.KeyCode.LeftControl or code==Enum.KeyCode.RightControl then modifiers.Control=true
            elseif code==Enum.KeyCode.LeftShift or code==Enum.KeyCode.RightShift then modifiers.Shift=true
            elseif code==Enum.KeyCode.LeftAlt or code==Enum.KeyCode.RightAlt then modifiers.Alt=true
            else key=code; listening=false; KBtn.Text=formatKey(); TweenService:Create(Ks,T_OUT,{Color=C.Stroke,Transparency=0.4}):Play(); if cfg.OnChanged then pcall(cfg.OnChanged,key,modifiers) end; if cfg.Flag then Sec._lib:_ScheduleConfigAutoSave() end end
            if listening then local prefix={}; if modifiers.Control then table.insert(prefix,"Ctrl") end; if modifiers.Shift then table.insert(prefix,"Shift") end; if modifiers.Alt then table.insert(prefix,"Alt") end; KBtn.Text=#prefix>0 and table.concat(prefix,"+").."+..." or "..." end
        elseif not gp and not listening and key==i.KeyCode then
            local ctrl=UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl)
            local shift=UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.RightShift)
            local alt=UIS:IsKeyDown(Enum.KeyCode.LeftAlt) or UIS:IsKeyDown(Enum.KeyCode.RightAlt)
            if ctrl==(modifiers.Control==true) and shift==(modifiers.Shift==true) and alt==(modifiers.Alt==true) and cfg.Callback then pcall(cfg.Callback,key,modifiers) end
        end
    end)
    table.insert(Sec._lib._connections,keyConnection)
    local Element = setmetatable({Instance=Wrapped, _lib=Sec._lib, _favoriteId=cfg.Flag or cfg.Name, _favoriteName=cfg.Name, _favoriteTab=Sec._tab}, ElementMethods)
    Element:InitFavorite()
    function Element:Set(k)
        if type(k)=="table" then modifiers=table.clone(k.Modifiers or {}); k=k.Key end
        if type(k)=="string" then k=Enum.KeyCode[k] end
        if typeof(k)=="EnumItem" and k.EnumType==Enum.KeyCode then key=k; KBtn.Text=formatKey() end
    end
    function Element:Get() return key end
    function Element:GetCombo() return {Key=key,Modifiers=table.clone(modifiers)} end
    function Element:Destroy()
        listening=false
        if keyConnection then pcall(function() keyConnection:Disconnect() end); keyConnection=nil end
        Wrapped:Destroy()
    end
    if cfg.Flag then
        Sec._lib:RegisterState(cfg.Flag,function() return {Key=key.Name,Modifiers=modifiers} end,function(v)
            if type(v)=="table" then
                modifiers=type(v.Modifiers)=="table" and table.clone(v.Modifiers) or {}
                local mapped=type(v.Key)=="string" and Enum.KeyCode[v.Key] or v.Key
                if typeof(mapped)=="EnumItem" and mapped.EnumType==Enum.KeyCode then key=mapped; KBtn.Text=formatKey() end
            else Element:Set(v) end
        end)
    end
    Sec:_AddElement(Wrapped)
    return Element
end


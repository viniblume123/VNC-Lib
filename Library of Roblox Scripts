local function copyAlias(options,target,...)
    if options[target]~=nil then return end
    for _,alias in ipairs({...}) do
        if options[alias]~=nil then options[target]=options[alias]; return end
    end
end
local function NormalizeElementOptions(methodName,value)
    local options=type(value)=="table" and table.clone(value) or {}
    copyAlias(options,"Callback","callback","onClick","onChanged")
    copyAlias(options,"Name","name","title","Title")
    copyAlias(options,"Desc","desc","Description","description")
    copyAlias(options,"Flag","flag")
    copyAlias(options,"Default","default","defaultValue","DefaultValue","CurrentValue","currentValue","CurrentOption","currentOption","CurrentKeybind","currentKeybind","Value","value")
    copyAlias(options,"Min","min")
    copyAlias(options,"Max","max")
    copyAlias(options,"Step","step","Increment","increment")
    copyAlias(options,"Increment","increment","Step","step")
    copyAlias(options,"MinimumGap","minimumGap")
    copyAlias(options,"DefaultMin","defaultMin","minValue")
    copyAlias(options,"DefaultMax","defaultMax","maxValue")
    copyAlias(options,"TickMarks","tickMarks","Ticks","ticks")
    copyAlias(options,"Options","options","Values","values","Items","items")
    copyAlias(options,"Placeholder","placeholder","PlaceholderText","placeholderText")
    copyAlias(options,"Icon","icon")
    copyAlias(options,"Suffix","suffix")
    copyAlias(options,"Multi","multi","MultipleOptions","multipleOptions")
    copyAlias(options,"Searchable","searchable","SearchBarEnabled","searchBarEnabled")
    copyAlias(options,"OnSubmit","onSubmit","submitCallback")
    copyAlias(options,"OnChanged","onChanged","onChange")
    copyAlias(options,"Title","title")
    copyAlias(options,"Content","content","Description","description","Body","body")
    copyAlias(options,"Text","text")
    if methodName=="CreateLabel" and options.Text==nil and options.Name~=nil then options.Text=options.Name end
    if methodName=="CreateParagraph" and options.Title==nil and options.Name~=nil then options.Title=options.Name end
    if methodName=="CreateColorPicker" or methodName=="CreateGradientPicker" then copyAlias(options,"Default","Color","color") end
    if methodName=="CreateSlider" or methodName=="CreateRangeSlider" then
        if type(options.Range)=="table" then
            if options.Min==nil then options.Min=options.Range.Min or options.Range[1] end
            if options.Max==nil then options.Max=options.Range.Max or options.Range[2] end
        end
        copyAlias(options,"Round","rounding","Rounding")
    end
    if methodName=="CreateInput" then copyAlias(options,"Multiline","multiline","TextArea","textArea") end
    if methodName=="CreateKeybind" or methodName=="CreateHotkeyCombo" or methodName=="CreateBind" then
        copyAlias(options,"Default","CurrentKeybind","currentKeybind")
    end
    return options
end
for _,methodName in ipairs(sectionOnlyCreators) do
    local implementation=L[methodName]
    if type(implementation)=="function" then
        local currentMethodName,methodImplementation=methodName,implementation
        L[currentMethodName]=function(self,...)
            if not IsElementContainer(self) then
                return nil,"section or tab required"
            end
            local arguments=table.pack(...)
            if currentMethodName=="CreateDivider" then
                if type(arguments[1])=="table" then arguments[1]=NormalizeElementOptions(currentMethodName,arguments[1]) end
            elseif currentMethodName=="CreateLabel" and type(arguments[1])=="string" then
                local options={Text=arguments[1]}
                if type(arguments[2])=="string" then options.Type=arguments[2] end
                arguments[1]=NormalizeElementOptions(currentMethodName,options)
            elseif currentMethodName=="CreateParagraph" and type(arguments[1])=="string" then
                local options={Title=arguments[1]}
                if type(arguments[2])=="string" then options.Content=arguments[2]
                elseif type(arguments[2])=="table" then for key,value in pairs(arguments[2]) do options[key]=value end end
                arguments[1]=NormalizeElementOptions(currentMethodName,options)
            elseif currentMethodName=="CreateSpace" or currentMethodName=="CreateSpacer" then
                if type(arguments[1])=="number" then arguments[1]={Height=arguments[1]}
                elseif type(arguments[1])=="table" then arguments[1]=NormalizeElementOptions(currentMethodName,arguments[1]) end
            elseif arguments.n>0 and arguments[1]~=nil and type(arguments[1])~="table" then
                local options={Name=tostring(arguments[1])}
                if type(arguments[2])=="table" then
                    for key,value in pairs(arguments[2]) do options[key]=value end
                elseif type(arguments[2])=="function" then
                    options.Callback=arguments[2]
                end
                arguments[1]=NormalizeElementOptions(currentMethodName,options)
            elseif type(arguments[1])=="table" then
                arguments[1]=NormalizeElementOptions(currentMethodName,arguments[1])
            end
            local lib=self._lib or self
            if lib.Debug and type(arguments[1])=="table" then
                local _,issues=lib:ValidateElementConfig(currentMethodName,arguments[1])
                for _,issue in ipairs(issues) do lib:DebugLog("element config",currentMethodName.."."..issue.Field.." "..issue.Message) end
            end
            return methodImplementation(self,table.unpack(arguments,1,arguments.n))
        end
    end
end


function L:_ScheduleConfigAutoSave()
    if self._destroyed or self._loadingConfig then return end
    if self.Macros and self.Macros._recording and not self.Macros._playing then
        local current=self:CaptureConfig()
        local previous=self.Macros._lastRecordedState or {values={}}
        for flag,value in pairs(current.values or {}) do
            local okCurrent, encodedCurrent=pcall(HS.JSONEncode,HS,TrySanitizeForJson(value))
            local okPrevious, encodedPrevious=pcall(HS.JSONEncode,HS,TrySanitizeForJson((previous.values or {})[flag]))
            if okCurrent and (not okPrevious or encodedCurrent~=encodedPrevious) then
                self:AddMacroStep({type="state",flag=flag,value=value})
            end
        end
        self.Macros._lastRecordedState=current
    end
    self:_TrackConfigChange()
    if not self.Config.AutoSaveConfig or not self.Config.AutoSaveConfigName then return end
    self._configSaveToken = (self._configSaveToken or 0) + 1
    local token = self._configSaveToken
    task.delay(ClampNumber(self.Config.AutoSaveConfigDelay,0.75,0.1,60), function()
        if self._destroyed or token ~= self._configSaveToken then return end
        pcall(function() self:OverwriteConfig(self.Config.AutoSaveConfigName) end)
    end)
end


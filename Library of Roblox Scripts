local function SetThemeColor(object,property,palette,role)
    local color=type(palette)=="table" and palette[role] or nil
    if typeof(color)~="Color3" then
        local fallback=type(L.C)=="table" and L.C[role] or nil
        if typeof(fallback)=="Color3" then color=fallback else return nil,"palette is missing Color3 role "..tostring(role) end
    end
    object[property]=color
    if typeof(object)=="Instance" then
        local attribute="__VNCColorRole_"..property
        pcall(function() if object:GetAttribute(attribute)~=role then object:SetAttribute(attribute,role) end end)
    end
    return color
end

local function SetCustomThemeColor(object,property,color)
    if typeof(color)~="Color3" then return false end
    object[property]=color
    if typeof(object)=="Instance" then pcall(function() object:SetAttribute("__VNCColorRole_"..property,"Custom") end) end
    return true
end

local function IsInsideThemePreview(object,root)
    local current=object
    while current and current~=root do
        if current:GetAttribute("__VNCThemePreview")==true then return true end
        current=current.Parent
    end
    return false
end

local function InvokeUserCallback(callback,...)
    if type(callback)~="function" then return false,"callback is not a function" end
    local thread=coroutine.running() or MainCallbackThread
    local active=ActiveCallbacksByThread[thread]
    if active and active[callback] then
        return false,"callback reentrancy suppressed"
    end
    active=active or {}
    ActiveCallbacksByThread[thread]=active
    active[callback]=true
    local result=table.pack(pcall(callback,...))
    active[callback]=nil
    if next(active)==nil then ActiveCallbacksByThread[thread]=nil end
    if not result[1] then
        local message="[VNC-Lib] User callback failed: "..tostring(result[2])
        warn(message)
        if type(L._callbackErrorHandler)=="function" then
            local handlerOk,handlerError=pcall(L._callbackErrorHandler,tostring(result[2]),callback)
            if not handlerOk then warn("[VNC-Lib] Callback error handler failed: "..tostring(handlerError)) end
        end
    end
    return table.unpack(result,1,result.n)
end

local ResourceBag = {}
ResourceBag.__index = ResourceBag

local function CleanupResource(resource)
    local kind=typeof(resource)
    local cleanup
    if type(resource)=="function" then cleanup=resource
    elseif kind=="RBXScriptConnection" then cleanup=function() resource:Disconnect() end
    elseif kind=="Instance" then cleanup=function() resource:Destroy() end
    elseif type(resource)=="thread" then cleanup=function() task.cancel(resource) end
    elseif type(resource)=="table" then
        local ok,method=pcall(function()
            for _,candidate in ipairs({"Disconnect","Cancel","Destroy","Stop","Close"}) do
                if type(resource[candidate])=="function" then return candidate end
            end
        end)
        if ok and method then cleanup=function() resource[method](resource) end end
    end
    if cleanup then pcall(cleanup) end
end

local function NewResourceBag()
    return setmetatable({_items={},_destroyed=false},ResourceBag)
end

function ResourceBag:Add(resource)
    if resource==nil then return nil end
    if self._destroyed then CleanupResource(resource); return resource end
    table.insert(self._items,resource)
    return resource
end

function ResourceBag:Remove(resource,cleanup)
    for i=#self._items,1,-1 do
        if self._items[i]==resource then
            table.remove(self._items,i)
            if cleanup then CleanupResource(resource) end
            return true
        end
    end
    return false
end

function ResourceBag:Destroy()
    if self._destroyed then return false end
    self._destroyed=true
    local items=self._items
    self._items={}
    for i=#items,1,-1 do CleanupResource(items[i]); items[i]=nil end
    return true
end

L.ResourceBag=ResourceBag

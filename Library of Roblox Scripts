function L:SetStorageProvider(provider,forceReload)
    if self._destroyed then return false,"library is destroyed" end
    if forceReload~=nil and type(forceReload)~="boolean" then return false,"forceReload must be a boolean" end
    if provider==self.StorageProvider and forceReload~=true then return true end
    local configured,configError=SetStorageProviderBase(self,provider)
    if not configured then return false,configError end

    self.Favorites=JsonRead("library_favorites.json",{})
    if type(self.Favorites)~="table" then self.Favorites={} end

    if type(self.Sounds)=="table" then
        self.Sounds.favorites=JsonRead("library_sound_favorites.json",{})
        if type(self.Sounds.favorites)~="table" then self.Sounds.favorites={} end
        local savedSlots=JsonRead("library_sound_slots.json",{})
        if type(savedSlots)~="table" then savedSlots={} end
        for _,slot in ipairs(DefaultSoundSlots) do
            local savedValue=savedSlots[slot]
            self.Sounds[slot]=savedValue~=nil and (NormalizeSoundId(savedValue) or "") or DefaultSoundSlotValues[slot]
        end
    end

    local savedScale=JsonRead("library_uiscale.json",DefaultUIScale)
    if type(savedScale)~="table" then savedScale=DefaultUIScale end
    local perScale=type(savedScale.per)=="table" and savedScale.per or {}
    local normalizedScale={global=ClampNumber(savedScale.global,1,0.5,2),per={}}
    for key,value in pairs(perScale) do
        if type(key)=="string" and key~="" then normalizedScale.per[key]=ClampNumber(value,1,0.5,2) end
    end
    self.UIScale=normalizedScale

    for name in pairs(self.Palettes or {}) do
        if not BuiltinPaletteNames[name] then self.Palettes[name]=nil end
    end
    local savedPalettes=JsonRead("library_custom_palettes.json",{})
    if type(savedPalettes)=="table" then
        for name,colors in pairs(savedPalettes) do
            if type(name)=="string" and name~="" and #name<=40 and type(colors)=="table" and not BuiltinPaletteNames[name] then
                local palette=ClonePalette(self.Palettes.Dark)
                for key,rgb in pairs(colors) do
                    local r,g,b=type(rgb)=="table" and tonumber(rgb[1]),type(rgb)=="table" and tonumber(rgb[2]),type(rgb)=="table" and tonumber(rgb[3])
                    if palette[key]~=nil and type(rgb)=="table" and #rgb==3 and r and g and b then
                        palette[key]=Color3.fromRGB(math.clamp(r,0,255),math.clamp(g,0,255),math.clamp(b,0,255))
                    end
                end
                self.Palettes[name]=palette
            end
        end
    end

    local localeData=JsonRead("library_locale.json",{code="en"})
    local localeCode=type(localeData)=="table" and localeData.code or nil
    self.Locale=type(localeCode)=="string" and self.Locales[localeCode] and localeCode or "en"
    if self.Theme=="Animated" then
        if not self.Palettes[self.ThemeBase] then self:SetTheme("Light") end
    elseif not self.Palettes[self.Theme] then
        self:SetTheme("Light")
    elseif self.Theme~="Custom" then
        self:SetTheme(self.Theme)
    end

    for id,record in pairs(self._favoriteItems or {}) do
        local element=record and record.Element
        if element and type(element.SetFavorite)=="function" then element:SetFavorite(self.Favorites[id]==true) end
    end
    for _,window in ipairs(self._allWindows or {}) do
        if window and not window._destroyed then window:_ApplyUIScale() end
    end
    if type(self._ApplyLocale)=="function" then self:_ApplyLocale() end
    if type(self.Emit)=="function" then self:Emit("SoundSettingsChanged",{Enabled=self.Sounds.enabled,Silent=self.Sounds.silent,Volume=self.Sounds.volume}) end
    if type(self.Emit)=="function" then self:Emit("StorageProviderChanged",type(provider)=="table") end
    if type(self.RefreshCapabilities)=="function" then self:RefreshCapabilities() end
    return true
end


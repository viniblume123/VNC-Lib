            end
        end
        self._main.BackgroundColor3 = c.Bg
        self._main.BackgroundTransparency = self._lib.Config.Transparency or 0
        self._gradient.Color = ColorSequence.new(c.Bg, c.Surface)
        self._gradient.Transparency = NumberSequence.new(0.05)
        self._sidebar.BackgroundColor3 = c.Surface
        self._mainStroke.Color = c.Stroke
        self._shadow.BackgroundColor3 = c.Overlay
        self._title.TextColor3 = c.Text
        self._sub.TextColor3 = c.TextFaint
        self._accentStrip.BackgroundColor3 = c.Accent
        self._logo.BackgroundColor3 = c.Accent
        self._statusL.TextColor3 = c.TextFaint
        self._statusR.TextColor3 = c.TextFaint
        local root = self._main
        if old then
            for _, obj in ipairs(root:GetDescendants()) do
                if obj:IsA("GuiObject") then
                    local bg = obj.BackgroundColor3
                    local mapped = nil
                    for key, value in pairs(old) do
                        if typeof(value) == "Color3" and bg == value and c[key] then mapped = c[key]; break end
                    end
                    if mapped then obj.BackgroundColor3 = mapped end
                end
                if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                    local tc = obj.TextColor3
                    for key, value in pairs(old) do
                        if typeof(value) == "Color3" and tc == value and c[key] then obj.TextColor3 = c[key]; break end
                    end
                end
                if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
                    local ic = obj.ImageColor3
                    for key, value in pairs(old) do
                        if typeof(value) == "Color3" and ic == value and c[key] then obj.ImageColor3 = c[key]; break end
                    end
                end
                if obj:IsA("UIStroke") then
                    local sc = obj.Color
                    for key, value in pairs(old) do
                        if typeof(value) == "Color3" and sc == value and c[key] then obj.Color = c[key]; break end
                    end
                end
            end
        end
        for _, obj in ipairs(root:GetDescendants()) do
            if obj:IsA("GuiObject") then
                if obj:GetAttribute("__VNCBaseTransparency") == nil then obj:SetAttribute("__VNCBaseTransparency",obj.BackgroundTransparency) end
                local base = obj:GetAttribute("__VNCBaseTransparency")
                obj.BackgroundTransparency = math.clamp(base + (self._lib.Config.Transparency or 0) * (1-base),0,1)
            end
        end
        self._accentTargetsDirty = true
    end
    function Win:_ApplyAccent(oldAccent, newAccent, newSoft, oldSoft)
        local c = self._lib.C
        oldAccent = oldAccent or c.Accent
        newAccent = newAccent or c.Accent
        newSoft = newSoft or c.AccentSoft
        for _, tab in ipairs(self._tabs) do
            if not tab._ownTheme then tab.C=ClonePalette(c) end
            if tab._ownAccent then tab.C.Accent=tab._ownAccent; tab.C.StrokeHot=tab._ownAccent; tab.C.AccentSoft=tab._ownAccent:Lerp(Color3.new(0,0,0),0.35) end
            for _, section in ipairs(tab._sections) do section.C=tab.C end
        end
        self._accentStrip.BackgroundColor3 = newAccent
        self._logo.BackgroundColor3 = newAccent
        if self._accentTargetsDirty or not self._accentTargets then
            local targets={}
            local function add(obj,property,role)
                local value=obj[property]
                local matches=(role=="soft" and oldSoft and value==oldSoft) or (role=="accent" and value==oldAccent)
                if matches then
                    table.insert(targets,{Object=obj,Property=property,Role=role})
                end
            end
            for _, obj in ipairs(self._main:GetDescendants()) do
                if obj:IsA("GuiObject") then add(obj,"BackgroundColor3","accent"); add(obj,"BackgroundColor3","soft") end
                if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then add(obj,"TextColor3","accent") end
                if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then add(obj,"ImageColor3","accent") end
                if obj:IsA("UIStroke") then add(obj,"Color","accent") end
            end
            self._accentTargets=targets
            self._accentTargetsDirty=false
        end
        for _, target in ipairs(self._accentTargets) do
            if target.Object and target.Object.Parent then target.Object[target.Property]=target.Role=="soft" and newSoft or newAccent end
        end
    end

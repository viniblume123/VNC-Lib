local function SnapToEdge(Frame, File)
    local cam = workspace.CurrentCamera
    if not cam then return end
    local vp = cam.ViewportSize
    local pos = Frame.AbsolutePosition
    local sz = Frame.AbsoluteSize
    local th = 30
    local scale = 1
    local node = Frame.Parent
    while node do
        local uiScale = node:FindFirstChildOfClass("UIScale")
        if uiScale then scale = math.max(uiScale.Scale, 0.01); break end
        node = node.Parent
    end
    local nx, ny = Frame.Position.X.Offset, Frame.Position.Y.Offset
    if pos.X < th then nx = nx + ((th - pos.X) + 8)/scale
    elseif pos.X + sz.X > vp.X - th then nx = nx - (((pos.X + sz.X) - (vp.X - th)) + 8)/scale end
    if pos.Y < th then ny = ny + ((th - pos.Y) + 8)/scale
    elseif pos.Y + sz.Y > vp.Y - th then ny = ny - (((pos.Y + sz.Y) - (vp.Y - th)) + 8)/scale end
    Frame.Position = UDim2.new(Frame.Position.X.Scale, nx, Frame.Position.Y.Scale, ny)
    if File then JsonWrite(File, {xs=Frame.Position.X.Scale, x=nx, ys=Frame.Position.Y.Scale, y=ny}) end
end


local function ResolveWindow(owner,requested)
    if requested then
        if type(requested)=="table" and typeof(requested._main)=="Instance" and requested._main:IsA("GuiObject") and requested._lib then return requested end
        return nil
    end
    if type(owner)=="table" and owner._main and owner._lib then return owner end
    if type(owner)~="table" then return nil end
    local lib=owner and (owner._lib or owner)
    local candidate=(owner and owner._window) or (type(lib)=="table" and lib._window)
    return type(candidate)=="table" and candidate or nil
end

local function RemoveGuiReference(list,gui)
    if type(list)~="table" then return end
    local index=table.find(list,gui); if index then table.remove(list,index) end
end
local function TrackAuxGui(lib,win,gui)
    if typeof(gui)~="Instance" or not gui:IsA("ScreenGui") then return false end
    local rootLib=type(lib)=="table" and (lib._lib or lib) or nil
    local ownerWindow=win or ResolveWindow(lib)
    if rootLib then rootLib._auxGuis=rootLib._auxGuis or {}; table.insert(rootLib._auxGuis,gui) end
    if ownerWindow then
        ownerWindow._auxGuis=ownerWindow._auxGuis or {}; table.insert(ownerWindow._auxGuis,gui)
        ownerWindow._accentTargetsDirty=true
        gui.DescendantAdded:Connect(function() ownerWindow._accentTargetsDirty=true end)
    end
    local removed=false
    local function removeReferences()
        if removed then return end
        removed=true
        RemoveGuiReference(rootLib and rootLib._auxGuis,gui)
        RemoveGuiReference(ownerWindow and ownerWindow._auxGuis,gui)
        if ownerWindow then ownerWindow._accentTargetsDirty=true end
    end
    gui.Destroying:Connect(removeReferences)
    gui.AncestryChanged:Connect(function(_,parent) if parent==nil then removeReferences() end end)
    return true
end
local function DestroyAuxGui(lib,win,gui)
    local rootLib=type(lib)=="table" and (lib._lib or lib) or nil
    local ownerWindow=win or ResolveWindow(lib)
    RemoveGuiReference(rootLib and rootLib._auxGuis,gui); RemoveGuiReference(ownerWindow and ownerWindow._auxGuis,gui)
    if gui and gui.Parent then gui:Destroy() end
end


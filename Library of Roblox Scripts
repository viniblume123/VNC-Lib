        for _, c in ipairs(playersFrame:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
        local list = PlayerSvc.GetList()
        for i, p in ipairs(list) do
            local row = New("Frame", {Size=UDim2.new(1,0,0,40), BackgroundColor3=C.Card, BorderSizePixel=0, LayoutOrder=i, Parent=playersFrame})
            Corner(row, 8)
            local avatar = New("ImageLabel", {Size=UDim2.fromOffset(28,28), Position=UDim2.fromOffset(8,6), BackgroundColor3=C.Surface, BorderSizePixel=0, Parent=row})
            Corner(avatar, 14)
            pcall(function()
                avatar.Image = Players:GetUserThumbnailAsync(p.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
            end)
            New("TextLabel", {Size=UDim2.new(1,-100,1,0), Position=UDim2.fromOffset(44,0), BackgroundTransparency=1, Text=p.DisplayName.." (@"..p.Name..")", Font=Enum.Font.Gotham, TextSize=11, TextColor3=C.Text, TextXAlignment=Enum.TextXAlignment.Left, Parent=row})
            local copyBtn = New("TextButton", {Size=UDim2.fromOffset(40,26), Position=UDim2.new(1,-48,0.5,-13), BackgroundColor3=C.Surface, Text="ID", TextColor3=C.TextDim, Font=Enum.Font.GothamBold, TextSize=10, BorderSizePixel=0, Parent=row})
            Corner(copyBtn, 6)
            copyBtn.MouseButton1Click:Connect(function()
                if CLIP then pcall(CLIP, tostring(p.UserId)) end
                Athic:Notify({Title="Copiado", Text=tostring(p.UserId), Type="success", Duration=2})
            end)
        end
    end
    refresh()
    Players.PlayerAdded:Connect(function() task.wait(0.2); refresh() end)
    Players.PlayerRemoving:Connect(function() task.wait(0.2); refresh() end)
    
    return {Instance=sec._inner}
end

--============================================================
-- AUTO-SETUP: criar abas de sistema
--============================================================
function Athic:CreateSystemTabs(win)
    local favTab = win:CreateTab({Name="★ Favoritos"})
    win:CreateTab({Name="★ Abas Favoritas"})
    local playersTab = win:CreateTab({Name="👥 Players"})
    local settingsTab = win:CreateTab({Name="⚙ Configurações"})
    win:CreateTab({Name="🔌 Plugins"})
    
    -- Favorites refresh
    local favSec = favTab:CreateSection({Name="Elementos Favoritados"})
    local function refreshFavs()
        for _, c in ipairs(favSec._inner:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
        local count = 0
        for id, _ in pairs(Favorites._items) do
            count = count + 1
            favSec:CreateLabel({Text="★ "..id})
        end
        if count == 0 then favSec:CreateLabel({Text="Nenhum favorito ainda"}) end
    end
    refreshFavs()
    Favorites._sig:Connect(function() refreshFavs() end)
    
    -- Player panel
    self:CreatePlayerPanel(playersTab)
    
    -- Settings: theme + config
    self:CreateThemePicker(settingsTab)
    self:CreateConfigPanel(settingsTab)
    
    return {Favorites=favTab, Players=playersTab, Settings=settingsTab}
end


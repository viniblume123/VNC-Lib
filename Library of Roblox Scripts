    ElementSections[frame]=Sec
    local searchTab=directTab and Sec or Sec._tab
    frame.Destroying:Connect(function()
        local index=table.find(Sec._elements or {},frame)
        if index then
            table.remove(Sec._elements,index)
            local stillDirect=not (Sec._inner or Sec._holder) and Sec._frame and Sec._window and type(Sec._sections)=="table"
            if not stillDirect then
                for order,element in ipairs(Sec._elements) do
                    if element and element.Parent then element.LayoutOrder=order end
                end
            end
        end
        if ElementSections[frame]==Sec then ElementSections[frame]=nil end
        if searchTab and not searchTab._destroyed and not Sec._destroyed and searchTab._searchRefresh then pcall(searchTab._searchRefresh) end
        if Sec._lib then Sec._lib:Emit("ElementDestroyed",frame,Sec) end
    end)
    if Sec._lib then Sec._lib:Emit("ElementCreated",frame,Sec) end
    if searchTab and searchTab._searchRefresh then pcall(searchTab._searchRefresh) end
    return frame
end

function L:CreateTooltip(target, text, cfg)
    cfg=type(cfg)=="table" and table.clone(cfg) or {}

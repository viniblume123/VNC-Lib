            OB.MouseLeave:Connect(function() if not IsSelected(o) then TweenService:Create(OB, T_OUT, {BackgroundColor3=C.Card}):Play() end end)
            OB.MouseButton1Click:Connect(function()
                if multi then
                    local found = false

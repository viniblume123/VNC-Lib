    layout.HorizontalAlignment=Enum.HorizontalAlignment.Left; layout.VerticalAlignment=Enum.VerticalAlignment.Top
    layout.Padding=UDim.new(0,gap); layout.SortOrder=Enum.SortOrder.LayoutOrder; layout.Parent=root
    local columns={}
    for index=1,count do
        local column=Instance.new("Frame")
        column.Name="GroupColumn"..index

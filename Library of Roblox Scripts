local Http = {}
function Http.Request(method, url, body, headers)
    method = (method or "GET"):upper()
    if REQ then
        local ok, r = pcall(REQ, {Url=url, Method=method, Body=body, Headers=headers or {}})
        if ok and type(r) == "table" then return true, {Body=r.Body or "", StatusCode=r.StatusCode or 200} end
    end
    if method == "GET" and type(game.HttpGet) == "function" then
        local ok, r = pcall(game.HttpGet, game, url)
        if ok then return true, {Body=r, StatusCode=200} end
    end
    local ok, r = pcall(HttpService.RequestAsync, HttpService, {Url=url, Method=method, Body=body, Headers=headers or {}})
    if ok then return true, {Body=r.Body, StatusCode=r.StatusCode} end
    return false, "http failed"
end

--============================================================
-- SERIALIZER (para Color3, UDim2, etc.)
--============================================================
local Ser = {}
function Ser.Encode(v, seen, d)
    seen = seen or {}; d = d or 0
    if d >= 32 then return nil end
    local t = typeof(v)
    if t == "Color3" then return {__t="C3", r=v.R, g=v.G, b=v.B} end
    if t == "UDim2" then return {__t="U2", xs=v.X.Scale, xo=v.X.Offset, ys=v.Y.Scale, yo=v.Y.Offset} end
    if t == "UDim" then return {__t="UD", s=v.Scale, o=v.Offset} end
    if t == "Vector2" then return {__t="V2", x=v.X, y=v.Y} end
    if t == "Vector3" then return {__t="V3", x=v.X, y=v.Y, z=v.Z} end
    if t == "EnumItem" then return {__t="EN", e=v.EnumType.Name, n=v.Name} end
    if t == "table" then
        if seen[v] then return nil end
        seen[v] = true
        local o = {}
        for k, val in pairs(v) do
            local e = Ser.Encode(val, seen, d + 1)
            if e ~= nil then o[k] = e end
        end
        seen[v] = nil
        return o
    end
    if t == "number" then
        if v ~= v or v == math.huge or v == -math.huge then return nil end
        return v
    end
    if t == "string" or t == "boolean" or t == "nil" then return v end
    return nil
end
function Ser.Decode(v)
    if type(v) ~= "table" then return v end
    local tag = v.__t
    if tag == "C3" then return Color3.new(v.r, v.g, v.b) end
    if tag == "U2" then return UDim2.new(v.xs, v.xo, v.ys, v.yo) end
    if tag == "UD" then return UDim.new(v.s, v.o) end
    if tag == "V2" then return Vector2.new(v.x, v.y) end
    if tag == "V3" then return Vector3.new(v.x, v.y, v.z) end
    if tag == "EN" then local e = Enum[v.e]; return e and e[v.n] or nil end
    local o = {}
    for k, val in pairs(v) do o[k] = Ser.Decode(val) end
    return o
end

--============================================================
-- STATE
--============================================================
local State = {_f = {}}
function State.Register(flag, getter, setter) State._f[flag] = {Get=getter, Set=setter} end
function State.Get(flag) local f = State._f[flag]; return f and f.Get and f.Get() end
function State.Set(flag, v, silent) local f = State._f[flag]; if f and f.Set then pcall(f.Set, v, silent) end end
function State.Capture()
    local d = {}
    for flag, f in pairs(State._f) do
        if f.Get then local ok, v = pcall(f.Get); if ok then d[flag] = v end end
    end
    return d
end
function State.Restore(d)
    if type(d) ~= "table" then return end
    for flag, v in pairs(d) do
        local f = State._f[flag]
        if f and f.Set then pcall(f.Set, v, true) end
    end
end


    Bar.BorderSizePixel = 0
    Bar.Parent = Wrapped
    local Bc = Instance.new("UICorner"); Bc.CornerRadius = UDim.new(1,0); Bc.Parent = Bar
    local Fill = Instance.new("Frame")
    Fill.Size = UDim2.new((val-min)/(max-min),0,1,0)
    Fill.BackgroundColor3 = fillColor
    Fill.BorderSizePixel = 0
    Fill.Parent = Bar
    local Fc = Instance.new("UICorner"); Fc.CornerRadius = UDim.new(1,0); Fc.Parent = Fill
    local Thumb = Instance.new("Frame")
    Thumb.Size = UDim2.new(0, 14, 0, 14)
    Thumb.Position = UDim2.new((val-min)/(max-min), -7, 0.5, -7)
    Thumb.BackgroundColor3 = C.White
    Thumb.BorderSizePixel = 0
    Thumb.Parent = Bar
    local Tc = Instance.new("UICorner"); Tc.CornerRadius = UDim.new(1,0); Tc.Parent = Thumb
    local Ts = Instance.new("UIStroke"); Ts.Color = fillColor; Ts.Thickness = 2; Ts.Parent = Thumb
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1,0,1,0)
    Btn.BackgroundTransparency = 1
    Btn.Text = ""
    Btn.Parent = Bar
    local function SetFromClick(x)
        local abs = Bar.AbsolutePosition.X
        local sz = Bar.AbsoluteSize.X
        local t = math.clamp((x - abs) / sz, 0, 1)
        val = min + (max - min) * t
        if cfg.Round then val = math.floor(val + 0.5) end
        ValL.Text = tostring(val)..(cfg.Suffix or "")
        TweenService:Create(Fill, T_FAST, {Size=UDim2.new(t,0,1,0)}):Play()
        TweenService:Create(Thumb, T_FAST, {Position=UDim2.new(t,-7,0.5,-7)}):Play()
        if cfg.Callback then pcall(cfg.Callback, val) end
    end
    Btn.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            SetFromClick(i.Position.X)
        end
    end)
    Btn.InputChanged:Connect(function(i)
        if (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch)
            and i.UserInputState == Enum.UserInputState.Change
            and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
            SetFromClick(i.Position.X)
        end
    end)
    local Element = {Instance=Wrapped, Value=val, _label=Lb}
    function Element:Set(v)
        val = math.clamp(v, min, max)
        local t = (val-min)/(max-min)
        ValL.Text = tostring(val)..(cfg.Suffix or "")
        TweenService:Create(Fill, T_FAST, {Size=UDim2.new(t,0,1,0)}):Play()
        TweenService:Create(Thumb, T_FAST, {Position=UDim2.new(t,-7,0.5,-7)}):Play()
    end
    function Element:SetColor(c)
        fillColor = c
        ValL.TextColor3 = c
        Fill.BackgroundColor3 = c
        Ts.Color = c
    end
    function Element:Get() return val end
    function Element:Destroy() Wrapped:Destroy() end
    Sec:_AddElement(Wrapped)
    if cfg.Callback then pcall(cfg.Callback, val) end
    return Element
end

function L:CreateRangeSlider(cfg)
    local Sec = self
    local C = Sec._window.C
    cfg = cfg or {}
    local min, max = cfg.Min or 0, cfg.Max or 100
    local v1 = cfg.DefaultMin or min
    local v2 = cfg.DefaultMax or max
    local fillColor = cfg.FillColor or C.Accent
    local Wrapped = Instance.new("Frame")
    Wrapped.Size = UDim2.new(1,0,0,64)
    Wrapped.BackgroundColor3 = C.Card
    Wrapped.BorderSizePixel = 0
    Wrapped.Parent = Sec._inner or Sec._holder
    local Wc = Instance.new("UICorner"); Wc.CornerRadius = UDim.new(0,10); Wc.Parent = Wrapped
    local Ws = Instance.new("UIStroke"); Ws.Color = C.Stroke; Ws.Thickness = 1; Ws.Transparency = 0.4; Ws.Parent = Wrapped

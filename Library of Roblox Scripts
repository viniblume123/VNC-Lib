    Lp.Parent = List
    local Ll = Instance.new("UIListLayout")
    Ll.Padding = UDim.new(0,3)
    Ll.SortOrder = Enum.SortOrder.LayoutOrder
    Ll.Parent = List
    local function IsSelected(v)
        if multi then
            for _, x in ipairs(selected) do if x == v then return true end end
            return false
        end
        return selected == v
    end
    local function Refresh()
        for _, c in ipairs(List:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        for i, o in ipairs(opts) do
            local OB = Instance.new("TextButton")
            OB.Size = UDim2.new(1,0,0,28)
            OB.BackgroundColor3 = IsSelected(o) and C.AccentSoft or C.Card
            OB.Text = tostring(o)
            OB.TextColor3 = IsSelected(o) and C.White or C.Text
            OB.Font = Enum.Font[Sec._lib.CurrentFont]
            OB.TextSize = 12
            OB.BorderSizePixel = 0
            OB.AutoButtonColor = false
            OB.LayoutOrder = i
            OB.TextXAlignment = Enum.TextXAlignment.Left
            OB.ZIndex = 501
            OB.Parent = List
            local Oc = Instance.new("UICorner"); Oc.CornerRadius = UDim.new(0,6); Oc.Parent = OB
            local Op = Instance.new("UIPadding"); Op.PaddingLeft = UDim.new(0,10); Op.Parent = OB
            OB.MouseEnter:Connect(function() if not IsSelected(o) then TweenService:Create(OB, T_OUT, {BackgroundColor3=C.CardHover}):Play() end end)
            OB.MouseLeave:Connect(function() if not IsSelected(o) then TweenService:Create(OB, T_OUT, {BackgroundColor3=C.Card}):Play() end end)
            OB.MouseButton1Click:Connect(function()
                if multi then
                    local found = false
                    for i, x in ipairs(selected) do if x == o then table.remove(selected, i); found = true; break end end
                    if not found then table.insert(selected, o) end
                    ValL.Text = #selected .. " sel."
                    if cfg.Callback then pcall(cfg.Callback, selected) end
                else
                    selected = o
                    ValL.Text = tostring(o)
                    List.Visible = false
                    if cfg.Callback then pcall(cfg.Callback, o) end
                end
                Refresh()
            end)
        end
    end
    Refresh()
    Btn.MouseButton1Click:Connect(function()
        List.Visible = not List.Visible
        TweenService:Create(Arrow, T_OUT, {Rotation=List.Visible and 180 or 0}):Play()
    end)
    local Element = {Instance=Wrapped}
    function Element:Set(v) selected = v; ValL.Text = tostring(v); Refresh() end
    function Element:Get() return selected end
    function Element:Destroy() Wrapped:Destroy() end
    Sec:_AddElement(Wrapped)
    return Element
end


function L:PlayTransitionCombo(transitionName, effectNames, target, direction, cfg)
    cfg = type(cfg)=="table" and cfg or {}
    if typeof(target)~="Instance" or not target:IsA("GuiObject") then return false end
    local ok = self:PlayTransition(transitionName,target,direction or "in",cfg.TransitionConfig)
    if ok~=true then return false end
    local names = type(effectNames) == "table" and effectNames or {}
    local maxEffects=math.floor(ClampNumber(cfg.MaxEffects,3,0,20))
    local stagger=ClampNumber(cfg.Stagger,0.08,0,2)
    for i=1,math.min(#names,maxEffects) do
        local name = names[i]
        local effectConfigs=type(cfg.EffectConfigs)=="table" and cfg.EffectConfigs or {}
        local effectCfg=effectConfigs[i] or effectConfigs[name] or cfg.EffectConfig
        task.delay(stagger * (i-1), function()
            if target.Parent then
                self:PlayEffect(name,target,type(effectCfg)=="table" and effectCfg or {})
            end
        end)
    end
    return true
end

function L:PlayTransitionKit(name, target, direction, cfg)
    local kit = self.TransitionKits[name]
    if not kit then return false end
    return self:PlayTransitionCombo(kit.Transition,kit.Effects,target,direction,cfg)
end

function L:GetEffectNames()
    local names={}; for name in pairs(self.Effects.List or {}) do table.insert(names,name) end; table.sort(names); return names
end
function L:GetTransitionNames()
    local names={}; for name in pairs(self.Transitions.List or {}) do table.insert(names,name) end; table.sort(names); return names
end
function L:RegisterEffect(name,def)
    if type(name)~="string" or name:gsub("%s","")=="" or type(def)~="table" then return false,"effect name and definition required" end
    local copy=table.clone(def)
    copy.minS=math.floor(ClampNumber(copy.minS,4,1,500)); copy.maxS=math.floor(ClampNumber(copy.maxS,copy.minS,1,500))
    if copy.maxS<copy.minS then copy.minS,copy.maxS=copy.maxS,copy.minS end
    copy.dur=ClampNumber(copy.dur,1,0.05,30)
    if copy.color~=nil and typeof(copy.color)~="Color3" then return false,"effect color must be a Color3" end
    self.Effects.List[name]=copy
    return true
end
function L:RegisterEffectCategory(name,list)
    if type(name)~="string" or name:gsub("%s","")=="" or type(list)~="table" then return false,"category name and effect list required" end
    local categories={}; for _,effectName in ipairs(list) do if type(effectName)=="string" and self.Effects.List[effectName] then table.insert(categories,effectName) end end
    self.Effects.Categories=self.Effects.Categories or {}; self.Effects.Categories[name]=categories
    return true
end
function L:RemoveEffect(name)
    if not self.Effects.List[name] then return false end
    self.Effects.List[name]=nil
    for _,category in pairs(self.Effects.Categories or {}) do for i=#category,1,-1 do if category[i]==name then table.remove(category,i) end end end
    return true
end
function L:RegisterTransition(name,def)
    if type(name)~="string" or name:gsub("%s","")=="" or type(def)~="table" then return false,"transition name and definition required" end
    local copy=table.clone(def); copy.dur=ClampNumber(copy.dur,0.4,0.05,30)
    if copy.offset~=nil and typeof(copy.offset)~="UDim2" then return false,"transition offset must be UDim2" end
    if copy.scale~=nil and typeof(copy.scale)~="UDim2" then return false,"transition scale must be UDim2" end
    if copy.rotation~=nil and not tonumber(copy.rotation) then return false,"transition rotation must be numeric" end
    copy.rotation=ClampNumber(copy.rotation,0,-3600,3600)
    if copy.style~=nil and (typeof(copy.style)~="EnumItem" or copy.style.EnumType~=Enum.EasingStyle) then return false,"transition style must be an EasingStyle" end
    if copy.dir~=nil and (typeof(copy.dir)~="EnumItem" or copy.dir.EnumType~=Enum.EasingDirection) then return false,"transition direction must be an EasingDirection" end
    self.Transitions.List[name]=copy
    return true
end
function L:RemoveTransition(name)
    if not self.Transitions.List[name] then return false end
    self.Transitions.List[name]=nil
    return true
end

local DefaultUIScale={global=1,per={}}
L.UIScale = JsonRead("library_uiscale.json", DefaultUIScale)
local uiScaleSaveToken=0

function L:SetUIScale(value, key)
    self.UIScale = type(self.UIScale) == "table" and self.UIScale or {global=1,per={}}
    self.UIScale.per = type(self.UIScale.per) == "table" and self.UIScale.per or {}
    value = ClampNumber(value,1,0.5,2)
    if key then self.UIScale.per[key] = value else self.UIScale.global = value end
    uiScaleSaveToken+=1
    local saveToken=uiScaleSaveToken
    task.delay(0.25,function()
        if saveToken==uiScaleSaveToken then JsonWrite("library_uiscale.json", self.UIScale) end
    end)
    for _, win in ipairs(self._allWindows or {}) do if win and not win._destroyed then win:_ApplyUIScale() end end
    return value
end

function L:GetUIScale(key)
    self.UIScale = type(self.UIScale) == "table" and self.UIScale or {global=1,per={}}
    self.UIScale.per = type(self.UIScale.per) == "table" and self.UIScale.per or {}
    if key and self.UIScale.per[key] then return self.UIScale.per[key] end
    return self.UIScale.global or 1
end

L.StreamerMode = false

function L:SetStreamerMode(on)
    local lib=self._lib or self
    on=on==true
    lib.StreamerMode=on
    for _,win in ipairs(lib._allWindows or {}) do
        if win and not win._destroyed then
            if on then
                if not win._streamerSavedSize and win._main and win._main.Parent then win._streamerSavedSize=win._main.Size end
                if win._statusL then win._statusL.Text=tostring(win._streamerStatusText or "Streamer Mode") end
                if win._main and win._main.Parent then win._main.Size=UDim2.new(0,820,0,500) end
            else
                if win._statusL then win._statusL.Text=tostring(win._statusBaseText) end
                if win._main and win._main.Parent and win._streamerSavedSize then win._main.Size=win._streamerSavedSize end
                win._streamerSavedSize=nil
            end
            for _,tab in ipairs(win._tabs or {}) do if tab._btnLabel then tab._btnLabel.TextSize=on and 14 or 12 end end
            if win._userInfoCard and win._userInfoCard.Refresh then win._userInfoCard:Refresh() end
        end
    end
    return on
end


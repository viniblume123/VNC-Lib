        if inputEnabled and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch)
            and pointerDragging and (i.UserInputType==Enum.UserInputType.Touch or UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)) then

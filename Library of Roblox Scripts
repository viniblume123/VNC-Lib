function L:PlayEffect(name, parent, cfg)
    local def = self.Effects.List[name]
    if not def then return end
    cfg = cfg or {}
    local color = cfg.Color or def.color
    local count = cfg.Count or 20
    local is3D = cfg.World3D or false
    for i = 1, count do
        task.spawn(function()
            task.wait(math.random() * 0.15)
            local sz = math.random(def.minS, def.maxS) / 100
            if is3D then
                if not parent or not parent.CFrame then return end
                local p = Instance.new("Part")
                p.Size = Vector3.new(sz, sz, sz)
                p.Shape = Enum.PartType.Ball
                p.Material = Enum.Material.Neon
                p.Color = color
                p.CanCollide = false
                p.Anchored = false
                p.CFrame = parent.CFrame * CFrame.new((math.random()-0.5)*4, math.random()*3, (math.random()-0.5)*4)
                p.Parent = workspace
                local bv = Instance.new("BodyVelocity")
                bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bv.Velocity = Vector3.new((math.random()-0.5)*8, math.random(8,15), (math.random()-0.5)*8)
                bv.Parent = p
                task.delay(def.dur, function() if bv then bv:Destroy() end end)
                task.delay(def.dur + 0.1, function() if p and p.Parent then p:Destroy() end end)
            else
                if not parent or not parent.Parent then return end
                local f = Instance.new("Frame")
                f.Size = UDim2.new(0, sz, 0, sz)
                f.Position = cfg.From or UDim2.new(math.random(), 0, 0.8, 0)
                f.BackgroundColor3 = color
                f.BorderSizePixel = 0
                f.ZIndex = 500
                f.Parent = parent
                local fc = Instance.new("UICorner")
                fc.CornerRadius = UDim.new(1, 0)
                fc.Parent = f
                local tY = cfg.ToY or -0.1
                local tX = cfg.ToX or (f.Position.X.Scale + (math.random()-0.5)*0.3)
                TweenService:Create(f, TweenInfo.new(def.dur, S.Quart, D.Out), {
                    Position = UDim2.new(tX, 0, tY, 0),
                    BackgroundTransparency = 1,
                    Size = UDim2.new(0, sz*0.3, 0, sz*0.3)
                }):Play()
                task.delay(def.dur + 0.2, function() if f.Parent then f:Destroy() end end)
            end
        end)
    end
end

function L:PlayTransition(name, target, direction)
    local def = self.Transitions.List[name]
    if not def or not target then return end
    if not target:GetAttribute("__HomePos") then
        target:SetAttribute("__HomePos", target.Position)
        target:SetAttribute("__HomeSize", target.Size)
    end
    local home = target:GetAttribute("__HomePos")
    local homeSize = target:GetAttribute("__HomeSize")
    if direction == "in" then
        target.Position = home
        target.Size = homeSize
        target.Rotation = 0
        if target:IsA("CanvasGroup") then target.GroupTransparency = 1 end
        local sp, ss, sr = home, homeSize, 0
        if def.offset then sp = UDim2.new(home.X.Scale+def.offset.X.Scale, home.X.Offset, home.Y.Scale+def.offset.Y.Scale, home.Y.Offset) end
        if def.scale then ss = UDim2.new(homeSize.X.Scale+def.scale.X.Scale, homeSize.X.Offset, homeSize.Y.Scale+def.scale.Y.Scale, homeSize.Y.Offset) end
        if def.rotation then sr = def.rotation end
        target.Position = sp; target.Size = ss; target.Rotation = sr
        local info = TweenInfo.new(def.dur, def.style, def.dir)
        TweenService:Create(target, info, {Position=home, Size=homeSize, Rotation=0}):Play()
        if target:IsA("CanvasGroup") then TweenService:Create(target, info, {GroupTransparency=0}):Play() end
    else
        local ep, es, er = home, homeSize, 0
        if def.offset then ep = UDim2.new(home.X.Scale+def.offset.X.Scale, home.X.Offset, home.Y.Scale+def.offset.Y.Scale, home.Y.Offset) end
        if def.scale then es = UDim2.new(homeSize.X.Scale+def.scale.X.Scale, homeSize.X.Offset, homeSize.Y.Scale+def.scale.Y.Scale, homeSize.Y.Offset) end
        if def.rotation then er = def.rotation end
        local info = TweenInfo.new(def.dur*0.8, def.style, D.In)
        TweenService:Create(target, info, {Position=ep, Size=es, Rotation=er}):Play()
        if target:IsA("CanvasGroup") then TweenService:Create(target, info, {GroupTransparency=1}):Play() end
        task.delay(def.dur+0.3, function()
            if target and target.Parent then
                target.Position = home
                target.Size = homeSize
                target.Rotation = 0
            end
        end)
    end
end


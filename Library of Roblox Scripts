    local text=tostring(id):gsub("^%s+",""):gsub("%s+$","")
    local digits=text:match("^(%d+)$") or text:match("^rbxassetid://(%d+)$")
    if not digits or #digits>20 or tonumber(digits)==0 then return nil end
    return "rbxassetid://"..digits
end


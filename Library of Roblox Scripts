        Indicator.Parent = Wrapped
        local Ic = Instance.new("UICorner"); Ic.CornerRadius = UDim.new(1,0); Ic.Parent = Indicator
    end
    local function RefreshVisual()
        if not cfg.Active then return end
        local ok, res = pcall(cfg.Active)
        local on = ok and res
        if on then
            TweenService:Create(Indicator, T_OUT, {BackgroundColor3=C.Success}):Play()
            TweenService:Create(Wrapped, T_OUT, {BackgroundColor3=C.SuccessBg}):Play()
        else
            TweenService:Create(Indicator, T_OUT, {BackgroundColor3=C.TextFaint}):Play()
            TweenService:Create(Wrapped, T_OUT, {BackgroundColor3=C.Card}):Play()
        end
    end
    if cfg.Active then
        task.spawn(function()
            while Wrapped.Parent do
                RefreshVisual()
                task.wait(0.3)
            end
        end)
    end
    Btn.MouseEnter:Connect(function()
        TweenService:Create(Wrapped, T_OUT, {BackgroundColor3=C.CardHover}):Play()
        TweenService:Create(Ws, T_OUT, {Color=C.StrokeHot, Transparency=0.2}):Play()

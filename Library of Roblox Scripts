    function Win:_ApplyFont()
        local f, fb, fm = self._lib.CurrentFont, self._lib.CurrentFontBold, self._lib.CurrentFontMedium
        local previous=self._fontPalette or {Regular=f,Bold=fb,Medium=fm}
        local roots={self._main}
        for _,gui in ipairs(self._auxGuis or {}) do if gui and gui.Parent then table.insert(roots,gui) end end
        for _,root in ipairs(roots) do
            for _, obj in ipairs(root:GetDescendants()) do
                if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                    local role=obj:GetAttribute("__VNCFontRole")
                    if not role then
                        if obj.Font==Enum.Font[previous.Bold] then role="Bold"
                        elseif obj.Font==Enum.Font[previous.Medium] then role="Medium"
                        elseif obj.Font==Enum.Font[previous.Regular] then role="Regular" end
                        if role then obj:SetAttribute("__VNCFontRole",role) end
                    end
                    if role=="Bold" then obj.Font=Enum.Font[fb]
                    elseif role=="Medium" then obj.Font=Enum.Font[fm]
                    elseif role=="Regular" then obj.Font=Enum.Font[f] end
                end
            end
        end
        self._fontPalette={Regular=f,Bold=fb,Medium=fm}
    end

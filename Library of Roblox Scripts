        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            if dragging and moved then
                dragging = false
                if cfg.SnapToEdge ~= false then SnapToEdge(Main, WinFile) end
            else
                dragging = false
            end
        end
    end)
    function Win:Toggle()
        self._hidden = not self._hidden
        local target = self._hidden and 1 or 0
        TweenService:Create(Main, T_INFO, {GroupTransparency=target}):Play()
        if not self._hidden then self._lib:PlaySound("open") end
    end
    function Win:SelectTab(t)
        if self._active == t then return end
        for _, tab in ipairs(self._tabs) do
            local sel = tab == t
            tab._frame.Visible = sel
            TweenService:Create(tab._btn, T_OUT, {
                BackgroundColor3 = sel and C.AccentSoft or C.Card,
                TextColor3 = sel and C.White or C.TextDim
            }):Play()
            if tab._icon then
                TweenService:Create(tab._icon, T_OUT, {ImageColor3 = sel and C.White or C.TextDim}):Play()
            end
        end
        self._active = t
        self._lib:PlaySound("click")
    end
    local toggleKeys = cfg.ToggleKeys or {Enum.KeyCode.RightControl}
    UIS.InputBegan:Connect(function(i, gp)
        if gp then return end
        for _, k in ipairs(toggleKeys) do
            if i.KeyCode == k then Win:Toggle() break end
        end
    end)
    TweenService:Create(Main, T_INFO, {GroupTransparency=0}):Play()
    self._window = Win
    self._allWindows = self._allWindows or {}
    table.insert(self._allWindows, Win)
    return Win
end


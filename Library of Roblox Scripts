end
local function TrackAuxGui(lib,win,gui)
    if typeof(gui)~="Instance" or not gui:IsA("ScreenGui") then return false end
    local rootLib=type(lib)=="table" and (lib._lib or lib) or nil
    local ownerWindow=win or ResolveWindow(lib)
    local addedConnection
    if rootLib then rootLib._auxGuis=rootLib._auxGuis or {}; table.insert(rootLib._auxGuis,gui) end
    if ownerWindow then
        ownerWindow._auxGuis=ownerWindow._auxGuis or {}; table.insert(ownerWindow._auxGuis,gui)
        if ownerWindow._maid then ownerWindow._maid:Add(gui) end
        ownerWindow._accentTargetsDirty=true
        addedConnection=gui.DescendantAdded:Connect(function(object)
            ownerWindow._accentTargetsDirty=true
            local applyTextScale=ownerWindow._applyTextScaleObject
            if type(applyTextScale)=="function" then
                task.defer(function()
                    if object.Parent and not ownerWindow._destroyed then applyTextScale(object) end
                end)
            end
        end)
        if ownerWindow._maid then ownerWindow._maid:Add(addedConnection) end
        local applyTextScale=ownerWindow._applyTextScaleObject
        if type(applyTextScale)=="function" then
            for _,object in ipairs(gui:GetDescendants()) do applyTextScale(object) end
        end
    end
    local removed=false
    local bag=ownerWindow and ownerWindow._maid or rootLib and rootLib._maid
    local destroyingConnection,ancestryConnection
    local function removeReferences()
        if removed then return end
        removed=true
        RemoveGuiReference(rootLib and rootLib._auxGuis,gui)
        RemoveGuiReference(ownerWindow and ownerWindow._auxGuis,gui)
        if ownerWindow then ownerWindow._accentTargetsDirty=true end
        local function cleanupConnection(connection)
            if not connection then return end
            pcall(function() connection:Disconnect() end)
            if bag and not bag._destroyed then bag:Remove(connection,false) end
        end
        cleanupConnection(addedConnection)
        cleanupConnection(destroyingConnection)
        cleanupConnection(ancestryConnection)
        if bag and not bag._destroyed then bag:Remove(gui,false) end
    end
    destroyingConnection=gui.Destroying:Connect(removeReferences)
    ancestryConnection=gui.AncestryChanged:Connect(function(_,parent) if parent==nil then removeReferences() end end)
    if bag then bag:Add(destroyingConnection); bag:Add(ancestryConnection) end
    if not ownerWindow and rootLib and rootLib._maid then rootLib._maid:Add(gui) end
    return true
end
local function DestroyAuxGui(lib,win,gui)
    local rootLib=type(lib)=="table" and (lib._lib or lib) or nil
    local ownerWindow=win or ResolveWindow(lib)
    RemoveGuiReference(rootLib and rootLib._auxGuis,gui); RemoveGuiReference(ownerWindow and ownerWindow._auxGuis,gui)
    if gui and gui.Parent then gui:Destroy() end
end


function L:Give(resource)
    if resource==nil then return nil,"resource is nil" end
    local library=self._lib or self
    local window
    if self~=library then
        if self._main and self._maid then window=self
        else
            local candidate=self._window
                or (self._favoriteTab and self._favoriteTab._window)
                or (self._tab and self._tab._window)
            if candidate and candidate._lib==library then window=candidate end
        end
    end
    if library._destroyed or (window and window._destroyed) then
        CleanupResource(resource)
        return nil,"resource owner is destroyed"
    end
    local bag=(window and window._maid) or library._maid
    if not bag or bag._destroyed then
        CleanupResource(resource)
        return nil,bag and "resource owner is destroyed" or "resource bag is unavailable"
    end
    return bag:Add(resource)
end


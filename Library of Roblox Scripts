function Athic:Boot()
    bootPrompt()
    if self._cfg.KeySystem and not KeySystem.CheckCache() then
        local g = keyPrompt(self._cfg.KeySystem)
        local timeout = os.clock() + 300
        while g.Parent and os.clock() < timeout do task.wait(0.1) end
    end
    splash()
end


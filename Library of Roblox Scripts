    Lb.Position = UDim2.new(0, icon and 38 or 16, 0, 0)
    Lb.BackgroundTransparency = 1
    Lb.Text = name
    Lb.Font = Enum.Font[self.CurrentFontMedium]
    Lb.TextSize = 12
    Lb.TextColor3 = C.TextDim
    Lb.TextXAlignment = Enum.TextXAlignment.Left
    Lb.Parent = Btn
    local Frame = Instance.new("ScrollingFrame")
    Frame.Size = UDim2.new(1,0,1,0)
    Frame.BackgroundTransparency = 1
    Frame.BorderSizePixel = 0
    Frame.ScrollBarThickness = 5
    Frame.ScrollBarImageColor3 = C.Accent
    Frame.CanvasSize = UDim2.new(0,0,0,0)
    Frame.AutomaticCanvasSize = Enum.AutomaticSize.Y
    Frame.Visible = false
    Frame.Parent = Win._content
    local Fl = Instance.new("UIListLayout")
    Fl.Padding = UDim.new(0,10)
    Fl.SortOrder = Enum.SortOrder.LayoutOrder
    Fl.Parent = Frame
    local Fp = Instance.new("UIPadding")
    Fp.PaddingTop = UDim.new(0,4)
    Fp.PaddingLeft = UDim.new(0,2)
    Fp.PaddingRight = UDim.new(0,4)
    Fp.PaddingBottom = UDim.new(0,10)
    Fp.Parent = Frame
    Btn.MouseButton1Click:Connect(function()
        if Btn:GetAttribute("__Dragging") then return end
        Win:SelectTab(Tab)
        if Tab._onClick then Tab._onClick() end
    end)
    Btn.MouseEnter:Connect(function()
        if Win._active == Tab then return end
        TweenService:Create(Btn, T_OUT, {BackgroundColor3=C.CardHover}):Play()
        TweenService:Create(Bs, T_OUT, {Color=C.StrokeHot}):Play()
        TweenService:Create(DragHandle, T_OUT, {BackgroundTransparency=0.5}):Play()
    end)
    Btn.MouseLeave:Connect(function()
        if Win._active == Tab then return end
        TweenService:Create(Btn, T_OUT, {BackgroundColor3=C.Card}):Play()
        TweenService:Create(Bs, T_OUT, {Color=C.Stroke}):Play()
        TweenService:Create(DragHandle, T_OUT, {BackgroundTransparency=1}):Play()
    end)
    do
        local dragging, dragStart, startY, dragged = false, nil, nil, false
        Btn.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                if i.Position.X - Btn.AbsolutePosition.X < 10 then
                    dragging = true
                    dragged = false
                    Btn:SetAttribute("__Dragging", true)
                    dragStart = i.Position.Y
                    startY = Btn.Position.Y.Offset
                end
            end
        end)
        UIS.InputChanged:Connect(function(i)
            if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                local d = i.Position.Y - dragStart
                if math.abs(d) > 4 then dragged = true end
                if dragged then
                    Btn.Position = UDim2.new(0, 0, 0, startY + d)
                    Btn.ZIndex = 50
                end
            end
        end)
        UIS.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                if dragging then
                    dragging = false
                    Btn.Position = UDim2.new(0,0,0,0)
                    Btn.ZIndex = 1
                    task.delay(0.15, function() Btn:SetAttribute("__Dragging", false) end)
                    if dragged then
                        local myY = Btn.AbsolutePosition.Y
                        local target = nil
                        for _, t in ipairs(Win._tabs) do
                            if t ~= Tab then
                                local y = t._btn.AbsolutePosition.Y
                                if myY < y + t._btn.AbsoluteSize.Y/2 then
                                    target = t
                                    break
                                end
                            end
                        end
                        local oldIdx = table.find(Win._tabs, Tab)
                        table.remove(Win._tabs, oldIdx)
                        local newIdx = target and (table.find(Win._tabs, target) or (#Win._tabs+1)) or (#Win._tabs+1)
                        table.insert(Win._tabs, newIdx, Tab)
                        for idx, t in ipairs(Win._tabs) do t._btn.LayoutOrder = idx end
                    end
                end
            end
        end)
    end
    Tab._btn = Btn
    Tab._btnLabel = Lb
    Tab._frame = Frame
    Tab._icon = iconImg
    Tab._layout = Fl
    Tab._stroke = Bs
    Tab._dragHandle = DragHandle
    function Tab:SetAccent(color)
        self._ownAccent = color
        self._frame.ScrollBarImageColor3 = color
        if self._icon then self._icon.ImageColor3 = color end
    end
    function Tab:SetTheme(themeName)
        if self._lib.Palettes[themeName] then self._ownTheme = self._lib.Palettes[themeName] end
    end
    function Tab:SetName(n) self._name = n; Lb.Text = n end
    function Tab:Destroy()
        table.remove(Win._tabs, table.find(Win._tabs, Tab))
        Btn:Destroy()
        Frame:Destroy()
    end
    table.insert(Win._tabs, Tab)
    if #Win._tabs == 1 then Win:SelectTab(Tab) end
    return Tab
end


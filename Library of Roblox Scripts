function L:ValidateWindowConfig(cfg)
    local issues={}
    local function issue(field,message) table.insert(issues,{Field=field,Message=message}) end
    if type(cfg)~="table" then return false,{{Field="Config",Message="expected a table"}} end
    for _,field in ipairs({"Title","Name","Subtitle","Version","Author","Theme"}) do
        if cfg[field]~=nil and type(cfg[field])~="string" then issue(field,"expected a string") end
    end
    for _,field in ipairs({"Width","Height","MinWidth","MinHeight","TextScale","MinimumTextSize","Transparency"}) do
        if cfg[field]~=nil then
            local value=tonumber(cfg[field])
            if not value or value~=value or value==math.huge or value==-math.huge then issue(field,"expected a finite number") end
        end
    end
    for _,field in ipairs({"OnClose","OnOpen","OnMinimize","OnRestore"}) do
        if cfg[field]~=nil and type(cfg[field])~="function" then issue(field,"expected a function") end
    end
    if cfg.ToggleKey~=nil and typeof(cfg.ToggleKey)~="EnumItem" and type(cfg.ToggleKey)~="string" and type(cfg.ToggleKey)~="table" then issue("ToggleKey","expected an EnumItem, key name, or array of keys") end
    if cfg.ToggleKeys~=nil and type(cfg.ToggleKeys)~="table" then issue("ToggleKeys","expected an array of keys") end
    if cfg.Size~=nil and typeof(cfg.Size)~="UDim2" and type(cfg.Size)~="table" then issue("Size","expected UDim2 or a size table") end
    return #issues==0,issues
end

function L:ValidateElementConfig(kind,cfg)
    if type(kind)=="table" then cfg=kind; kind=cfg.Type or cfg.ElementType end
    local issues={}
    local function issue(field,message) table.insert(issues,{Field=field,Message=message}) end
    if type(cfg)~="table" then return false,{{Field="Config",Message="expected a table"}} end
    if kind~=nil and type(kind)~="string" then issue("Type","expected an element name") end
    if cfg.Name~=nil and type(cfg.Name)~="string" and type(cfg.Name)~="number" then issue("Name","expected text") end
    if cfg.Flag~=nil and (type(cfg.Flag)~="string" or cfg.Flag=="") then issue("Flag","expected a non-empty string") end
    for _,field in ipairs({"Callback","OnChanged","OnChange","OnClick","OnInput","OnSubmit"}) do
        if cfg[field]~=nil and type(cfg[field])~="function" then issue(field,"expected a function") end
    end
    for _,field in ipairs({"Min","Max","Minimum","Maximum","Default","Value","Step","Increment"}) do
        if cfg[field]~=nil then
            local number=tonumber(cfg[field])
            if not number or number~=number or number==math.huge or number==-math.huge then issue(field,"expected a finite number") end
        end
    end
    local minimum=tonumber(cfg.Min or cfg.Minimum); local maximum=tonumber(cfg.Max or cfg.Maximum)
    if minimum and maximum and minimum>maximum then issue("Min/Max","minimum must not exceed maximum") end
    if cfg.Options~=nil and type(cfg.Options)~="table" then issue("Options","expected an array or dictionary") end
    return #issues==0,issues
end


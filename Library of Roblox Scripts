--============================================================
-- SIGNAL
--============================================================
local Signal = {}
Signal.__index = Signal
function Signal.new() return setmetatable({_h = {}}, Signal) end
function Signal:Connect(fn)
    assert(type(fn) == "function", "callback must be function")
    local c = {Connected = true, _fn = fn, _sig = self}
    table.insert(self._h, c)
    function c:Disconnect()
        if not self.Connected then return end
        self.Connected = false
        local i = table.find(self._sig._h, self)
        if i then table.remove(self._sig._h, i) end
    end
    return c
end
function Signal:Fire(...)
    for _, h in ipairs(table.clone(self._h)) do
        if h.Connected then task.spawn(h._fn, ...) end
    end
end


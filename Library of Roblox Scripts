        if not (object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox")) then return end
        indexed[object]=true
        watch(object:GetPropertyChangedSignal("Text"),function() invalidate(element) end)
        if object:IsA("TextBox") then watch(object:GetPropertyChangedSignal("PlaceholderText"),function() invalidate(element) end) end
    end
    local function getSearchText(element)
        local cached=searchCache[element]
        if cached then return cached end
        if not indexed[element] then
            indexed[element]=true
            watch(element:GetPropertyChangedSignal("Name"),function() invalidate(element) end)
            watch(element:GetAttributeChangedSignal("__VNCSearchText"),function() invalidate(element) end)
            watch(element.DescendantAdded,function(object) trackSearchTextObject(element,object); invalidate(element) end)
            watch(element.DescendantRemoving,function(object) indexed[object]=nil; invalidate(element) end)
            watch(element.Destroying,function() searchCache[element]=nil end)
            for _,object in ipairs(element:GetDescendants()) do trackSearchTextObject(element,object) end
        end
        local chunks={element.Name or "",element:GetAttribute("__VNCSearchText") or ""}
        for _,object in ipairs(element:GetDescendants()) do
            if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
                table.insert(chunks,object.Text or "")
                if object:IsA("TextBox") then table.insert(chunks,object.PlaceholderText or "") end
            end
        end
        cached=string.lower(table.concat(chunks," "))
        searchCache[element]=cached
        return cached
    end
    filterElements=function()
        local query=string.lower(tostring(Box.Text or ""))
        for _,section in ipairs(Tab._sections) do
            local sectionMatch=query~="" and string.lower(tostring(section._name or "")):find(query,1,true)~=nil
            local visibleCount=0
            for _,element in ipairs(section._elements or {}) do
                if element and element.Parent then
                    local wasVisible=element:GetAttribute("__VNCSearchVisible")
                    if wasVisible==nil then wasVisible=element.Visible; element:SetAttribute("__VNCSearchVisible",wasVisible) end
                    local matches=sectionMatch
                    if query=="" then matches=true
                    elseif not matches then
                        matches=getSearchText(element):find(query,1,true)~=nil
                    end
                    element.Visible=wasVisible and matches
                    if element.Visible then visibleCount+=1 end
                end
            end
            if section._holder then
                section._holder.Visible=query=="" or sectionMatch or visibleCount>0
            end
            if section._inner then
                section._inner.Visible=query~="" and (sectionMatch or visibleCount>0) or (not section._collapsed)
            end
        end
        local tabMatch=query~="" and string.lower(tostring(Tab._name or "")):find(query,1,true)~=nil
        for _,element in ipairs(Tab._elements or {}) do
            if element and element.Parent then
                local wasVisible=element:GetAttribute("__VNCSearchVisible")
                if wasVisible==nil then wasVisible=element.Visible; element:SetAttribute("__VNCSearchVisible",wasVisible) end
                local matches=query=="" or tabMatch
                if not matches then
                    matches=getSearchText(element):find(query,1,true)~=nil
                end
                element.Visible=wasVisible and matches
            end
        end
    end
    Tab._searchRefresh=filterElements
    local connection=Win:_Connect(Box:GetPropertyChangedSignal("Text"),function()
        if cfg.Filter~=false then filterElements() end
        if cfg.Callback then InvokeUserCallback(cfg.Callback,Box.Text) end
    end)
    Tab._connections=Tab._connections or {}; table.insert(Tab._connections,connection)
    local Element = {Instance=Wrapped, TextBox=Box, _lib=lib}
    function Element:Get() return Box.Text end
    function Element:Set(value) Box.Text=tostring(value or "") end
    function Element:Destroy()
        if connection then connection:Disconnect(); connection=nil end
        for _,searchConnection in ipairs(searchConnections) do if searchConnection then pcall(function() searchConnection:Disconnect() end) end end
        table.clear(searchConnections)
        Box.Text=""; filterElements()
        if Tab._searchRefresh==filterElements then Tab._searchRefresh=nil end
        if Tab._searchElement==Element then Tab._searchElement=nil end
        Wrapped:Destroy()
    end
    Element.Refresh=filterElements
    Tab._searchElement=Element
    if cfg.Filter~=false then filterElements() end
    return Element
end


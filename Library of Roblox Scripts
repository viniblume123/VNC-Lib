function L:On(eventName, callback)
    if type(eventName) ~= "string" or type(callback) ~= "function" then return nil end
    self._events[eventName] = self._events[eventName] or {}
    local event = self._events[eventName]
    local record = {Callback=callback, Connected=true}
    table.insert(event, record)
    return {Disconnect=function()
        if not record.Connected then return end
        record.Connected=false
        local index=table.find(event,record)
        if index then table.remove(event,index) end
    end}
end
function L:Emit(eventName, ...)
    local event=table.clone(self._events[eventName] or {})
    local args=table.pack(...)
    for _, record in ipairs(event) do if record.Connected then pcall(record.Callback,table.unpack(args,1,args.n)) end end
    return #event
end
function L:Debounce(key, interval, callback, ...)
    if key==nil or type(callback) ~= "function" then return false end
    local now=os.clock()
    self._debounce=self._debounce or {}
    for existing,expires in pairs(self._debounce) do if type(expires)~="number" or expires<=now then self._debounce[existing]=nil end end
    if (self._debounce[key] or 0)>now then return false end
    local entries,oldestKey,oldestExpiry=0,nil,math.huge
    for existing,expires in pairs(self._debounce) do entries+=1; if expires<oldestExpiry then oldestKey,oldestExpiry=existing,expires end end
    if entries>=256 and oldestKey~=nil then self._debounce[oldestKey]=nil end
    self._debounce[key]=now+ClampNumber(interval,0.25,0,86400)
    local ok,err=pcall(callback,...)
    if not ok then warn("[VNC-Lib] Debounced callback failed: "..tostring(err)); return false end
    return true
end
function L:CachedRequest(url, ttl)
    if type(url)~="string" or url=="" then return nil,false end
    self._requestCache=self._requestCache or {}
    local now=os.clock()
    for cachedUrl,entry in pairs(self._requestCache) do
        if type(entry)~="table" or type(entry.Expires)~="number" or entry.Expires<=now then self._requestCache[cachedUrl]=nil end
    end
    local cached=self._requestCache[url]
    if cached and cached.Expires>now then return cached.Body,true end
    local body=HttpGet(url)
    if body then
        if not cached then
            local entries,oldestUrl,oldestExpiry=0,nil,math.huge
            for cachedUrl,entry in pairs(self._requestCache) do entries+=1; if entry.Expires<oldestExpiry then oldestUrl,oldestExpiry=cachedUrl,entry.Expires end end
            if entries>=128 and oldestUrl then self._requestCache[oldestUrl]=nil end
        end
        self._requestCache[url]={Body=body,Expires=now+ClampNumber(ttl,30,0,86400)}
    end
    return body,false
end
function L:SetFavorite(id, enabled)
    id=tostring(id or "")
    if id=="" then return false end
    local wasFavorite=self.Favorites[id]==true
    if enabled==false then self.Favorites[id]=nil else self.Favorites[id]=true end
    if wasFavorite~=(self.Favorites[id]==true) then JsonWrite("library_favorites.json",self.Favorites) end
    return self.Favorites[id]==true
end
function L:IsFavorite(id) return self.Favorites[tostring(id or "")] == true end
local function NormalizeSoundId(id)
    if type(id)~="string" and type(id)~="number" then return nil end
    local text=tostring(id):gsub("^%s+",""):gsub("%s+$","")
    local digits=text:match("^(%d+)$") or text:match("^rbxassetid://(%d+)$")
    if not digits or #digits>20 or tonumber(digits)==0 then return nil end
    return "rbxassetid://"..digits
end

function L:IsSoundFavorite(id)
    local key=tostring(id or "")
    if key=="" or type(self.Sounds.favorites)~="table" then return false end
    local normalized=NormalizeSoundId(key) or key
    local value=self.Sounds.favorites[key] or self.Sounds.favorites[normalized]
    return value==true or value==key or value==normalized
end
function L:GetFavorites()
    local out={}; for id,enabled in pairs(self.Favorites) do if enabled then table.insert(out,id) end end; table.sort(out); return out
end
function L:RegisterSound(name, id, category)
    if type(name)~="string" or name:gsub("%s","")=="" then return false,"sound name required" end
    local soundId=NormalizeSoundId(id)
    if not soundId then return false,"sound id must be a numeric asset id or rbxassetid:// URI" end
    if type(self.Sounds.library)~="table" then self.Sounds.library={} end
    self.Sounds.library[name]={Name=name,Id=soundId,Category=category or "General"}
    return true
end
function L:SearchSounds(query, category, favoritesOnly)
    local out={}; local q=tostring(query or ""):lower()
    local library=type(self.Sounds.library)=="table" and self.Sounds.library or {}
    for name,sound in pairs(library) do
        if type(name)=="string" and type(sound)=="table" then
            local match=(q=="" or name:lower():find(q,1,true) or tostring(sound.Id):lower():find(q,1,true) or tostring(sound.Category):lower():find(q,1,true))
            local categoryMatch=not category or category=="All" or sound.Category==category
            local favoriteMatch=not favoritesOnly or self:IsSoundFavorite(sound.Id)
            if match and categoryMatch and favoriteMatch then table.insert(out,sound) end
        end
    end
    table.sort(out,function(a,b) return a.Name:lower()<b.Name:lower() end)
    return out
end
function L:CheckForUpdate(url)
    if type(url)~="string" or url=="" then return nil,"update manifest URL required" end
    local body=self:CachedRequest(url,300)
    if not body then return nil,"unable to fetch update manifest" end
    local ok,manifest=pcall(HS.JSONDecode,HS,body)
    if not ok or type(manifest)~="table" or type(manifest.version)~="string" then return nil,"invalid update manifest" end
    local function newer(a,b)
        local aa,bb={},{}
        for n in tostring(a):gmatch("%d+") do table.insert(aa,tonumber(n)) end
        for n in tostring(b):gmatch("%d+") do table.insert(bb,tonumber(n)) end
        for i=1,math.max(#aa,#bb) do local x,y=aa[i] or 0,bb[i] or 0; if x~=y then return x>y end end
        return false
    end
    return {current=self.Version,latest=manifest.version,updateAvailable=newer(manifest.version,self.Version),downloadUrl=manifest.url,notes=manifest.notes}
end
function L:_TrackConfigChange()
    local history=self.ConfigHistory
    local current=self:CaptureConfig()
    local previous=self._lastHistorySnapshot
    local changed = previous ~= nil
    if changed then
        local okPrevious, encodedPrevious = pcall(HS.JSONEncode, HS, TrySanitizeForJson(previous))
        local okCurrent, encodedCurrent = pcall(HS.JSONEncode, HS, TrySanitizeForJson(current))
        changed = not okPrevious or not okCurrent or encodedPrevious ~= encodedCurrent
    end
    if changed then
        table.insert(history.Undo,previous)
        while #history.Undo>history.Limit do table.remove(history.Undo,1) end

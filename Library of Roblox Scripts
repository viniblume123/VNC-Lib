        end
    end))
    local function disconnectPointer() for _,connection in ipairs(pointerConnections) do if connection then connection:Disconnect() end end; table.clear(pointerConnections) end
    Wrapped.Destroying:Connect(disconnectPointer)
    if cfg.Flag then
        Sec._lib:RegisterState(cfg.Flag, function() return {Min=v1, Max=v2} end, function(v, silent)
            if type(v) == "table" then v1 = ClampNumber(v.Min or v[1],min,min,max); v2 = ClampNumber(v.Max or v[2],max,min,max) end
            v1 = ClampNumber(v1,min,min,max); v2 = ClampNumber(v2,max,min,max); if v2 < v1 then v1, v2 = v2, v1 end
            if v2-v1<minimumGap then v2=math.min(max,v1+minimumGap); v1=math.max(min,v2-minimumGap) end
            local p1=(v1-min)/(max-min); local p2=(v2-min)/(max-min)
            ValL.Text=FormatControlNumber(v1).." - "..FormatControlNumber(v2); Fill.Position=UDim2.new(p1,0,0,0); Fill.Size=UDim2.new(p2-p1,0,1,0); Thumb1.Position=UDim2.new(p1,-7,0.5,-7); Thumb2.Position=UDim2.new(p2,-7,0.5,-7)
            if not silent and cfg.Callback then InvokeUserCallback(cfg.Callback,v1,v2) end
        end)

function ElementMethods:Disable()
    if self._disabled then return self end
    self._disabled = true
    local root = self.Instance
    if root then
        self._interactableState = {}
        local list = {root}
        for _, extra in ipairs(self._extraRoots or {}) do
            if extra then table.insert(list,extra); for _, obj in ipairs(extra:GetDescendants()) do table.insert(list,obj) end end
        end
        for _, obj in ipairs(root:GetDescendants()) do table.insert(list,obj) end
        for _, obj in ipairs(list) do
            if obj:IsA("GuiObject") then
                self._interactableState[obj] = {Interactable=obj.Interactable, TextEditable=obj:IsA("TextBox") and obj.TextEditable or nil}
                pcall(function() obj.Interactable = false end)
            end
            if obj:IsA("TextBox") then obj.TextEditable = false end
        end
    end
    return self
end
function ElementMethods:Enable()
    if not self._disabled then return self end
    self._disabled = false
    for obj, state in pairs(self._interactableState or {}) do
        if obj and obj.Parent then
            pcall(function() obj.Interactable = state.Interactable end)
            if obj:IsA("TextBox") and state.TextEditable ~= nil then obj.TextEditable = state.TextEditable end
        end
    end
    self._interactableState = nil
    return self
end
function L:_AddElement(a, b)
    local Sec, frame
    if b ~= nil then
        Sec, frame = a, b
    else
        Sec, frame = self, a
    end
    if type(Sec) ~= "table" or not frame then return nil end
    if type(Sec._elements) ~= "table" then Sec._elements = {} end
    local parent = Sec._inner or Sec._holder
    if not parent then return nil end
    frame.LayoutOrder = #Sec._elements + 1
    if frame.Parent ~= parent then frame.Parent = parent end
    local transparency=Sec._lib.Config.Transparency or 0
    if transparency>0 then
        local function apply(obj)
            if obj:IsA("GuiObject") then
                if obj:GetAttribute("__VNCBaseTransparency")==nil then obj:SetAttribute("__VNCBaseTransparency",obj.BackgroundTransparency) end
                local base=obj:GetAttribute("__VNCBaseTransparency")
                obj.BackgroundTransparency=math.clamp(base+transparency*(1-base),0,1)
            end
        end
        apply(frame); for _,obj in ipairs(frame:GetDescendants()) do apply(obj) end
    end
    table.insert(Sec._elements, frame)
    if Sec._tab and Sec._tab._searchRefresh then pcall(Sec._tab._searchRefresh) end
    return frame
end


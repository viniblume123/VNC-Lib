            local current=holder.CanvasPosition.Y
            local top=(button.AbsolutePosition.Y-holder.AbsolutePosition.Y)/scale+current
            local bottom=top+button.AbsoluteSize.Y/scale
            local viewBottom=current+holder.AbsoluteSize.Y/scale
            local nextY=current
            if top<current then nextY=top-8
            elseif bottom>viewBottom then nextY=bottom-holder.AbsoluteSize.Y/scale+8 end
            local maxY=math.max(0,holder.AbsoluteCanvasSize.Y/scale-holder.AbsoluteSize.Y/scale)
            holder.CanvasPosition=Vector2.new(0,math.clamp(nextY,0,maxY))
        end
        if self._active == t then keepSelectedTabVisible(); return true end
        for _, tab in ipairs(self._tabs) do
            local sel = tab == t
            local C = tab.C or self.C
            tab._frame.Visible = sel
            TweenService:Create(tab._btn, T_OUT, {
                BackgroundColor3 = sel and C.CardActive or C.Card,
                TextColor3 = sel and C.White or C.TextDim
            }):Play()
            if tab._activeGlow then TweenService:Create(tab._activeGlow, T_OUT, {BackgroundTransparency=sel and 0 or 1}):Play() end
            if tab._stroke then TweenService:Create(tab._stroke, T_OUT, {Color=sel and C.StrokeHot or C.Stroke, Transparency=sel and 0.05 or 0.45}):Play() end
            if tab._icon then
                TweenService:Create(tab._icon, T_OUT, {ImageColor3 = sel and C.White or C.TextDim}):Play()
            end
        end
        self._active = t
        keepSelectedTabVisible()
        self._lib:PlaySound("click")
        return true
    end
    Win:_Connect(UIS.InputBegan,function(i,gp)
        if gp then return end
        if i.KeyCode==Enum.KeyCode.Escape and cfg.CloseOnEscape~=false and not UIS:GetFocusedTextBox() then
            closeWindow()
            return
        end
        for _, k in ipairs(toggleKeys) do
            if i.KeyCode == k then Win:Toggle() break end
        end
    end)
    function Win:Destroy()
        if self._destroyed then return end
        self._destroyed=true
        if self._lib and self._lib._hubIdleState and self._lib._hubIdleState.hiddenWindows then self._lib._hubIdleState.hiddenWindows[self]=nil end
        if self._lib and self._lib.Macros then
            local anotherWindowOpen=false
            for _,window in ipairs(self._lib._allWindows or {}) do
                if window~=self and window and not window._destroyed then anotherWindowOpen=true; break end
            end
            if not anotherWindowOpen then pcall(function() self._lib:StopMacroPlayback() end) end
        end
        if self._particleHandle then pcall(function() self._particleHandle:Destroy() end) end
        if self._spotlightHandle then pcall(function() self._spotlightHandle:Destroy() end) end
        if self._logoAnimation then pcall(function() self._logoAnimation:Stop() end) end
        if self._acrylicTween then pcall(function() self._acrylicTween:Cancel() end); self._acrylicTween=nil end
        if self._acrylicEffect then pcall(function() self._acrylicEffect:Destroy() end); self._acrylicEffect=nil end
        if cfg.OnClose then InvokeUserCallback(cfg.OnClose) end
        if self._maid then self._maid:Destroy(); self._maid=nil end
        for _, gui in ipairs(table.clone(self._auxGuis or {})) do if gui and gui.Parent then pcall(function() gui:Destroy() end) end end
        self._auxGuis = {}
        if self._main and self._main.Parent then self._main.Parent:Destroy() end
        table.clear(self._connections or {})
        local wins = self._lib._allWindows or {}
        local index = table.find(wins, self)
        if index then table.remove(wins, index) end
        if self._lib._window==self then
            self._lib._window=nil
            for i=#wins,1,-1 do if wins[i] and not wins[i]._destroyed then self._lib._window=wins[i]; break end end
        end
        self._lib:Emit("WindowDestroyed",self)
        self._lib:_RefreshMaintenanceLoop()
        table.clear(self._tabs or {})
        table.clear(self._allElements or {})
        table.clear(self._accentTargets or {})
        self._active=nil
    end
    Main.GroupTransparency = 0
    self._window=Win
    self._allWindows = self._allWindows or {}
    table.insert(self._allWindows, Win)
    self:Emit("WindowCreated",Win)
    Win._acrylicSize=ClampNumber(cfg.BlurSize,8,0,24)
    if cfg.Acrylic==true or cfg.Blur==true then Win:SetAcrylic(true) end
    if cfg.AnimateLogo~=false and cfg.LogoAnimation~=false and not self:GetReducedMotion() then
        local animation=type(cfg.AnimateLogo)=="string" and cfg.AnimateLogo
            or type(cfg.LogoAnimation)=="string" and cfg.LogoAnimation
            or "pulse"
        Win._logoAnimationKind=animation
        self:AnimateLogo(Win,animation)
    end
    if self.StreamerMode then self:SetStreamerMode(true) end
    if self._hubIdleState and self._hubIdleState.locked then
        self._hubIdleState.hiddenWindows[Win]={WasHidden=false,Interactable=Win._main.Interactable}
        Win._main.Interactable=false
        Win:Toggle()
    end
    if cfg.UserInfoTop==true then
        local userInfo=type(cfg.UserInfo)=="table" and table.clone(cfg.UserInfo) or {}
        userInfo.Title=userInfo.Title or cfg.UserInfoTitle
        userInfo.Subtitle=userInfo.Subtitle or cfg.UserInfoSubtitle
        userInfo.Color=userInfo.Color or cfg.UserInfoColor
        Win:CreateUserInfoCard(userInfo)
    end
    self:_RefreshMaintenanceLoop()
    return Win
end


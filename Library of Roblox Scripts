    username.Position=UDim2.fromOffset(56,25)
    username.BackgroundTransparency=1
    SetThemeColor(username,"TextColor3",C,"TextDim")
    username.Font=Enum.Font[win._lib.CurrentFont]
    username.TextSize=9
    username.TextXAlignment=Enum.TextXAlignment.Left
    username.TextTruncate=Enum.TextTruncate.AtEnd
    username.Parent=root
    local idButton=Instance.new("TextButton")
    idButton.Name="CopyUserId"
    idButton.Size=UDim2.new(1,-62,0,16)
    idButton.Position=UDim2.fromOffset(56,40)
    idButton.BackgroundTransparency=1
    SetThemeColor(idButton,"TextColor3",C,"TextFaint")
    idButton.Font=Enum.Font[win._lib.CurrentFont]
    idButton.TextSize=8
    idButton.TextXAlignment=Enum.TextXAlignment.Left
    idButton.AutoButtonColor=false
    idButton.Parent=root
    local requestRevision=0
    local handle={Instance=root,Avatar=avatar,DisplayName=display,Username=username,IdButton=idButton,Player=player}
    local function restoreSidebar()
        if win._userInfoCard==handle then
            win._userInfoCard=nil
            if tabs.Parent and win._UpdateTabSearchLayout then win:_UpdateTabSearchLayout() end
        end
    end
    root.Destroying:Connect(function() requestRevision+=1; restoreSidebar() end)
    local function applyPlayer(nextPlayer)
        if typeof(nextPlayer)~="Instance" or not nextPlayer:IsA("Player") then return false end
        requestRevision+=1
        local revision=requestRevision
        handle.Player=nextPlayer
        local private=win._lib.StreamerMode==true
        display.Text=private and "Anonymous" or tostring(cfg.Title or nextPlayer.DisplayName or nextPlayer.Name)
        username.Text=private and "Streamer mode" or tostring(cfg.Subtitle or ("@"..nextPlayer.Name))
        idButton.Text=private and "" or ("ID: "..tostring(nextPlayer.UserId).."  ·  Copy")
        idButton.Visible=not private
        avatar.Image=""
        if private then return true end
        task.spawn(function()
            local ok,image=pcall(function()
                return Players:GetUserThumbnailAsync(nextPlayer.UserId,Enum.ThumbnailType.HeadShot,Enum.ThumbnailSize.Size100x100)
            end)
            if ok and revision==requestRevision and avatar.Parent then avatar.Image=image end
        end)
        return true
    end
    idButton.MouseButton1Click:Connect(function()
        if win._lib.StreamerMode then return end
        if CLIP then pcall(CLIP,tostring(handle.Player.UserId)) end
        if type(cfg.OnCopyId)=="function" then InvokeUserCallback(cfg.OnCopyId,handle.Player.UserId,handle.Player) end
    end)
    function handle:SetPlayer(nextPlayer) return applyPlayer(nextPlayer) end
    function handle:Refresh() return self.Player and applyPlayer(self.Player) or false end
    function handle:Destroy()
        if not root.Parent then restoreSidebar(); return false end
        root:Destroy()
        return true
    end
    applyPlayer(player)
    win._userInfoCard=handle
    if win._UpdateTabSearchLayout then win:_UpdateTabSearchLayout() end
    return handle
end

function L:CreateTab(name, icon)
    local Win = self._window or (self._main and self)
    if not Win then return end
    local C = Win.C
    local opts = {}
    if type(name) == "table" then
        opts = table.clone(name)
        icon = opts.Icon or opts.icon
        name = opts.Name or opts.name or opts.Title or opts.title or "Tab"
    end
    local onClick=opts.OnClick or opts.onClick or opts.Callback or opts.callback
    name=tostring(name or "Tab")
    local Tab = setmetatable({
        _window=Win, _lib=Win._lib or self, _name=name, _sections={}, _elements={}, _topLevelOrder=0,
        _iconName=icon, _onClick=type(onClick)=="function" and onClick or nil,
        C=ClonePalette(C), _ownTheme=nil, _ownAccent=nil
    }, {__index=L})
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1,0,0,42)
    SetThemeColor(Btn,"BackgroundColor3",C,"Card")
    Btn.Text = ""
    Btn.AutoButtonColor = false
    Btn.BorderSizePixel = 0
    Btn.LayoutOrder = #Win._tabs + 1
    Btn.Parent = Win._tabsHolder
    local Bc = Instance.new("UICorner"); Bc.CornerRadius = UDim.new(0,11); Bc.Parent = Btn
    local Bs = Instance.new("UIStroke"); SetThemeColor(Bs,"Color",C,"Stroke"); Bs.Thickness = 1; Bs.Transparency = 0.45; Bs.Parent = Btn
    local ActiveGlow = Instance.new("Frame")
    ActiveGlow.Size = UDim2.new(0,3,0.58,0)
    ActiveGlow.Position = UDim2.new(1,-7,0.21,0)
    SetThemeColor(ActiveGlow,"BackgroundColor3",C,"Accent")
    ActiveGlow.BackgroundTransparency = 1
    ActiveGlow.BorderSizePixel = 0
    ActiveGlow.Parent = Btn
    local Agc = Instance.new("UICorner"); Agc.CornerRadius = UDim.new(1,0); Agc.Parent = ActiveGlow
    local DragHandle = Instance.new("Frame")
    DragHandle.Size = UDim2.new(0,3,0.56,0)
    DragHandle.Position = UDim2.new(0,4,0.22,0)
    SetThemeColor(DragHandle,"BackgroundColor3",C,"Accent")
    DragHandle.BackgroundTransparency = 1
    DragHandle.BorderSizePixel = 0
    DragHandle.Parent = Btn
    local Dhc = Instance.new("UICorner"); Dhc.CornerRadius = UDim.new(1,0); Dhc.Parent = DragHandle
    local iconImg
    if icon then
        local ib = Instance.new("Frame")
        ib.Size = UDim2.new(0,18,0,18)
        ib.Position = UDim2.new(0,12,0.5,-9)
        ib.BackgroundTransparency = 1
        ib.Parent = Btn
        iconImg = Instance.new("ImageLabel")
        iconImg.Size = UDim2.new(1,0,1,0)
        iconImg.BackgroundTransparency = 1
        iconImg.Image = NormalizeIcon(self.Icons[icon] or icon)
        SetThemeColor(iconImg,"ImageColor3",C,"TextDim")
        iconImg.Parent = ib
    end
    local Lb = Instance.new("TextLabel")
    Lb.Size = UDim2.new(1, icon and -42 or -22, 1, 0)
    Lb.Position = UDim2.new(0, icon and 38 or 16, 0, 0)
    Lb.BackgroundTransparency = 1
    Lb.Text = name
    Lb.Font = Enum.Font[self.CurrentFontMedium]
    Lb.TextSize = 12
    SetThemeColor(Lb,"TextColor3",C,"TextDim")
    Lb.TextXAlignment = Enum.TextXAlignment.Left
    Lb.Parent = Btn
    local Frame = Instance.new("ScrollingFrame")
    Frame.Size = UDim2.new(1,0,1,0)
    Frame.BackgroundTransparency = 1
    Frame.BorderSizePixel = 0
    Frame.ScrollBarThickness = 5
    Frame.ScrollBarImageColor3 = C.Accent
    Frame.CanvasSize = UDim2.new(0,0,0,0)
    Frame.AutomaticCanvasSize = Enum.AutomaticSize.Y
    Frame.Visible = false
    Frame.Parent = Win._content
    local Fl = Instance.new("UIListLayout")
    Fl.Padding = UDim.new(0,10)
    Fl.SortOrder = Enum.SortOrder.LayoutOrder
    Fl.Parent = Frame
    local Fp = Instance.new("UIPadding")
    Fp.PaddingTop = UDim.new(0,4)
    Fp.PaddingLeft = UDim.new(0,2)
    Fp.PaddingRight = UDim.new(0,4)
    Fp.PaddingBottom = UDim.new(0,10)
    Fp.Parent = Frame
    Btn.MouseButton1Click:Connect(function()
        if Btn:GetAttribute("__Dragging") then return end
        Win:SelectTab(Tab)
        if Tab._onClick then InvokeUserCallback(Tab._onClick,Tab) end
    end)
    Btn.MouseEnter:Connect(function()
        if Win._active == Tab then return end
        local colors=Tab.C or Win.C
        TweenService:Create(Btn, T_OUT, {BackgroundColor3=colors.CardHover}):Play()
        TweenService:Create(Bs, T_OUT, {Color=colors.StrokeHot}):Play()
        TweenService:Create(DragHandle, T_OUT, {BackgroundTransparency=0.5}):Play()
    end)
    Btn.MouseLeave:Connect(function()
        if Win._active == Tab then return end
        local colors=Tab.C or Win.C
        TweenService:Create(Btn, T_OUT, {BackgroundColor3=colors.Card}):Play()
        TweenService:Create(Bs, T_OUT, {Color=colors.Stroke}):Play()
        TweenService:Create(DragHandle, T_OUT, {BackgroundTransparency=1}):Play()
    end)
    local dragConnections = {}
    do
        local dragging, dragStart, dragged = false, nil, false
        local function reorderAt(pointerY)
            local currentIndex=table.find(Win._tabs,Tab)
            if not currentIndex then return false end
            local ordered={}
            for _,candidate in ipairs(Win._tabs) do
                if candidate~=Tab then table.insert(ordered,candidate) end
            end
            local targetIndex=#ordered+1
            for index,candidate in ipairs(ordered) do
                local button=candidate._btn
                if button and button.Parent and button.Visible and pointerY<button.AbsolutePosition.Y+button.AbsoluteSize.Y/2 then
                    targetIndex=index
                    break
                end
            end
            table.insert(ordered,targetIndex,Tab)
            local changed=#ordered~=#Win._tabs
            if not changed then
                for index,candidate in ipairs(ordered) do
                    if Win._tabs[index]~=candidate then changed=true; break end
                end
            end
            if not changed then return false end
            table.clear(Win._tabs)
            for index,candidate in ipairs(ordered) do
                Win._tabs[index]=candidate
                if candidate._btn then candidate._btn.LayoutOrder=index end
            end
            return true
        end
        Btn.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                if i.Position.X - Btn.AbsolutePosition.X < 10 then
                    dragging = true
                    dragged = false
                    Btn:SetAttribute("__Dragging", true)
                    dragStart = i.Position.Y
                end
            end
        end)
        local changedConn = Win:_Connect(UIS.InputChanged,function(i)
            if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                local d = i.Position.Y - dragStart
                if math.abs(d) > 4 then dragged = true end
                if dragged then
                    Btn.ZIndex = 50
                    reorderAt(i.Position.Y)
                end
            end
        end)
        table.insert(dragConnections,changedConn)
        local endedConn = Win:_Connect(UIS.InputEnded,function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                if dragging then
                    dragging = false
                    Btn.ZIndex = 1
                    task.delay(0.15, function() Btn:SetAttribute("__Dragging", false) end)
                end
            end
        end)
        table.insert(dragConnections,endedConn)
    end
    Tab._btn = Btn
    Tab._btnLabel = Lb
    Tab._frame = Frame
    Tab._icon = iconImg
    Tab._layout = Fl
    Tab._stroke = Bs
    Tab._activeGlow = ActiveGlow
    Tab._dragHandle = DragHandle
    Tab._connections = dragConnections
    function Tab:SetAccent(color)
        if typeof(color) ~= "Color3" then return false end
        self._ownAccent = color
        local old, oldSoft = self.C.Accent, self.C.AccentSoft
        self.C.Accent, self.C.StrokeHot = color, color
        self.C.AccentSoft = color:Lerp(Color3.new(0,0,0), 0.35)
        if self._ownTheme then self._ownTheme=ClonePalette(self.C) end
        local function hasColorRole(obj,property,role,legacyColor)
            local tag=obj:GetAttribute("__VNCColorRole_"..property)
            if type(tag)=="string" then
                return tag==role or (role=="Accent" and tag=="StrokeHot")
            end
            return obj[property]==(legacyColor or old)
        end
        local function applyColor(obj,property,value,role)
            local attribute="__VNCColorRole_"..property
            if role and obj:GetAttribute(attribute)==nil then obj:SetAttribute(attribute,role) end
            local ok=pcall(function() local tween=TweenService:Create(obj,TweenInfo.new(0),{[property]=value}); tween:Play() end)
            if not ok then pcall(function() obj[property]=value end) end
        end
        for _, obj in ipairs(Btn:GetDescendants()) do
            if not IsInsideThemePreview(obj,Btn) then
                if obj:IsA("GuiObject") and hasColorRole(obj,"BackgroundColor3","Accent") then applyColor(obj,"BackgroundColor3",color,"Accent") end
                if (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) and hasColorRole(obj,"TextColor3","Accent") then applyColor(obj,"TextColor3",color,"Accent") end
                if (obj:IsA("ImageLabel") or obj:IsA("ImageButton")) and hasColorRole(obj,"ImageColor3","Accent") then applyColor(obj,"ImageColor3",color,"Accent") end
                if obj:IsA("UIStroke") and hasColorRole(obj,"Color","Accent") then applyColor(obj,"Color",color,"Accent") end
            end
        end
        self._frame.ScrollBarImageColor3 = color
        ActiveGlow.BackgroundColor3 = color
        DragHandle.BackgroundColor3 = color
        for _, section in ipairs(self._sections) do section.C = self.C end
        for _, obj in ipairs(Frame:GetDescendants()) do
            if not IsInsideThemePreview(obj,Frame) then
                if obj:IsA("GuiObject") and hasColorRole(obj,"BackgroundColor3","Accent") then applyColor(obj,"BackgroundColor3",color,"Accent") end
                if obj:IsA("GuiObject") and hasColorRole(obj,"BackgroundColor3","AccentSoft",oldSoft) then applyColor(obj,"BackgroundColor3",self.C.AccentSoft,"AccentSoft") end
                if (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) and hasColorRole(obj,"TextColor3","Accent") then applyColor(obj,"TextColor3",color,"Accent") end
                if (obj:IsA("ImageLabel") or obj:IsA("ImageButton")) and hasColorRole(obj,"ImageColor3","Accent") then applyColor(obj,"ImageColor3",color,"Accent") end
                if obj:IsA("UIStroke") and hasColorRole(obj,"Color","Accent") then applyColor(obj,"Color",color,"Accent") end
            end
        end
        Win._accentTargetsDirty=true
        return true
    end
    function Tab:SetTheme(themeName)
        local palette = self._lib.Palettes[themeName]
        if not palette then return false end
        local paletteRef = self.C or Win.C
        local old = ClonePalette(paletteRef)
        local fresh = NormalizePalette(palette)
        if self._ownAccent then
            fresh.Accent=self._ownAccent
            fresh.StrokeHot=self._ownAccent
            fresh.AccentSoft=self._ownAccent:Lerp(Color3.new(0,0,0),0.35)
        end
        ReplacePaletteInPlace(paletteRef,fresh)
        local new=paletteRef
        self._ownTheme, self.C = ClonePalette(fresh), paletteRef
        local function remap(root)
            local backgroundKeys={"Bg","Surface","CardHover","CardActive","Card","AccentSoft","Accent","SuccessBg","DangerBg","WarningBg","InfoBg","Success","Danger","Warning","Info","Overlay","White"}
            local textKeys={"Text","TextDim","TextFaint","White","Accent","Success","Danger","Warning","Info"}
            local strokeKeys={"Stroke","StrokeHot","Accent","AccentSoft"}
            local imageKeys={"Accent","Text","TextDim","TextFaint","Success","Danger","Warning","Info","White"}
        local function apply(obj,property,keys)
                if IsInsideThemePreview(obj,root) then return end
                local role=obj:GetAttribute("__VNCColorRole_"..property)
                if type(role)=="string" then
                    if table.find(keys,role) and typeof(new[role])=="Color3" then
                        local ok,tween=pcall(function() return TweenService:Create(obj,TweenInfo.new(0),{[property]=new[role]}) end)
                        if ok and tween then pcall(function() tween:Play() end) else pcall(function() obj[property]=new[role] end) end
                    end
                    return
                end
                for _,key in ipairs(keys) do
                    if old[key]==obj[property] and typeof(new[key])=="Color3" then
                        local goal=new[key]
                        local ok,tween=pcall(function() return TweenService:Create(obj,TweenInfo.new(0),{[property]=goal}) end)
                        if ok and tween then pcall(function() tween:Play() end) else pcall(function() obj[property]=goal end) end
                        return
                    end
                end
            end
            local objects={root}
            for _,descendant in ipairs(root:GetDescendants()) do table.insert(objects,descendant) end
            for _,obj in ipairs(objects) do
                if obj:IsA("GuiObject") then apply(obj,"BackgroundColor3",backgroundKeys) end
                if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then apply(obj,"TextColor3",textKeys) end
                if obj:IsA("TextBox") then apply(obj,"PlaceholderColor3",{"TextDim","TextFaint"}) end
                if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then apply(obj,"ImageColor3",imageKeys) end
                if obj:IsA("UIStroke") then apply(obj,"Color",strokeKeys) end
                if obj:IsA("ScrollingFrame") then apply(obj,"ScrollBarImageColor3",imageKeys) end
            end
        end
        remap(Btn); remap(Frame)
        self._themeRevision=(self._themeRevision or 0)+1
        local themeRevision=self._themeRevision
        task.delay(T_OUT.Time+0.04,function()
            if not self._destroyed and self._themeRevision==themeRevision then remap(Btn); remap(Frame) end
        end)
        self._frame.ScrollBarImageColor3 = new.Accent
        SetThemeColor(Btn,"BackgroundColor3",new,"Card")
        SetThemeColor(Bs,"Color",new,"Stroke")
        SetThemeColor(ActiveGlow,"BackgroundColor3",new,"Accent")
        SetThemeColor(DragHandle,"BackgroundColor3",new,"Accent")
        SetThemeColor(Lb,"TextColor3",new,"TextDim")
        if iconImg then SetThemeColor(iconImg,"ImageColor3",new,"TextDim") end
        for _, section in ipairs(self._sections) do section.C = new end
        Win._accentTargetsDirty=true
        return true
    end
    function Tab:SetName(n)
        if type(n)~="string" then return false end
        self._name=n
        Lb.Text=n
        if Win._RefreshTabSearch then Win:_RefreshTabSearch() end
        return true
    end
    function Tab:Destroy()

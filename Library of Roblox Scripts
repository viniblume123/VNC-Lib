function L:ImportSoundPlaylist(name, ids, category)
    name = tostring(name or "Playlist")
    local list = {}
    if type(ids) == "string" then
        for id in ids:gmatch("%d+") do table.insert(list, "rbxassetid://"..id) end
    elseif type(ids) == "table" then
        for _, id in ipairs(ids) do
            local text = tostring(id)
            if text:match("%d+") then table.insert(list, text:find("rbxassetid://",1,true) and text or ("rbxassetid://"..text)) end
        end
    end
    self.Sounds.playlists = self.Sounds.playlists or {}
    self.Sounds.playlists[name] = {category=category or "Custom", sounds=list}
    return list
end
function L:PlaySoundPlaylist(name,index)
    local playlist=(self.Sounds.playlists or {})[name]
    if not playlist or #playlist.sounds==0 then return false end
    index=math.clamp(tonumber(index) or 1,1,#playlist.sounds)
    return self:PlaySoundAsset(playlist.sounds[index],"Music")
end

function L:StopSound(fadeDuration)
    local sound = self._activeSound
    if not sound then return false end
    local duration = math.max(0, tonumber(fadeDuration) or 0)
    if duration == 0 then sound:Stop(); sound:Destroy(); self._activeSound=nil; return true end
    local startVolume = sound.Volume
    local started = os.clock()
    task.spawn(function()
        while sound.Parent and sound.IsPlaying do
            local alpha = math.clamp((os.clock()-started)/duration, 0, 1)
            sound.Volume = startVolume * (1-alpha)
            if alpha >= 1 then break end
            task.wait(0.03)
        end
        pcall(function() sound:Stop(); sound:Destroy() end)
        if self._activeSound == sound then self._activeSound=nil end
    end)
    return true
end

function L:PlaySound(slot, channel, options)
    if self.Sounds.silent or not self.Sounds.enabled then return end
    local id = self.Sounds[slot]
    if not id or id == "" then return end
    channel = channel or ((slot == "click" or slot == "hover" or slot == "open" or slot == "close") and "UI") or "Effects"
    pcall(function()
        local s = Instance.new("Sound")
        s.SoundId = id
        local targetVolume = math.clamp((tonumber(self.Sounds.volume) or 0.5) * ((self.Sounds.channels or {})[channel] or 1), 0, 1)
        s.Volume = options and tonumber(options.FadeIn) and tonumber(options.FadeIn)>0 and 0 or targetVolume
        if options and options.Pitch then s.PlaybackSpeed = math.clamp(tonumber(options.Pitch) or 1, 0.5, 2) end
        s.Parent = SS
        self.Sounds.history = self.Sounds.history or {}
        table.insert(self.Sounds.history, 1, {id=id, slot=slot, channel=channel, time=os.time()})
        while #self.Sounds.history > 50 do table.remove(self.Sounds.history) end
        if channel == "Music" or channel == "Ambient" then
            self:StopSound(0.15)
            self._activeSound = s
        end
        s:Play()
        if options and tonumber(options.FadeIn) and tonumber(options.FadeIn)>0 then TweenService:Create(s,TweenInfo.new(math.clamp(tonumber(options.FadeIn),0.05,10)),{Volume=targetVolume}):Play() end
        s.Ended:Connect(function() if self._activeSound == s then self._activeSound=nil end; s:Destroy() end)
        task.delay(120, function() if s and s.Parent then s:Destroy() end end)
    end)
end

function L:PlaySoundAsset(id, channel, options)
    if not id then return false end
    options = options or {}
    local soundId = tostring(id)
    if soundId:match("^%d+$") then soundId = "rbxassetid://"..soundId end
    local slot = "__customSound"
    self.Sounds[slot] = soundId
    self:PlaySound(slot, channel or "Music", options)
    return true
end

function L:SetTransitionSound(name, soundId)
    self.Sounds.transitionHooks = self.Sounds.transitionHooks or {}
    self.Sounds.transitionHooks[tostring(name)] = soundId
    return true
end


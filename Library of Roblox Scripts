function L:RemoveTheme(name)
    if type(name)~="string" or BuiltinPaletteNames[name] or self.Palettes[name]==nil then return false end
    local saved=JsonRead("library_custom_palettes.json",{})
    if type(saved)~="table" then saved={} end
    saved[name]=nil
    local ok=JsonWrite("library_custom_palettes.json",saved)
    if not ok then return false,"could not update the saved palettes file" end
    self.Palettes[name]=nil
    if self.Theme==name then self:SetTheme("Dark") end
    return true
